---
import type { CollectionEntry } from "astro:content";
import MainLayout from "./MainLayout.astro";
import SplitHero from "../components/sections/SplitHero.astro";
import Badge from "../components/bearnie/badge/Badge.astro";
import Separator from "../components/bearnie/separator/Separator.astro";
import AboutCallout from "../components/content/AboutCallout.astro";
import CompactBlogCard from "../components/content/CompactBlogCard.astro";
import CompactListingCard from "../components/content/CompactListingCard.astro";
import SupportCTA from "../components/sections/SupportCTA.astro";
import TextAd from "../components/features/ads/TextAd.astro";
import { getValidTags, getTagSlug } from "../lib/blog-tags";
import { buildTitle } from "../utils/seo";
import { articleSchema } from "../utils/schema";
import { findRelatedListings, findRelatedPosts } from "../utils/related";

type Props = CollectionEntry<"blog">["data"];

const {
    title,
    description,
    coverImage,
    published,
    lastUpdated,
    tags,
    authors,
    slug,
    destinations = [],
} = Astro.props;

// Each post gets a route into the directory and a route into the archive.
// Both blocks are derived, not hand-maintained, so new posts inherit them.
const [relatedListings, relatedPosts] = await Promise.all([
    findRelatedListings(destinations),
    findRelatedPosts(slug, destinations, tags),
]);

const relatedPlace =
    relatedListings.hub?.label ||
    destinations[0]?.country ||
    "";
const relatedHeading =
    destinations.length > 1
        ? "Places to give back on this trip"
        : `Places to give back in ${relatedPlace}`;
const hubLabel = relatedListings.hub
    ? relatedListings.hub.href.startsWith("/stays/")
        ? "See all stays in"
        : "See all projects in"
    : "";

const validTags = getValidTags(tags);

// Format the date
const formattedDate = new Date(published).toLocaleDateString("en-GB", {
    day: "2-digit",
    month: "long",
    year: "numeric",
});

const formattedUpdatedDate = new Date(lastUpdated).toLocaleDateString("en-GB", {
    day: "2-digit",
    month: "long",
    year: "numeric",
});

const hasBeenUpdated = published.toISOString() !== lastUpdated.toISOString();

// Article markup lives with the post, not on index or non-article pages.
const site = Astro.site ?? new URL("https://giveback.guide");
const schema = articleSchema({
    site,
    url: new URL(Astro.url.pathname, site).href,
    headline: title,
    description,
    image: coverImage,
    published,
    updated: lastUpdated,
    authors,
});
---

<MainLayout
    title={buildTitle(title, { alwaysBrand: true })}
    description={description}
    image={coverImage}
    ogType="article"
    published={published}
    modified={lastUpdated}
    schema={schema}
>
    <SplitHero
        coverImage={coverImage}
        coverImageAlt={title}
        backgroundColor="bg-gray-50"
        short={true}
        pagefindImageMeta="image[src], image_alt[alt]"
    >
        <p class="mb-4" data-pagefind-meta="categories">
            {
                validTags.map((tag) => (
                    <Badge
                        href={`/blog/${getTagSlug(tag)}/`}
                        variant="outline"
                        class="mr-2 mb-2 rounded-full text-sm"
                    >
                        {tag}
                    </Badge>
                ))
            }
        </p>

        <h1
            class="mb-4 text-3xl sm:text-4xl lg:text-5xl tracking-tight font-extrabold text-gray-900 dark:text-white"
            data-pagefind-meta="title"
        >
            {title}
        </h1>

        <p class="mb-6 text-lg sm:text-xl text-gray-600 dark:text-gray-300 leading-relaxed">
            {description}
        </p>

        <Separator class="mb-6" />

        <ul class="space-y-3 text-left text-gray-500 dark:text-gray-400">
            <li class="flex items-center space-x-3 rtl:space-x-reverse">
                <svg
                    class="w-5 h-5 text-gray-500 dark:text-gray-400"
                    aria-hidden="true"
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    fill="none"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm0 2c-4 0-7 2-7 5v1h14v-1c0-3-3-5-7-5Z"
                    ></path>
                </svg>
                <span>
                    Written by{" "}
                    <a
                        href="/about/authors/"
                        class="font-medium text-gray-700 underline decoration-gray-300 underline-offset-2 hover:text-purple-600 dark:text-gray-300 dark:hover:text-purple-400"
                    >{authors.join(" & ")}</a>,{" "}
                    <span class="text-gray-500 dark:text-gray-400"
                        >founders and editors</span
                    >
                </span>
            </li>
            <li class="flex items-center space-x-3 rtl:space-x-reverse">
                <svg
                    class="w-5 h-5 text-gray-500 dark:text-gray-400"
                    aria-hidden="true"
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    fill="none"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4 10h16m-8-3V4M7 7V4m10 3V4M5 20h14a1 1 0 0 0 1-1V7a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1Zm3-7h.01v.01H8V13Zm4 0h.01v.01H12V13Zm4 0h.01v.01H16V13Zm-8 4h.01v.01H8V17Zm4 0h.01v.01H12V17Zm4 0h.01v.01H16V17Z"
                    ></path>
                </svg>
                <span>
                    Published: <time datetime={published.toISOString()}>{formattedDate}</time>
                </span>
            </li>
            {
                hasBeenUpdated && (
                    <li class="flex items-center space-x-3 rtl:space-x-reverse">
                        <svg
                            class="w-5 h-5 text-gray-500 dark:text-gray-400"
                            aria-hidden="true"
                            xmlns="http://www.w3.org/2000/svg"
                            width="24"
                            height="24"
                            fill="none"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke="currentColor"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M17.651 7.65a7.131 7.131 0 0 0-12.68 3.15M18.001 4v4h-4m-7.652 8.35a7.13 7.13 0 0 0 12.68-3.15M6 20v-4h4"
                            />
                        </svg>
                        <span>
                            Last updated: <time datetime={lastUpdated.toISOString()}>{formattedUpdatedDate}</time>
                        </span>
                    </li>
                )
            }
        </ul>
    </SplitHero>

    <div class="bg-white dark:bg-gray-900">
        <main class="mx-auto max-w-4xl px-4 lg:px-6 py-8">
            <article
                class="prose prose-lg dark:prose-invert max-w-none"
                data-pagefind-body
                data-pagefind-filter="type:post"
            >
                <slot />
            </article>

            <div class="mt-10">
                <TextAd slot="post" />
            </div>

            <div id="about-callout-container" class="hidden">
                <AboutCallout />
            </div>

            {
                relatedListings.listings.length > 0 && (
                    <section
                        class="mt-12 border-t border-gray-200 pt-8 dark:border-gray-700"
                        aria-labelledby="related-listings-heading"
                    >
                        <h2
                            id="related-listings-heading"
                            class="mb-2 text-2xl font-bold tracking-tight text-gray-900 dark:text-white"
                        >
                            {relatedHeading}
                        </h2>
                        <p class="mb-6 text-gray-600 dark:text-gray-400">
                            Directory listings connected to this guide.
                        </p>
                        <ul class="space-y-6">
                            {relatedListings.listings.map((listing) => (
                                <li>
                                    <CompactListingCard
                                        href={listing.href}
                                        image={listing.image}
                                        title={listing.title}
                                        place={listing.place}
                                        kind={listing.kind}
                                        slug={listing.slug}
                                    />
                                </li>
                            ))}
                        </ul>
                        {relatedListings.hub && (
                            <p class="mt-6">
                                <a
                                    href={relatedListings.hub.href}
                                    class="font-medium text-purple-600 underline decoration-purple-300 underline-offset-2 hover:text-purple-700 dark:text-purple-400 dark:hover:text-purple-300"
                                >
                                    {hubLabel} {relatedListings.hub.label}
                                </a>
                            </p>
                        )}
                    </section>
                )
            }

            {
                relatedPosts.length > 0 && (
                    <section
                        class="mt-12 border-t border-gray-200 pt-8 dark:border-gray-700"
                        aria-labelledby="related-posts-heading"
                    >
                        <h2
                            id="related-posts-heading"
                            class="mb-6 text-2xl font-bold tracking-tight text-gray-900 dark:text-white"
                        >
                            More from the blog
                        </h2>
                        <ul class="space-y-6">
                            {relatedPosts.map((post) => (
                                <li>
                                    <CompactBlogCard
                                        href={post.href}
                                        image={post.image}
                                        title={post.title}
                                    />
                                </li>
                            ))}
                        </ul>
                    </section>
                )
            }

            <div class="mt-12">
                <SupportCTA />
            </div>
        </main>
    </div>
</MainLayout>

<script is:inline>
    (function () {
        function insertAboutCallout() {
            const article = document.querySelector('[data-pagefind-body]');
            const calloutContainer = document.getElementById('about-callout-container');
            if (!article || !calloutContainer) return;

            const callout = calloutContainer.firstElementChild;
            if (!callout) return;

            const firstH2 = article.querySelector('h2');
            if (firstH2) {
                firstH2.parentNode.insertBefore(callout, firstH2);
            }

            calloutContainer.remove();
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', insertAboutCallout);
        } else {
            insertAboutCallout();
        }
    })();
</script>
