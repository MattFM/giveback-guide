---
import type { TextAd as Ad } from "@/data/ads";
import {
    ADS,
    getActiveAds,
    getSponsorLabel,
    hashKey,
    pickWeightedAd,
    validateAds,
} from "@/data/ads";
import Badge from "@/components/bearnie/badge/Badge.astro";
import Button from "@/components/bearnie/button/Button.astro";

interface Props {
    /** Explicit ad, used by previews and the advertising page. */
    ad?: Ad;
    /** Identifies the slot in the page. Also seeds build-time selection. */
    slot?: string;
    /** Pick a fresh ad in the browser on every page load. */
    rotate?: boolean;
    /** Send click and impression events to Umami. Off for previews. */
    track?: boolean;
}

const {
    ad: explicitAd,
    slot = "default",
    rotate = false,
    track = true,
} = Astro.props;

validateAds(ADS);

const activeAds = getActiveAds(ADS);
const selectionKey = `${Astro.url.pathname}:${slot}`;
const selected =
    explicitAd ??
    pickWeightedAd(activeAds, hashKey(selectionKey) / 4294967296);

// `businessName` is usually the same as the title. Only show it when it adds
// context (for example, "Byway" alongside a campaign headline).
const sponsor = selected ? getSponsorLabel(selected) : "";
---

{
    selected && (
        <aside
            class="text-ad @container"
            aria-label="Advertisement"
            data-ad-slot={slot}
            data-ad-id={selected.id}
            data-ad-rotate={rotate ? "true" : undefined}
            data-ad-static={explicitAd ? "true" : undefined}
            data-ad-track={track ? "true" : undefined}
            data-pagefind-ignore
        >
            <div class="flex flex-col gap-3 rounded-lg border border-gray-200 bg-card p-4 text-card-foreground dark:border-gray-700 @min-[28rem]:flex-row @min-[28rem]:items-center @min-[28rem]:justify-between">
                <div class="flex min-w-0 flex-1 flex-col gap-1 @min-[28rem]:flex-row @min-[28rem]:flex-wrap @min-[28rem]:items-center @min-[28rem]:gap-2">
                    <div class="flex flex-wrap items-center gap-2">
                        <Badge variant="outline">Ad</Badge>
                        <span
                            data-ad-sponsor
                            class="text-xs font-medium text-muted-foreground"
                            hidden={!sponsor}
                        >
                            {sponsor}
                        </span>
                    </div>
                    <p
                        data-ad-title
                        class="line-clamp-2 text-sm font-semibold text-foreground @min-[28rem]:line-clamp-1"
                    >
                        {selected.title}
                    </p>
                    <span
                        class="hidden text-sm text-muted-foreground @min-[28rem]:inline"
                        aria-hidden="true"
                    >
                        —
                    </span>
                    <p
                        data-ad-description
                        class="line-clamp-3 text-sm text-muted-foreground @min-[28rem]:line-clamp-2 @min-[28rem]:min-w-0 @min-[28rem]:flex-1"
                    >
                        {selected.description}
                    </p>
                </div>

                <Button
                    href={selected.url}
                    size="sm"
                    class="w-full shrink-0 @min-[28rem]:w-auto"
                    target="_blank"
                    rel="noopener sponsored"
                    data-ad-link
                    data-umami-event={track ? "ad-click" : undefined}
                    data-umami-event-ad={track ? selected.id : undefined}
                    data-umami-event-slot={track ? slot : undefined}
                >
                    <span data-ad-cta>{selected.cta}</span>
                    <span class="sr-only"> (opens in a new tab)</span>
                    <svg
                        slot="right-icon"
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="M7 7h10v10" />
                        <path d="M7 17 17 7" />
                    </svg>
                </Button>
            </div>
        </aside>
    )
}

<script>
    import {
        ADS,
        getActiveAds,
        getSponsorLabel,
        pickWeightedAd,
        type TextAd,
    } from "@/data/ads";

    interface UmamiWindow extends Window {
        umami?: {
            track: (event: string, data?: Record<string, string>) => void;
        };
    }

    function trackImpression(ad: TextAd, slot: string): void {
        (window as UmamiWindow).umami?.track("ad-impression", {
            ad: ad.id,
            slot,
        });
    }

    function setText(
        container: HTMLElement,
        selector: string,
        value: string,
    ): void {
        const element = container.querySelector<HTMLElement>(selector);
        if (element) element.textContent = value;
    }

    function applyAd(container: HTMLElement, ad: TextAd): void {
        container.dataset.adId = ad.id;

        setText(container, "[data-ad-title]", ad.title);
        setText(container, "[data-ad-description]", ad.description);
        setText(container, "[data-ad-cta]", ad.cta);

        const sponsor =
            container.querySelector<HTMLElement>("[data-ad-sponsor]");
        if (sponsor) {
            const label = getSponsorLabel(ad);
            sponsor.textContent = label;
            sponsor.hidden = label === "";
        }

        const link =
            container.querySelector<HTMLAnchorElement>("[data-ad-link]");
        if (link) {
            link.href = ad.url;
            link.dataset.umamiEventAd = ad.id;
        }

        if (container.dataset.adTrack === "true") {
            trackImpression(ad, container.dataset.adSlot ?? "default");
        }
    }

    function initTextAds(isReroll = false): void {
        // Resolve expiry in the browser as well as at build time, so a
        // campaign that ends between deploys stops running.
        const pool = getActiveAds(ADS);
        const containers =
            document.querySelectorAll<HTMLElement>("[data-ad-slot]");

        const used = new Set<string>();

        containers.forEach((container) => {
            const currentId = container.dataset.adId;
            const current = pool.find((ad) => ad.id === currentId);
            const shouldRotate = container.dataset.adRotate === "true";

            // Explicit previews keep the ad they were given, even when it is
            // outside its campaign dates.
            if (container.dataset.adStatic === "true") {
                if (current) used.add(current.id);
                return;
            }

            // The server-rendered ad is still live and this slot is static.
            // Leave it alone and only record the impression.
            if (current && !shouldRotate) {
                used.add(current.id);

                if (container.dataset.adTrack === "true") {
                    trackImpression(
                        current,
                        container.dataset.adSlot ?? "default",
                    );
                }

                return;
            }

            // Do not repeat an ad immediately after a reroll of a rotating
            // slot. On first load the full weighted pool is fair game.
            const excluded = new Set(used);
            if (isReroll && shouldRotate && currentId) excluded.add(currentId);

            const available = pool.filter((ad) => !excluded.has(ad.id));
            const next = pickWeightedAd(
                available.length > 0 ? available : pool,
                Math.random(),
            );

            if (!next) {
                container.hidden = true;
                return;
            }

            container.hidden = false;
            applyAd(container, next);
            used.add(next.id);
        });
    }

    initTextAds();

    // Used by the design preview to test rotation without a page reload.
    document.addEventListener("ads:reroll", () => initTextAds(true));
</script>
