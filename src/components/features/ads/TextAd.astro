---
import type { TextAd } from "../../../data/ads";
import { ADS, getActiveAds } from "../../../data/ads";
import Badge from "@/components/bearnie/badge/Badge.astro";
import Button from "@/components/bearnie/button/Button.astro";
import Card from "@/components/bearnie/card/Card.astro";
import CardHeader from "@/components/bearnie/card/CardHeader.astro";
import CardTitle from "@/components/bearnie/card/CardTitle.astro";
import CardDescription from "@/components/bearnie/card/CardDescription.astro";
import CardFooter from "@/components/bearnie/card/CardFooter.astro";

interface Props {
    format?: "inline" | "sidebar";
    ads?: TextAd[];
}

const { format = "inline", ads: propAds } = Astro.props;

// Use provided ads (for design/testing) or fall back to the global inventory
const allAds = propAds ?? ADS;
const activeAds = getActiveAds(allAds);

// Fallback: if no active ads, render nothing on the server side
const fallbackAd = activeAds[0] ?? null;

// Inline the active ad pool as JSON for the client script
const adPoolJson = JSON.stringify(activeAds);
---

{
    activeAds.length > 0 && (
        <div
            class="text-ad-container"
            data-format={format}
            data-ad-pool={adPoolJson}
            data-fallback-id={fallbackAd?.id}
        >
            {/* ===== INLINE FORMAT ===== */}
            {format === "inline" && (
                <div class="ad-inline flex items-center justify-between gap-3 px-4 py-3 rounded-lg border bg-card text-card-foreground flex-wrap">
                    <div class="ad-inline-content flex items-center gap-2 flex-wrap flex-1 min-w-0">
                        <Badge variant="outline">Ad</Badge>
                        <span class="ad-inline-title text-sm font-semibold text-foreground whitespace-nowrap">{fallbackAd?.title}</span>
                        <span class="text-sm text-muted-foreground whitespace-nowrap">—</span>
                        <span class="ad-inline-desc text-sm text-muted-foreground">
                            {fallbackAd?.description}
                        </span>
                    </div>
                    <Button
                        href={fallbackAd?.url}
                        size="sm"
                        class="ad-inline-btn flex-shrink-0"
                        target="_blank"
                        rel="noopener sponsored"
                        aria-label={`${fallbackAd?.cta} — ${fallbackAd?.title}`}
                    >
                        <span class="ad-cta">{fallbackAd?.cta}</span>
                        <svg
                            slot="right-icon"
                            xmlns="http://www.w3.org/2000/svg"
                            width="16"
                            height="16"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                        >
                            <path d="M7 7h10v10" />
                            <path d="M7 17 17 7" />
                        </svg>
                    </Button>
                </div>
            )}

            {/* ===== SIDEBAR FORMAT ===== */}
            {format === "sidebar" && (
                <Card class="relative">
                    <Badge variant="outline" class="absolute -top-2.5 left-3 bg-card">
                        Ad
                    </Badge>
                    <CardHeader class="pb-0">
                        <CardTitle>{fallbackAd?.title}</CardTitle>
                        <CardDescription>{fallbackAd?.description}</CardDescription>
                    </CardHeader>
                    <CardFooter class="mt-2">
                        <Button
                            href={fallbackAd?.url}
                            size="sm"
                            class="w-full ad-sidebar-btn"
                            target="_blank"
                            rel="noopener sponsored"
                            aria-label={`${fallbackAd?.cta} — ${fallbackAd?.title}`}
                        >
                            <span class="ad-cta">{fallbackAd?.cta}</span>
                            <svg
                                slot="right-icon"
                                xmlns="http://www.w3.org/2000/svg"
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <path d="M7 7h10v10" />
                                <path d="M7 17 17 7" />
                            </svg>
                        </Button>
                    </CardFooter>
                </Card>
            )}
        </div>
    )
}

<script>
    interface AdData {
        id: string;
        title: string;
        businessName: string;
        url: string;
        cta: string;
        description: string;
        weight: number;
    }

    function pickWeightedAd(ads: AdData[]): AdData | null {
        if (ads.length === 0) return null;
        const totalWeight: number = ads.reduce(
            (sum: number, ad: AdData) => sum + ad.weight,
            0,
        );
        if (totalWeight <= 0) return null;

        let random: number = Math.random() * totalWeight;
        for (const ad of ads) {
            random -= ad.weight;
            if (random <= 0) return ad;
        }
        return ads[ads.length - 1] ?? null;
    }

    function renderInline(container: HTMLElement, ad: AdData | null): void {
        const wrapper: HTMLElement | null =
            container.querySelector(".ad-inline");
        if (!wrapper) return;

        if (!ad) {
            wrapper.style.display = "none";
            return;
        }
        wrapper.style.display = "";

        const titleEl: HTMLElement | null =
            wrapper.querySelector(".ad-inline-title");
        if (titleEl) titleEl.textContent = ad.title;

        const descEl: HTMLElement | null =
            wrapper.querySelector(".ad-inline-desc");
        if (descEl) descEl.textContent = ad.description;

        const ctaEl: HTMLElement | null = wrapper.querySelector(".ad-cta");
        if (ctaEl) ctaEl.textContent = ad.cta;

        const linkEl: HTMLAnchorElement | null = wrapper.querySelector(
            "a[rel*='sponsored']",
        );
        if (linkEl) {
            linkEl.href = ad.url;
            linkEl.setAttribute("aria-label", `${ad.cta} — ${ad.title}`);
        }
    }

    function renderSidebar(container: HTMLElement, ad: AdData | null): void {
        const wrapper: HTMLElement | null =
            container.querySelector("[data-slot='card']");
        if (!wrapper) return;

        if (!ad) {
            wrapper.style.display = "none";
            return;
        }
        wrapper.style.display = "";

        const titleEl: HTMLElement | null =
            wrapper.querySelector("[data-slot='card-title']");
        if (titleEl) titleEl.textContent = ad.title;

        const descEl: HTMLElement | null =
            wrapper.querySelector("[data-slot='card-description']");
        if (descEl) descEl.textContent = ad.description;

        const ctaEl: HTMLElement | null = wrapper.querySelector(".ad-cta");
        if (ctaEl) ctaEl.textContent = ad.cta;

        const linkEl: HTMLAnchorElement | null = wrapper.querySelector(
            "a[rel*='sponsored']",
        );
        if (linkEl) {
            linkEl.href = ad.url;
            linkEl.setAttribute("aria-label", `${ad.cta} — ${ad.title}`);
        }
    }

    function initTextAd(container: HTMLElement): void {
        const poolAttr: string | undefined = container.dataset.adPool;
        if (!poolAttr) return;

        let pool: AdData[] = [];
        try {
            pool = JSON.parse(poolAttr) as AdData[];
        } catch {
            return;
        }

        const format: string | undefined = container.dataset.format;
        const selected: AdData | null = pickWeightedAd(pool);

        if (format === "sidebar") {
            renderSidebar(container, selected);
        } else {
            renderInline(container, selected);
        }
    }

    function initAllTextAds(): void {
        const containers: NodeListOf<HTMLElement> =
            document.querySelectorAll(".text-ad-container");
        containers.forEach((container: HTMLElement) => initTextAd(container));
    }

    // Initialise on page load
    initAllTextAds();

    // Listen for reroll events (used on the design showcase page)
    document.addEventListener("ads:reroll", () => {
        initAllTextAds();
    });
</script>

<style>
    .ad-inline-btn {
        flex-shrink: 0;
    }

    .ad-sidebar-btn {
        min-width: 0;
    }

    .ad-sidebar-btn .ad-cta {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        min-width: 0;
    }

    .ad-sidebar-btn svg {
        flex-shrink: 0;
    }
</style>
