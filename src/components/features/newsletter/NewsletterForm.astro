---
import BasecoatButton from "../../ui/BasecoatButton.astro";

export interface Props {
    source: string;
    id?: string;
    size?: 'xs' | 'sm' | 'default' | 'lg';
    showPrivacyText?: boolean;
    privacyText?: string;
    placeholder?: string;
    buttonText?: string;
    submittingText?: string;
    heading?: string;
    description?: string;
    wrapperClass?: string;
    formClass?: string;
}

const {
    source,
    id = 'newsletter-form',
    size = 'sm',
    showPrivacyText = true,
    privacyText = 'Unsubscribe anytime. By subscribing, you agree to our <a href="/privacy/" class="hover:underline" style="color: #1C2434;">Privacy Policy</a>.',
    placeholder = 'Your email',
    buttonText = 'Subscribe',
    submittingText = 'Subscribing...',
    heading,
    description,
    wrapperClass = '',
    formClass = '',
} = Astro.props;

const formId = `${id}-form`;
const emailId = `${id}-email`;
const messageId = `${id}-message`;
const btnId = `${id}-btn`;

const buttonDataSize = size === 'default' ? undefined : size;

const inputGroupHeight = {
    xs: '!h-7',
    sm: '',
    default: '!h-10',
    lg: '!h-11',
}[size];
---

<div class={wrapperClass}>
    {heading && (
        <h2 class="mb-4 text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white">
            {heading}
        </h2>
    )}
    {description && (
        <p class="mb-6 text-gray-500 dark:text-gray-400">
            {description}
        </p>
    )}

    <form id={formId} class={`w-full ${formClass}`}>
        <div class={`input-group ${inputGroupHeight}`}>
            <label for={emailId} class="sr-only">Email address</label>
            <input
                type="email"
                id={emailId}
                name="email"
                placeholder={placeholder}
                required
                style="font-size: 16px;"
            />
            <BasecoatButton
                type="submit"
                id={btnId}
                data-size={buttonDataSize}
                data-align="end"
            >
                {buttonText}
            </BasecoatButton>
        </div>
        {showPrivacyText && (
            <p class="mt-2 text-xs" style="color: #7E827E;">
                <Fragment set:html={privacyText} />
            </p>
        )}
        <p
            id={messageId}
            class="mt-2 text-xs hidden"
            style="color: #1C2434;"
        >
        </p>
    </form>
</div>

<script is:inline define:vars={{ WORKER_URL: import.meta.env.PUBLIC_WORKER_URL, formId, emailId, messageId, btnId, source, submittingText, buttonText }}>
    const form = document.getElementById(formId);
    const messageEl = document.getElementById(messageId);
    const btn = document.getElementById(btnId);

    if (form) {
        form.addEventListener("submit", async (e) => {
            e.preventDefault();

            const emailInput = document.getElementById(emailId);
            if (!emailInput) return;

            const email = emailInput.value;

            if (btn) {
                btn.disabled = true;
                btn.textContent = submittingText;
            }
            if (messageEl) {
                messageEl.classList.add("hidden");
            }

            try {
                const response = await fetch(WORKER_URL, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                    },
                    body: JSON.stringify({
                        email: email,
                        source: source,
                    }),
                });

                const data = await response.json();

                if (messageEl) {
                    if (data.success) {
                        messageEl.textContent = data.alreadySubscribed
                            ? "You are already subscribed!"
                            : "Done! Check your email to confirm your subscription.";
                        messageEl.style.color = "#10B981";
                        emailInput.value = "";
                    } else {
                        messageEl.textContent = data.error || "Subscription failed. Please try again.";
                        messageEl.style.color = "#EF4444";
                    }
                    messageEl.classList.remove("hidden");
                }
            } catch (error) {
                if (messageEl) {
                    messageEl.textContent = "Network error. Please try again.";
                    messageEl.style.color = "#EF4444";
                    messageEl.classList.remove("hidden");
                }
            }

            if (btn) {
                btn.disabled = false;
                btn.textContent = buttonText;
            }
        });
    }
</script>
