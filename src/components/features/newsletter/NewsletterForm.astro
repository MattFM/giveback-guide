---
import Button from "@/components/bearnie/button/Button.astro";
import Input from "@/components/bearnie/input/Input.astro";

export interface Props {
    source: string;
    id?: string;
    size?: "xs" | "sm" | "default" | "lg";
    showPrivacyText?: boolean;
    privacyText?: string;
    placeholder?: string;
    buttonText?: string;
    submittingText?: string;
    heading?: string;
    description?: string;
    wrapperClass?: string;
    formClass?: string;
}

const {
    source,
    id = "newsletter-form",
    size = "sm",
    showPrivacyText = true,
    privacyText = 'Unsubscribe anytime. By subscribing, you agree to our <a href="/privacy/" class="hover:underline text-inherit">Privacy Policy</a>.',
    placeholder = "Your email",
    buttonText = "Subscribe",
    submittingText = "Subscribing...",
    heading,
    description,
    wrapperClass = "",
    formClass = "",
} = Astro.props;

const formId = `${id}-form`;
const emailId = `${id}-email`;
const messageId = `${id}-message`;
const btnId = `${id}-btn`;

const inputSizeClass = {
    xs: "h-7",
    sm: "h-8",
    default: "",
    lg: "h-10",
}[size];

const buttonSize = size === "default" ? undefined : size;

---

<div class={wrapperClass}>
    {
        heading && (
            <h2 class="mb-4 text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white">
                {heading}
            </h2>
        )
    }
    {
        description && (
            <p class="mb-6 text-gray-500 dark:text-gray-400">{description}</p>
        )
    }

    <form id={formId} class={`w-full ${formClass}`}>
        <div class="flex gap-2">
            <label for={emailId} class="sr-only">Email address</label>
            <Input
                type="email"
                id={emailId}
                name="email"
                placeholder={placeholder}
                required
                autocomplete="email"
                class={`flex-1 bg-white ${inputSizeClass}`}
            />
            <Button
                type="submit"
                id={btnId}
                size={buttonSize}
            >
                {buttonText}
            </Button>
        </div>
        {
            showPrivacyText && (
                <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">
                    <Fragment set:html={privacyText} />
                </p>
            )
        }
        <p id={messageId} class="mt-2 text-xs hidden"></p>
    </form>
</div>

<script
    is:inline
    define:vars={{
        WORKER_URL: import.meta.env.PUBLIC_WORKER_URL,
        formId,
        emailId,
        messageId,
        btnId,
        source,
        submittingText,
        buttonText,
    }}
>
    const form = document.getElementById(formId);
    const messageEl = document.getElementById(messageId);
    const btn = document.getElementById(btnId);

    if (form) {
        form.addEventListener("submit", async (e) => {
            e.preventDefault();

            const emailInput = document.getElementById(emailId);
            if (!emailInput) return;

            const email = emailInput.value;

            if (btn) {
                btn.disabled = true;
                btn.textContent = submittingText;
            }
            if (messageEl) {
                messageEl.classList.add("hidden");
            }

            try {
                const response = await fetch(WORKER_URL, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                    },
                    body: JSON.stringify({
                        email: email,
                        source: source,
                    }),
                });

                const data = await response.json();

                if (messageEl) {
                    if (data.success) {
                        messageEl.textContent = data.alreadySubscribed
                            ? "You are already subscribed!"
                            : "Done! Check your email to confirm your subscription.";
                        messageEl.className = "mt-2 text-xs text-emerald-500 dark:text-emerald-400";
                        emailInput.value = "";
                    } else {
                        messageEl.textContent =
                            data.error ||
                            "Subscription failed. Please try again.";
                        messageEl.className = "mt-2 text-xs text-red-500 dark:text-red-400";
                    }
                    messageEl.classList.remove("hidden");
                }
            } catch (error) {
                if (messageEl) {
                    messageEl.textContent = "Network error. Please try again.";
                    messageEl.className = "mt-2 text-xs text-red-500 dark:text-red-400";
                    messageEl.classList.remove("hidden");
                }
            }

            if (btn) {
                btn.disabled = false;
                btn.textContent = buttonText;
            }
        });
    }
</script>
