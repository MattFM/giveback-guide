---
import { Image } from "astro:assets";
import Avatar from "../../assets/giveback-guide-avatar.svg";
import Separator from "../bearnie/separator/Separator.astro";
import { SITE_TITLE } from "../../consts";
const today = new Date();
---

<footer
    class="p-4 sm:p-6"
    style="background-color: #111111;"
    role="contentinfo"
>
    <div class="mx-auto max-w-7xl">
        <div class="md:flex md:justify-between">
            <div class="mb-6 md:mb-0 max-w-xs">
                <a href="https://giveback.guide" class="flex items-center mb-4">
                    <Image src={Avatar} class="w-22 h-22 invert" alt={SITE_TITLE} />
                </a>

                <p class="text-white text-lg font-medium mb-1">
                    Air a dhèanamh ann an Inbhir Nis, Alba.
                </p>
                <p class="text-gray-200 text-sm">
                    Made in Inverness, Scotland
                </p>
            </div>
            <div
                class="grid grid-cols-2 gap-8 sm:gap-10 md:gap-12 lg:gap-16 sm:grid-cols-3"
            >
                <div>
                    <h2
                        class="mb-6 text-sm font-semibold uppercase text-white"
                    >
                        Get Involved
                    </h2>
                    <ul class="text-gray-200">
                        <li class="mb-4">
                            <a href="/submit/" class="hover:text-white transition-colors"
                                >Submit a project</a
                            >
                        </li>
                        <li class="mb-4">
                            <a href="/verify/" class="hover:text-white transition-colors"
                                >Verify a project</a
                            >
                        </li>
                        <li class="mb-4">
                            <a href="/login/" class="hover:text-white transition-colors"
                                >Join / Log in</a
                            >
                        </li>
                        <li>
                            <a href="/support/" class="hover:text-white transition-colors"
                                >Support us</a
                            >
                        </li>
                    </ul>
                </div>
                <div>
                    <h2
                        class="mb-6 text-sm font-semibold uppercase text-white"
                    >
                        About
                    </h2>
                    <ul class="text-gray-200">
                        <li class="mb-4">
                            <a href="/about/" class="hover:text-white transition-colors"
                                >About us</a
                            >
                        </li>
                        <li class="mb-4">
                            <a href="/contact/" class="hover:text-white transition-colors"
                                >Contact us</a
                            >
                        </li>
                        <li class="mb-4">
                            <a href="/about/impacts/" class="hover:text-white transition-colors"
                                >Impact Areas</a
                            >
                        </li>
                        <li>
                            <a
                                href="/about/advertising/"
                                class="hover:text-white transition-colors">Advertising</a
                            >
                        </li>
                    </ul>
                </div>
                <div>
                    <h2
                        class="mb-6 text-sm font-semibold uppercase text-white"
                    >
                        Policies
                    </h2>
                    <ul class="text-gray-200">
                        <li class="mb-4">
                            <a
                                href="/about/animal-welfare/"
                                class="hover:text-white transition-colors">Animal Welfare</a
                            >
                        </li>
                        <li class="mb-4">
                            <a href="/sustainability/" class="hover:text-white transition-colors"
                                >Sustainability</a
                            >
                        </li>
                        <li class="mb-4">
                            <a href="/about/ai-policy/" class="hover:text-white transition-colors"
                                >AI Policy</a
                            >
                        </li>
                        <li class="mb-4">
                            <a href="/privacy/" class="hover:text-white transition-colors"
                                >Privacy Policy</a
                            >
                        </li>
                        <li class="mb-4">
                            <a href="/terms/" class="hover:text-white transition-colors"
                                >Terms of service</a
                            >
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="my-6 sm:mx-auto lg:my-8">
            <Separator />
        </div>
        <div class="sm:flex sm:items-center sm:justify-between">
            <span class="text-sm sm:text-center text-gray-200"
                >&copy; {today.getFullYear()} {SITE_TITLE}. All Rights Reserved.
            </span>
            <div class="flex mt-4 space-x-6 sm:justify-center sm:mt-0">
                <a
                    href="https://www.instagram.com/giveback.guide"
                    class="text-gray-200 hover:text-white transition-colors"
                    aria-label="Instagram"
                    rel="noopener noreferrer"
                    target="_blank"
                >
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M7.465 1.066C8.638 1.012 9.012 1 12 1c2.988 0 3.362.013 4.534.066 1.172.053 1.972.24 2.672.511.733.277 1.398.71 1.948 1.27.56.549.992 1.213 1.268 1.947.272.7.458 1.5.512 2.67C22.988 8.639 23 9.013 23 12c0 2.988-.013 3.362-.066 4.535-.053 1.17-.24 1.97-.512 2.67a5.396 5.396 0 0 1-1.268 1.949c-.55.56-1.215.992-1.948 1.268-.7.272-1.5.458-2.67.512-1.174.054-1.548.066-4.536.066-2.988 0-3.362-.013-4.535-.066-1.17-.053-1.97-.24-2.67-.512a5.397 5.397 0 0 1-1.949-1.268 5.392 5.392 0 0 1-1.269-1.948c-.271-.7-.457-1.5-.511-2.67C1.012 15.361 1 14.987 1 12c0-2.988.013-3.362.066-4.534.053-1.172.24-1.972.511-2.672a5.396 5.396 0 0 1 1.27-1.948 5.392 5.392 0 0 1 1.947-1.269c.7-.271 1.5-.457 2.67-.511zm8.98 1.98c-1.16-.053-1.508-.064-4.445-.064-2.937 0-3.285.011-4.445.064-1.073.049-1.655.228-2.043.379-.513.2-.88.437-1.265.822a3.412 3.412 0 0 0-.822 1.265c-.151.388-.33.97-.379 2.043-.053 1.16-.064 1.508-.064 4.445 0 2.937.011 3.285.064 4.445.049 1.073.228 1.655.379 2.043.176.477.457.91.822 1.265.355.365.788.646 1.265.822.388.151.97.33 2.043.379 1.16.053 1.507.064 4.445.064 2.938 0 3.285-.011 4.445-.064 1.073-.049 1.655-.228 2.043-.379.513-.2.88-.437 1.265-.822.365-.355.646-.788.822-1.265.151-.388.33-.97.379-2.043.053-1.16.064-1.508.064-4.445 0-2.937-.011-3.285-.064-4.445-.049-1.073-.228-1.655-.379-2.043-.2-.513-.437-.88-.822-1.265a3.413 3.413 0 0 0-1.265-.822c-.388-.151-.97-.33-2.043-.379zm-5.85 12.345a3.669 3.669 0 0 0 4-5.986 3.67 3.67 0 1 0-4 5.986zM8.002 8.002a5.654 5.654 0 1 1 7.996 7.996 5.654 5.654 0 0 1-7.996-7.996zm10.906-.814a1.337 1.337 0 1 0-1.89-1.89 1.337 1.337 0 0 0 1.89 1.89z"/>
                    </svg>
                </a>
                <a
                    href="https://www.tiktok.com/@giveback.guide"
                    class="text-gray-200 hover:text-white transition-colors"
                    aria-label="TikTok"
                    rel="noopener noreferrer"
                    target="_blank"
                >
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M19.321 5.562a5.124 5.124 0 0 1-.443-.258 6.228 6.228 0 0 1-1.137-.966c-.849-.971-1.166-1.956-1.282-2.645h.004c-.097-.573-.057-.943-.05-.943h-3.865v14.943c0 .2 0 .399-.008.595 0 .024-.003.046-.004.073 0 .01 0 .022-.003.033v.009a3.28 3.28 0 0 1-1.65 2.604 3.226 3.226 0 0 1-1.6.422c-1.8 0-3.26-1.468-3.26-3.281 0-1.814 1.46-3.282 3.26-3.282.341 0 .68.054 1.004.16l.005-3.936A7.178 7.178 0 0 0 4.76 10.71a7.583 7.583 0 0 0-1.655 2.04c-.163.281-.779 1.412-.853 3.246-.047 1.04.266 2.12.415 2.565v.01c.093.262.457 1.158 1.049 1.913a7.856 7.856 0 0 0 1.674 1.58v-.01l.009.01c1.87 1.27 3.945 1.187 3.945 1.187.359-.015 1.562 0 2.928-.647 1.515-.718 2.377-1.787 2.377-1.787a7.43 7.43 0 0 0 1.296-2.153c.35-.92.466-2.022.466-2.462V8.273c.047.028.672.441.672.441s.9.577 2.303.952c1.006.267 2.363.324 2.363.324V6.153c-.475.052-1.44-.098-2.429-.59z"/>
                    </svg>
                </a>
                <a
                    href="https://mastodon.social/@givebackguide"
                    class="text-gray-200 hover:text-white transition-colors"
                    aria-label="Mastodon"
                    rel="noopener noreferrer"
                    target="_blank"
                >
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12.158 0c-3.068.025-6.02.357-7.74 1.147 0 0-3.41 1.526-3.41 6.733 0 1.192-.024 2.617.014 4.129.123 5.091.933 10.11 5.64 11.355 2.171.575 4.035.695 5.535.613 2.722-.151 4.25-.972 4.25-.972l-.09-1.974s-1.945.613-4.13.538c-2.163-.074-4.448-.233-4.798-2.89a5.448 5.448 0 0 1-.048-.745s2.124.519 4.816.642c1.647.076 3.19-.096 4.759-.283 3.007-.36 5.625-2.212 5.954-3.905.519-2.667.476-6.508.476-6.508 0-5.207-3.411-6.733-3.411-6.733C18.255.357 15.302.025 12.233 0h-.075zM8.686 4.068c1.278 0 2.245.491 2.885 1.474l.622 1.043.623-1.043c.64-.983 1.607-1.474 2.885-1.474 1.105 0 1.995.388 2.675 1.146.658.757.986 1.781.986 3.07v6.303h-2.497V8.47c0-1.29-.543-1.945-1.628-1.945-1.2 0-1.802.777-1.802 2.313v3.349h-2.483v-3.35c0-1.535-.601-2.312-1.802-2.312-1.085 0-1.628.655-1.628 1.945v6.118H5.024V8.283c0-1.288.328-2.312.987-3.07.68-.757 1.57-1.145 2.675-1.145z"/>
                    </svg>
                </a>
                <a
                    href="https://bsky.app/profile/givebackguide.bsky.social"
                    class="text-gray-200 hover:text-white transition-colors"
                    aria-label="Bluesky"
                    rel="noopener noreferrer"
                    target="_blank"
                >
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M5.202 2.857C7.954 4.922 10.913 9.11 12 11.358c1.087-2.247 4.046-6.436 6.798-8.501C20.783 1.366 24 .213 24 3.883c0 .732-.42 6.156-.667 7.037c-.856 3.061-3.978 3.842-6.755 3.37c4.854.826 6.089 3.562 3.422 6.299c-5.065 5.196-7.28-1.304-7.847-2.97c-.104-.305-.152-.448-.153-.327c0-.121-.05.022-.153.327c-.568 1.666-2.782 8.166-7.847 2.97c-2.667-2.737-1.432-5.473 3.422-6.3c-2.777.473-5.899-.308-6.755-3.369C.42 10.04 0 4.615 0 3.883c0-3.67 3.217-2.517 5.202-1.026"/>
                    </svg>
                </a>
                <a
                    href="https://www.threads.com/@giveback.guide"
                    class="text-gray-200 hover:text-white transition-colors"
                    aria-label="Threads"
                    rel="noopener noreferrer"
                    target="_blank"
                >
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M17.692 11.123a8.547 8.547 0 0 0-.315-.142c-.185-3.414-2.05-5.368-5.182-5.388h-.042c-1.873 0-3.431.8-4.39 2.255l1.722 1.181c.716-1.087 1.84-1.318 2.669-1.318h.028c1.031.006 1.81.306 2.313.89.367.426.612 1.015.733 1.757a13.176 13.176 0 0 0-2.96-.143c-2.977.172-4.892 1.909-4.763 4.322.065 1.223.675 2.277 1.717 2.964.88.582 2.015.866 3.194.802 1.558-.085 2.78-.68 3.632-1.766.647-.825 1.056-1.894 1.237-3.241.742.448 1.292 1.037 1.596 1.745.516 1.205.546 3.184-1.068 4.797-1.415 1.414-3.116 2.025-5.686 2.044-2.851-.02-5.008-.935-6.41-2.717-1.313-1.67-1.991-4.08-2.016-7.165.025-3.085.703-5.496 2.016-7.165 1.402-1.782 3.558-2.696 6.41-2.717 2.871.02 5.065.94 6.521 2.73.714.879 1.252 1.983 1.607 3.27l2.018-.538c-.43-1.585-1.107-2.95-2.027-4.083C18.38 1.2 15.65.024 12.134 0h-.014C8.61.024 5.912 1.205 4.099 3.51c-1.614 2.05-2.446 4.904-2.474 8.482v.016c.028 3.578.86 6.431 2.474 8.482 1.813 2.305 4.511 3.486 8.02 3.51h.015c3.12-.022 5.319-.838 7.13-2.649 2.371-2.368 2.3-5.336 1.518-7.158-.56-1.307-1.629-2.368-3.09-3.07zm-5.387 5.065c-1.305.074-2.66-.512-2.728-1.766-.05-.93.662-1.969 2.808-2.092.246-.015.487-.021.724-.021.78 0 1.508.075 2.171.22-.247 3.088-1.697 3.59-2.975 3.66z"/>
                    </svg>
                </a>
                <a
                    href="https://www.youtube.com/heretotravel"
                    class="text-gray-200 hover:text-white transition-colors"
                    aria-label="YouTube"
                    rel="noopener noreferrer"
                    target="_blank"
                >
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M23.5 6.186a3.016 3.016 0 0 0-.766-1.27 3.05 3.05 0 0 0-1.338-.742C19.518 4 11.994 4 11.994 4s-7.52 0-9.432.495a3.05 3.05 0 0 0-1.338.742 3.016 3.016 0 0 0-.766 1.27A29.09 29.09 0 0 0 0 12c-.012 1.841.151 3.68.488 5.494.137.479.404.916.775 1.269.371.353.833.608 1.341.743 1.912.494 9.432.494 9.432.494s7.518 0 9.43-.494a3.05 3.05 0 0 0 1.338-.743c.37-.353.633-.792.765-1.27A28.38 28.38 0 0 0 24 12a29.09 29.09 0 0 0-.5-5.814zM9.602 15.424V8.576l6.26 3.424-6.26 3.424z"/>
                    </svg>
                </a>
            </div>
        </div>
    </div>
</footer>
