---
import Sheet from '../bearnie/sheet/Sheet.astro';
import SheetTrigger from '../bearnie/sheet/SheetTrigger.astro';
import SheetOverlay from '../bearnie/sheet/SheetOverlay.astro';
import SheetContent from '../bearnie/sheet/SheetContent.astro';
import Button from '../bearnie/button/Button.astro';
import Collapsible from '../bearnie/collapsible/Collapsible.astro';
import CollapsibleTrigger from '../bearnie/collapsible/CollapsibleTrigger.astro';
import CollapsibleContent from '../bearnie/collapsible/CollapsibleContent.astro';

interface Props {
  theme?: 'light' | 'dark';
}

const { theme = 'light' } = Astro.props;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => {
  if (path === '/') return currentPath === '/';
  return currentPath.startsWith(path);
};

// Helper to detect activity across multiple paths (used for parent rows)
const isAnyActive = (paths: string[]) => paths.some((p) => isActive(p));

const getLinkClasses = (path: string) => {
  const active = isActive(path);
  const base = 'block px-4 py-3 text-base font-medium rounded-lg transition-colors w-full text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 focus-visible:ring-offset-white dark:focus-visible:ring-offset-gray-900';

  if (theme === 'dark') {
    return `${base} ${active ? 'bg-white/10 text-white font-semibold' : 'text-gray-300 hover:bg-white/10 hover:text-white'}`;
  }

  return `${base} ${active ? 'bg-gray-100 text-black font-semibold' : 'text-gray-700 hover:bg-gray-100 hover:text-gray-900'}`;
};

const getSubLinkClasses = (path: string) => {
  const active = isActive(path);
  const base = 'block pl-12 pr-4 py-2 text-sm rounded-lg transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 focus-visible:ring-offset-white dark:focus-visible:ring-offset-gray-900';

  if (theme === 'dark') {
    return `${base} ${active ? 'bg-white/10 text-white font-medium' : 'text-gray-400 hover:bg-white/5 hover:text-gray-200'}`;
  }

  return `${base} ${active ? 'bg-gray-100 text-black font-medium' : 'text-gray-600 hover:bg-gray-100 hover:text-gray-900'}`;
};

const getParentRowClasses = (paths: string[]) => {
  const active = isAnyActive(paths);
  const base = 'flex items-center justify-between px-4 py-3 text-base font-medium rounded-lg transition-colors w-full focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 focus-visible:ring-offset-white dark:focus-visible:ring-offset-gray-900';

  if (theme === 'dark') {
    return `${base} ${active ? 'bg-white/10 text-white font-semibold' : 'text-gray-300 hover:bg-white/10 hover:text-white'}`;
  }

  return `${base} ${active ? 'bg-gray-100 text-black font-semibold' : 'text-gray-700 hover:bg-gray-100 hover:text-gray-900'}`;
};
---

<Sheet>
  <SheetTrigger>
    <Button
      variant="default"
      size="lg"
      class="bg-white text-black border-0 cursor-pointer hover:bg-white/90"
      aria-label="Open menu"
    >
      <svg slot="left-icon" class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
        <path fill-rule="evenodd" d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"></path>
      </svg>
    </Button>
  </SheetTrigger>

  <SheetOverlay />

  <SheetContent side="right" showCloseButton={false} class="w-96 bg-white dark:bg-gray-900">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl font-semibold text-gray-900 dark:text-white">Menu</h2>
      <button
        type="button"
        data-sheet-close
        class="cursor-pointer text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-lg p-2 inline-flex items-center transition-colors"
        aria-label="Close menu"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
        </svg>
      </button>
    </div>

    <nav class="flex-1 overflow-y-auto" aria-label="Site sections">
      <ul class="space-y-1">
        <li>
          <a href="/projects/" class={getLinkClasses('/projects')}>Projects</a>
        </li>
        <li>
          <a href="/stays/" class={getLinkClasses('/stays')}>Stays</a>
        </li>
        <li>
          <a href="/blog/" class={getLinkClasses('/blog')}>News &amp; Updates</a>
        </li>
      </ul>

      <div class="my-3 border-t border-gray-100 dark:border-gray-800"></div>

      <Collapsible defaultOpen={true}>
        <CollapsibleTrigger class={getParentRowClasses(['/submit'])}>
          <span>Get Involved</span>
          <svg
            class="w-4 h-4 shrink-0 transition-transform duration-200"
            data-collapsible-chevron
            fill="currentColor"
            viewBox="0 0 20 20"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"
              clip-rule="evenodd"
            ></path>
          </svg>
        </CollapsibleTrigger>
        <CollapsibleContent>
          <ul class="space-y-0.5 mt-1">
            <li>
              <a href="/submit/" class={getSubLinkClasses('/submit')}>Submit a listing</a>
            </li>
          </ul>
        </CollapsibleContent>
      </Collapsible>

      <div class="my-3 border-t border-gray-100 dark:border-gray-800"></div>

      <Collapsible defaultOpen={true}>
        <CollapsibleTrigger class={getParentRowClasses(['/about', '/contact'])}>
          <span>About</span>
          <svg
            class="w-4 h-4 shrink-0 transition-transform duration-200"
            data-collapsible-chevron
            fill="currentColor"
            viewBox="0 0 20 20"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"
              clip-rule="evenodd"
            ></path>
          </svg>
        </CollapsibleTrigger>
        <CollapsibleContent>
          <ul class="space-y-0.5 mt-1">
            <li>
              <a href="/about/" class={getSubLinkClasses('/about')}>About Us</a>
            </li>
            <li>
              <a href="/contact/" class={getSubLinkClasses('/contact')}>Contact Us</a>
            </li>
            <li>
              <a href="/about/impacts/" class={getSubLinkClasses('/about/impacts')}>Impact Areas</a>
            </li>
          </ul>
        </CollapsibleContent>
      </Collapsible>
    </nav>
  </SheetContent>
</Sheet>

<style>
  [data-collapsible-chevron] {
    transition: transform 200ms ease;
  }
  [data-state='open'] [data-collapsible-chevron] {
    transform: rotate(180deg);
  }
</style>
