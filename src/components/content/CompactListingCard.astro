---
import ResponsiveImage from "../ui/Image/ResponsiveImage.astro";

interface Props {
    href: string;
    image: string;
    title: string;
    place: string;
    kind: "project" | "stay";
    slug: string;
}

const { href, image, title, place, kind, slug } = Astro.props;

const label = kind === "project" ? "Project" : "Stay";
const event = kind === "project" ? "project_click" : "stay_click";
---

<a
    href={href}
    class="group flex gap-4 items-start"
    data-umami-event={event}
    data-umami-event-slug={slug}
    data-umami-event-source_page={Astro.url.pathname}
>
    <div
        class="relative aspect-video w-32 sm:w-40 flex-shrink-0 overflow-hidden rounded-lg"
    >
        <ResponsiveImage
            src={image}
            alt=""
            class="w-full h-full object-cover rounded-lg transition-transform duration-300 group-hover:scale-105"
            wrapperClass="w-full h-full"
            preset="card"
            fallbackWidth={400}
        />
    </div>
    <div class="min-w-0">
        <p
            class="mb-1 text-xs font-semibold uppercase tracking-wide text-purple-600 dark:text-purple-400"
        >
            {label}
        </p>
        <h3
            class="text-base font-medium tracking-tight text-gray-900 dark:text-white line-clamp-3 group-hover:text-gray-600 dark:group-hover:text-gray-300 transition-colors"
        >
            {title}
        </h3>
        {
            place && (
                <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
                    {place}
                </p>
            )
        }
    </div>
</a>
