---
import SplitHero from "./SplitHero.astro";
import Button from "@/components/bearnie/button/Button.astro";
import Badge from "@/components/bearnie/badge/Badge.astro";

const coverImage =
    "https://res.cloudinary.com/dnxl7wsnx/image/upload/v1790166552/group-selfie_cmksrc.jpg";
const coverImageAlt =
    "A group of young people of differing ethinic backgrounds smile at the camera.";

const badge = {
    text: "New: Tourism's Hidden Climate Impact",
    url: "/blog/hidden-climate-impact-of-travel/",
};
---

<SplitHero
    coverImage={coverImage}
    coverImageAlt={coverImageAlt}
    backgroundColor="bg-indigo-100"
>
    <Badge
        href={badge.url}
        variant="outline"
        class="inline-flex items-center gap-1.5 rounded-full px-4 py-2 text-sm font-medium bg-white border-gray-500 text-gray-800 hover:bg-gray-100 hover:text-gray-900 mb-6 transition-colors duration-200"
    >
        <span>{badge.text}</span>
        <svg
            class="w-3.5 h-3.5 shrink-0"
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
        >
            <path
                d="M5 12H19M19 12L12 5M19 12L12 19"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            ></path>
        </svg>
    </Badge>

    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-gray-900 leading-[1.1] tracking-tight mb-6">
        Discover amazing ways to{" "}
        <span class="text-brand-primary-dark">give back</span> to the places you
        visit
    </h1>

    <p class="text-lg sm:text-xl text-gray-600 leading-relaxed mb-8 max-w-prose">
        Give Back Guide is a growing collection of animal sanctuaries, beach
        cleans, cultural exchanges, social impact projects, tours, tree
        planting, wellbeing experiences and more.
    </p>

    <div class="flex flex-wrap gap-4 mb-10">
        <Button size="lg" data-open-search-modal>
            <span>Search directory</span>
        </Button>

        <Button href="/about/" variant="outline" size="lg">
            Learn more
        </Button>
    </div>

    <div class="flex flex-wrap gap-6 sm:gap-10">
        <div>
            <div class="text-2xl sm:text-3xl font-extrabold text-brand-primary-dark">
                400+
            </div>
            <div class="text-sm text-gray-500 font-medium mt-0.5">Listings</div>
        </div>
        <div class="hidden sm:block w-px h-12 bg-gray-400"></div>
        <div>
            <div class="text-2xl sm:text-3xl font-extrabold text-brand-primary-dark">
                60+
            </div>
            <div class="text-sm text-gray-500 font-medium mt-0.5">
                Countries
            </div>
        </div>
        <div class="hidden sm:block w-px h-12 bg-gray-400"></div>
        <div>
            <div class="text-2xl sm:text-3xl font-extrabold text-brand-primary-dark">
                10+
            </div>
            <div class="text-sm text-gray-500 font-medium mt-0.5">
                Impact Areas
            </div>
        </div>
    </div>
</SplitHero>

<script is:inline>
    (function () {
        const buttons = document.querySelectorAll("[data-open-search-modal]");
        buttons.forEach(function (btn) {
            btn.addEventListener("click", function (e) {
                e.preventDefault();
                const trigger = document.querySelector(
                    "[data-command-dialog-trigger]",
                );
                if (trigger) {
                    trigger.click();
                }
            });
        });
    })();
</script>
