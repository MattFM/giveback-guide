---
import SplitHero from "./SplitHero.astro";
import Button from "@/components/bearnie/button/Button.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";

const coverImage =
    "https://res.cloudinary.com/dnxl7wsnx/image/upload/v1760956856/two-travellers-stairs_jv3ixf.jpg";
const coverImageAlt = "Woman standing on a bridge in a forest";
---

<SplitHero
    coverImage={coverImage}
    coverImageAlt={coverImageAlt}
    backgroundColor="bg-gray-50"
>
    <h1
        class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-gray-900 leading-tight tracking-tight mb-6"
    >
        Discover amazing ways to <span class="text-gbg-indigo-600"
            >give back</span
        > to the places you visit
    </h1>

    <p
        class="text-lg sm:text-xl text-gray-600 leading-relaxed mb-10 max-w-prose"
    >
        {SITE_DESCRIPTION}
    </p>

    <div class="flex flex-wrap gap-4">
        <Button size="lg" data-open-search-modal>
            <svg
                slot="left-icon"
                class="w-5 h-5"
                aria-hidden="true"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
            >
                <path
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-width="2"
                    d="m21 21-3.5-3.5M17 10a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z"
                ></path>
            </svg>
            <span>Search 400+ projects & stays</span>
        </Button>

        <Button href="/about/" variant="outline" size="lg">
            Learn more
        </Button>
    </div>
</SplitHero>

<script is:inline>
    (function () {
        const buttons = document.querySelectorAll("[data-open-search-modal]");
        buttons.forEach(function (btn) {
            btn.addEventListener("click", function (e: MouseEvent) {
                e.preventDefault();
                const searchBtn = document.getElementById("search-button");
                if (searchBtn) {
                    searchBtn.click();
                }
            });
        });
    })();
</script>
