---
import Card from "@/components/bearnie/card/Card.astro";
import CardContent from "@/components/bearnie/card/CardContent.astro";
import CardDescription from "@/components/bearnie/card/CardDescription.astro";
import CardHeader from "@/components/bearnie/card/CardHeader.astro";
import CardTitle from "@/components/bearnie/card/CardTitle.astro";
import Button from "@/components/bearnie/button/Button.astro";
---

<Card>
  <CardHeader class="pb-3">
    <div class="flex items-center gap-3">
      <!-- Material Symbols: favourite (rounded) -->
      <svg
        xmlns="http://www.w3.org/2000/svg"
        height="24px"
        viewBox="0 -960 960 960"
        width="24px"
        fill="currentColor"
        class="text-red-500 dark:text-red-400"
      >
        <path
          d="m480-120-58-52q-101-91-167-157T150-447.5Q111-500 95.5-544T80-634q0-94 63-157t157-63q52 0 99 22t81 62q34-40 81-62t99-22q94 0 157 63t63 157q0 46-15.5 90T810-447.5Q771-395 705-329T538-172l-58 52Z"
        ></path>
      </svg>
      <CardTitle>Help keep this platform free</CardTitle>
    </div>
  </CardHeader>

  <CardContent>
    <CardDescription class="mb-4">
      Every coffee helps us add more verified projects and keeps Giveback Guide
      free for everyone.
    </CardDescription>

    <Button
      href="https://buymeacoffee.com/giveback.guide"
      size="lg"
      class="w-full"
      target="_blank"
      rel="noopener noreferrer"
    >
      Buy Us a Coffee
      <!-- Material Symbols: open_in_new (rounded) -->
      <svg
        slot="right-icon"
        xmlns="http://www.w3.org/2000/svg"
        height="20px"
        viewBox="0 -960 960 960"
        width="20px"
        fill="currentColor"
      >
        <path
          d="M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h280v80H200v560h560v-280h80v280q0 33-23.5 56.5T760-120H200Zm188-212-56-56 372-372H560v-80h280v280h-80v-144L388-332Z"
        ></path>
      </svg>
    </Button>
  </CardContent>
</Card>
