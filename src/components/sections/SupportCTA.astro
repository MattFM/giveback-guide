---
import Card from "@/components/bearnie/card/Card.astro";
import CardContent from "@/components/bearnie/card/CardContent.astro";
import CardDescription from "@/components/bearnie/card/CardDescription.astro";
import CardHeader from "@/components/bearnie/card/CardHeader.astro";
import CardTitle from "@/components/bearnie/card/CardTitle.astro";
import Button from "@/components/bearnie/button/Button.astro";
---

<Card>
    <CardHeader class="pb-3">
        <CardTitle
            ><span aria-hidden="true">❤️</span> Donate & support our work</CardTitle
        >
    </CardHeader>

    <CardContent>
        <CardDescription class="mb-4 text-base">
            Give Back Guide is free for everyone to use, but it still costs us
            money to run. Please help to ensure we can continue our work in
            building this platform by donating whatever you can.
        </CardDescription>

        <Button
            href="https://ko-fi.com/givebackguide"
            size="default"
            target="_blank"
            rel="noopener noreferrer"
        >
            Donate
            <!-- Material Symbols: open_in_new (rounded) -->
            <svg
                slot="right-icon"
                xmlns="http://www.w3.org/2000/svg"
                height="20px"
                viewBox="0 -960 960 960"
                width="20px"
                fill="currentColor"
            >
                <path
                    d="M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h280v80H200v560h560v-280h80v280q0 33-23.5 56.5T760-120H200Zm188-212-56-56 372-372H560v-80h280v280h-80v-144L388-332Z"
                ></path>
            </svg>
        </Button>
    </CardContent>
</Card>
