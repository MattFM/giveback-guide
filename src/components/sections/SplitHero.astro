---
/**
 * Page/blog hero: full-bleed two-column layout with the cover image on the
 * right. Now a thin prop adapter over the generic `SplitMedia` primitive —
 * all responsive-image and skeleton behaviour lives there.
 *
 * Public API is unchanged so existing consumers (HomeSplitHero,
 * BlogPostLayout) need no edits.
 */
import SplitMedia from "./SplitMedia.astro";

interface Props {
    coverImage?: string;
    coverImageAlt?: string;
    backgroundColor?: string;
    coverImagePosition?: string;
    pagefindImageMeta?: string;
    short?: boolean;
}

const {
    coverImage,
    coverImageAlt = "",
    backgroundColor = "bg-gray-50",
    coverImagePosition = "center",
    pagefindImageMeta,
    short = false,
} = Astro.props;

const minHeightClass = short
    ? "min-h-[40vh] lg:min-h-[50vh]"
    : "min-h-[60vh] lg:min-h-[80vh]";
---

<SplitMedia
    image={coverImage}
    imageAlt={coverImageAlt}
    imageSide="right"
    imagePreset="hero"
    backgroundColor={backgroundColor}
    objectPosition={coverImagePosition}
    minHeightClass={minHeightClass}
    fullBleed={true}
    pagefindImageMeta={pagefindImageMeta}
    loading="eager"
    fetchpriority="high"
>
    <slot />
</SplitMedia>
