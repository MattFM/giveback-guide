---
import { getCollection } from "astro:content";
import ContentCard from "../content/ContentCard.astro";
import NewsBlogCard from "../content/NewsBlogCard.astro";
import BlogTagsDropdown from "../ui/Dropdown/BlogTagsDropdown.astro";
import BlogTags from "../content/BlogTags.astro";
import { getValidTags } from "../../lib/blog-tags";

interface Props {
  limit?: number;
}

const { limit = 9 } = Astro.props;

const entries = await getCollection("blog");

const sortedEntries = entries.sort((a, b) => {
  return b.data.published.getTime() - a.data.published.getTime();
});

const limitedEntries = sortedEntries.slice(0, limit).map((entry) => ({
  ...entry,
  validTags: getValidTags(entry.data.tags),
}));

const featured = limitedEntries[0];
const middle = limitedEntries.slice(1, 3);
const textList = limitedEntries.slice(3);
---

<section class="bg-white dark:bg-gray-900 py-8 sm:py-16">
  <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10">
      <div>
        <h2
          class="text-3xl md:text-4xl tracking-tight font-extrabold text-gray-900 dark:text-white mb-2"
        >
          Latest Blog Posts
        </h2>
        <p class="text-gray-500 sm:text-xl dark:text-gray-400">
          Read the latest travel guides and advice from our blog.
        </p>
      </div>
      <div class="flex items-center gap-2 flex-shrink-0">
        <BlogTagsDropdown />
        <a
          href="/blog"
          class="inline-flex items-center justify-center px-4 py-2.5 border border-gray-300 text-gray-900 text-sm rounded-lg hover:bg-gray-100 focus:z-10 focus:ring-4 focus:outline-none focus:ring-gray-100 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:text-white dark:hover:bg-gray-700 dark:focus:ring-gray-700 cursor-pointer"
        >
          View All
          <svg
            class="w-5 h-5 ml-2.5"
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            fill="none"
            viewBox="0 0 24 24"
          >
            <path
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 12H5m14 0-4 4m4-4-4-4"
            />
          </svg>
        </a>
      </div>
    </div>

    <!-- Three-column news layout -->
    <div class="grid grid-cols-1 md:grid-cols-10 gap-8 lg:gap-10">
      <!-- Column 1: Featured Post (40%) -->
      <div class="md:col-span-4">
        {
          featured && (
            <ContentCard
              href={`/blog/${featured.data.slug}/`}
              image={featured.data.coverImage}
              imageAlt={featured.data.title}
              title={featured.data.title}
              subtitle={featured.data.description}
              transitionName={`post-title-${featured.data.slug}`}
            >
              <div slot="meta">
                <BlogTags tags={featured.validTags} />
              </div>
            </ContentCard>
          )
        }
      </div>

      <!-- Column 2: Two stacked image cards (30%) -->
      <div class="md:col-span-3 md:pl-8 md:border-l border-gray-200 dark:border-gray-700 flex flex-col gap-8">
        {
          middle.map((post) => (
            <NewsBlogCard
              href={`/blog/${post.data.slug}/`}
              image={post.data.coverImage}
              imageAlt={post.data.title}
              title={post.data.title}
              tags={post.validTags}
              transitionName={`post-title-${post.data.slug}`}
            />
          ))
        }
      </div>

      <!-- Column 3: Text-only links (30%) -->
      <div class="md:col-span-3 md:pl-8 md:border-l border-gray-200 dark:border-gray-700">
        {
          textList.length > 0 && (
            <ul class="space-y-5">
              {textList.map((post) => {
                return (
                  <li>
                    <div class="mb-1">
                      <BlogTags tags={post.validTags} />
                    </div>
                    <a
                      href={`/blog/${post.data.slug}/`}
                      class="text-base font-medium text-gray-900 dark:text-white hover:text-gray-600 dark:hover:text-gray-300 transition-colors leading-snug block"
                    >
                      {post.data.title}
                    </a>
                  </li>
                );
              })}
            </ul>
          )
        }
      </div>
    </div>
  </div>
</section>
