---
import { getCollection } from "astro:content";
import BaseSelectDropdown from "./BaseSelectDropdown.astro";

const slugify = (s: string) =>
  s.toLowerCase().trim().replace(/\s+/g, "-");

// Single getCollection call. Both `currentCountry` (URL probe) and
// `uniqueCountries` (dropdown items) are derived from the same result,
// so we don't pay for an extra round-trip through the content layer.
const stays = await getCollection("stays");

const validCountrySlugs = new Set<string>();
const uniqueCountries = new Set<string>();
for (const stay of stays) {
  const raw = stay.data.properties.sCountry;
  const countries = Array.isArray(raw) ? raw : [raw];
  for (const country of countries) {
    if (typeof country !== "string" || country.length === 0) continue;
    uniqueCountries.add(country);
    validCountrySlugs.add(slugify(country));
  }
}

const potentialCountry = Astro.url.pathname.split("/")[2] ?? "";
const currentCountry = validCountrySlugs.has(potentialCountry)
  ? potentialCountry
  : null;

const items = [...uniqueCountries]
  .sort((a, b) => a.localeCompare(b))
  .map((country) => {
    const countrySlug = slugify(country);
    return {
      name: country,
      slug: countrySlug,
      url: `/stays/${countrySlug}`,
    };
  });
---

<BaseSelectDropdown
  items={items}
  currentItem={currentCountry}
  placeholder="Countries"
  id="stay-countries"
/>
