---
import { getCollection } from "astro:content";
import BaseSelectDropdown from "./BaseSelectDropdown.astro";
import { isValidBlogTag, getTagSlug } from "../../../lib/blog-tags";

const posts = await getCollection("blog");

// Get the current tag from the URL
const pathSegments = Astro.url.pathname.split("/");
const potentialTag = pathSegments[2];

// Build a set of valid, used tag slugs
const validUsedSlugs = posts.reduce((acc: Set<string>, post) => {
  post.data.tags.forEach((tag) => {
    if (isValidBlogTag(tag)) {
      acc.add(getTagSlug(tag));
    }
  });
  return acc;
}, new Set<string>());

const currentTag = validUsedSlugs.has(potentialTag) ? potentialTag : null;

// Extract unique tags that are both valid and in use, then sort alphabetically
const uniqueTags = [
  ...new Set(
    posts
      .flatMap((post) => post.data.tags)
      .filter(isValidBlogTag)
  ),
].sort();

// Transform to items array for BaseSelectDropdown
const items = uniqueTags.map((tag) => {
  const tagSlug = getTagSlug(tag);
  return {
    name: tag,
    slug: tagSlug,
    url: `/blog/${tagSlug}`,
  };
});
---

<BaseSelectDropdown
  items={items}
  currentItem={currentTag}
  placeholder="Categories"
  id="blog-tags"
/>