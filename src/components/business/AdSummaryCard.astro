---
/**
 * Cross-link band pointing at the separate /for-businesses/advertising/ page.
 *
 * Thin wrapper over the shared `CrossLinkCta` so this band and the reciprocal
 * one on the advertising page stay identical. Background matches the site
 * header, which lets the band divide the grey sections either side of it.
 */
import CrossLinkCta from "./CrossLinkCta.astro";
---

<CrossLinkCta
  headingId="ad-summary-heading"
  heading="Looking to advertise directly?"
  body="Display advertising on Give Back Guide is a separate offering from directory listings. Ads can be purchased by any business — listed or not — and appear across our blog and key landing pages."
  cta={{ label: "View advertising options", href: "/for-businesses/advertising/" }}
  divider={true}
/>
