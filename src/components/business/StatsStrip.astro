---
/**
 * N-up stat row. Deliberately chrome-free: no cards, no borders, no fills —
 * the numbers and labels carry the hierarchy.
 *
 * Rendered as a definition list: each label is a <dt>, and the value plus
 * caption sit in the corresponding <dd>. Column count follows `stats.length`,
 * so a two-stat dataset can't leave an empty third column.
 */
import type { StatBlock } from "@/data/business-stat-blocks";

interface Props {
  stats: StatBlock[];
}

const { stats } = Astro.props;

const columnClasses: Record<number, string> = {
  1: "sm:grid-cols-1",
  2: "sm:grid-cols-2",
  3: "sm:grid-cols-3",
  4: "sm:grid-cols-4",
};

const gridCols = columnClasses[stats.length] ?? "sm:grid-cols-3";
---

<dl class:list={["grid grid-cols-1 gap-x-12 gap-y-10", gridCols]}>
  {
    stats.map((stat) => (
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">
          {stat.label}
        </dt>
        <dd class="mt-2">
          <span class="block text-4xl sm:text-5xl font-extrabold tracking-tight tabular-nums text-gray-900 dark:text-white">
            {stat.value}
          </span>
          <span class="mt-2 block text-sm text-gray-600 dark:text-gray-400">
            {stat.caption}
          </span>
        </dd>
      </div>
    ))
  }
</dl>
