---
/**
 * Pricing section wrapper. Composes the heading, monthly/yearly toggle and
 * the 3 tier cards into the visual /for-businesses/ pricing block.
 *
 * The toggle is hidden while `PRICING_PUBLIC` is false, since it controls
 * period prices that aren't being shown.
 */
import { PRICING_PUBLIC, pricingTiers } from "@/data/business-pricing";
import PricingCard from "./PricingCard.astro";
import PricingToggle from "./PricingToggle.astro";
---

<section
    aria-labelledby="pricing-heading"
    class="mx-auto max-w-screen-xl px-4 sm:px-6 lg:px-6"
>
    <div class="text-center max-w-2xl mx-auto mb-10">
        <h2
            id="pricing-heading"
            class="text-2xl sm:text-3xl font-bold tracking-tight text-gray-900 dark:text-white"
        >
            Choose how you want to be listed
        </h2>
        <p class="mt-3 text-base text-gray-600 dark:text-gray-400">
            Start for free and upgrade when you are ready for more visibility.
            Bespoke arrangements are available for closer partnerships.
        </p>
    </div>

    {PRICING_PUBLIC && (
        <div class="flex justify-center mb-10">
            <PricingToggle />
        </div>
    )}

    <div
        class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 items-stretch"
        data-pricing-root
    >
        {pricingTiers.map((tier) => (
            <PricingCard tier={tier} />
        ))}
    </div>
</section>
