---
/**
 * "Your free listing includes…" checklist.
 * Renders the 6 free-tiers fields from `listingIncludes`.
 */
import { listingIncludes } from "@/data/listing-includes";
import HugeIcon from "@/components/bearnie/icon/HugeIcon.astro";
import { CheckmarkCircle01Icon } from "@/components/bearnie/icon/icons";
---

<section
  aria-labelledby="listing-includes-heading"
  class="mx-auto max-w-screen-xl px-4 sm:px-6 lg:px-6"
>
  <h2
    id="listing-includes-heading"
    class="text-2xl sm:text-3xl font-bold tracking-tight text-gray-900 dark:text-white"
  >
    Your free listing includes
  </h2>
  <p class="mt-3 text-base text-gray-600 dark:text-gray-400">
    Every free listing carries the same set of fields — enough for a traveller
    to find you, understand your impact and engage with your business.
  </p>
  <ul class="mt-8 space-y-3">
    {
      listingIncludes.map((item) => (
        <li class="flex items-start gap-3">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-gbg-turquoise-100 text-gbg-turquoise-700 dark:bg-gbg-turquoise-700/20 dark:text-gbg-turquoise-300">
            <HugeIcon icon={CheckmarkCircle01Icon} size="sm" />
          </span>
          <div>
            <p class="font-medium text-gray-900 dark:text-white">{item.title}</p>
            <p class="text-sm text-gray-600 dark:text-gray-400">
              {item.description}
            </p>
          </div>
        </li>
      ))
    }
  </ul>
</section>
