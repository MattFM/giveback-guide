---
import { cn } from "@/utils/cn";
import type { HTMLAttributes } from "astro/types";
// Bearnie's curated path `@/components/fundations/icons/HugeIcon.astro` doesn't exist
// in this project. Use the working relative path so this component still resolves.
// If/when the upstream path is created, this local tweak can be reverted.
import HugeIcon from "../icon/HugeIcon.astro";
import { MoreHorizontalIcon } from "../icon/icons";

export interface Props extends HTMLAttributes<"span"> {}

const { class: className, ...props } = Astro.props;

const classes = cn(
  "flex size-9 items-center justify-center",
  className
);
---

<span aria-hidden="true" class={classes} {...props}>
  <HugeIcon icon={MoreHorizontalIcon} class="size-4" />
  <span class="sr-only">More pages</span>
</span>
