---
import { cn } from "@/utils/cn";
import type { HTMLAttributes } from "astro/types";
// Bearnie's curated path `@/components/fundations/icons/HugeIcon.astro` doesn't exist
// in this project. Use the working relative path so this component still resolves.
// If/when the upstream path is created, this local tweak can be reverted.
import HugeIcon from "../icon/HugeIcon.astro";
import { CircleIcon } from "../icon/icons";

export interface Props extends HTMLAttributes<"div"> {}

const { class: className, ...props } = Astro.props;

const classes = cn(
  "flex items-center justify-center text-muted-foreground",
  className
);
---

<div
  class={classes}
  role="separator"
  aria-orientation="vertical"
  data-otp-separator
  {...props}
>
  <slot>
    <HugeIcon icon={CircleIcon} class="size-4" />
  </slot>
</div>
