---
import { SITE_TITLE } from "../../consts";
import Button from "@/components/bearnie/button/Button.astro";
import Card from "@/components/bearnie/card/Card.astro";
import CardHeader from "@/components/bearnie/card/CardHeader.astro";
import CardTitle from "@/components/bearnie/card/CardTitle.astro";
import CardContent from "@/components/bearnie/card/CardContent.astro";
import Input from "@/components/bearnie/input/Input.astro";

import Alert from "@/components/bearnie/alert/Alert.astro";
import AlertTitle from "@/components/bearnie/alert/AlertTitle.astro";
import AlertDescription from "@/components/bearnie/alert/AlertDescription.astro";
---

<!-- Two Column Layout -->
<section class="border-t border-gray-200 dark:border-gray-800">
    <div class="lg:grid lg:grid-cols-2">
        <!-- Left Column: Hero & Info -->
        <div
            class="flex flex-col lg:justify-center bg-gray-50 dark:bg-gray-900"
        >
            <div class="max-w-xl w-full lg:ml-auto px-8 xl:px-16 py-12">
                <h1
                    class="text-4xl xl:text-5xl font-extrabold text-gray-900 dark:text-white mb-6"
                >
                    Welcome to {SITE_TITLE}
                </h1>
                <p
                    class="text-lg xl:text-xl text-gray-500 dark:text-gray-400 mb-12"
                >
                    Thank you for signing up for your free account. Before
                    sending you to your dashboard, we have a couple of quick
                    questions for you.
                </p>
            </div>
        </div>

        <!-- Right Column: Form -->
        <div class="flex items-center justify-center">
            <div class="w-full max-w-lg lg:mr-auto px-4 py-12 lg:py-16">
                <Card>
                    <CardHeader>
                        <CardTitle>Complete Your Profile</CardTitle>
                    </CardHeader>
                    <CardContent>
                        <form id="onboardForm" class="space-y-8">
                            <!-- First Name -->
                            <div class="space-y-2">
                                <label for="firstName">What should we call you?</label>
                                <Input
                                    id="firstName"
                                    name="name"
                                    type="text"
                                    required
                                    placeholder="Your first name"
                                />
                            </div>

                            <!-- Newsletter Opt-in -->
                            <div class="flex items-start gap-4">
                                <input
                                    id="newsletter"
                                    name="newsletter"
                                    type="checkbox"
                                    class="size-4 shrink-0 cursor-pointer"
                                />
                                <div class="flex-1">
                                    <label
                                        for="newsletter"
                                        class="block text-base font-medium cursor-pointer text-foreground"
                                    >
                                        Subscribe to our newsletter
                                    </label>
                                    <div class="text-sm mt-2 text-muted-foreground">
                                        <p>
                                            Get news and updates from us, plus
                                            our latest blog posts and news from
                                            the sustainable travel world
                                            directly to your inbox. No spam,
                                            unsubscribe anytime.
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- Newsletter Confirmation Message -->
                            <Alert
                                id="newsletterConfirmMsg"
                                variant="success"
                                class="hidden"
                                role="status"
                                aria-live="polite"
                            >
                                <svg
                                    class="w-5 h-5 text-green-600 dark:text-green-400"
                                    fill="currentColor"
                                    viewBox="0 0 20 20"
                                >
                                    <path
                                        fill-rule="evenodd"
                                        d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                                        clip-rule="evenodd"></path>
                                </svg>
                                <AlertTitle>Subscribed!</AlertTitle>
                                <AlertDescription>
                                    <p>
                                        You'll may receive a separate email with
                                        instructions to confirm your
                                        subscription. Don't worry though if you
                                        don't.
                                    </p>
                                </AlertDescription>
                            </Alert>

                            <!-- Terms Consent -->
                            <div class="flex items-start gap-4">
                                <input
                                    id="consent"
                                    name="consent"
                                    type="checkbox"
                                    required
                                    class="size-4 shrink-0 cursor-pointer"
                                />
                                <label
                                    for="consent"
                                    class="text-sm leading-relaxed cursor-pointer text-muted-foreground"
                                >
                                    I agree to the <a
                                        href="/terms"
                                        class="font-semibold underline hover:no-underline text-foreground"
                                        >Terms of Service</a
                                    > and <a
                                        href="/privacy"
                                        class="font-semibold underline hover:no-underline text-foreground"
                                        >Privacy Policy</a
                                    >
                                </label>
                            </div>

                            <!-- Submit Button -->
                            <Button
                                type="submit"
                                id="submitBtn"
                                size="lg"
                                class="w-full"
                            >
                                <span class="inline-flex items-center gap-2">
                                    Continue to Dashboard
                                    <svg
                                        class="w-5 h-5"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                                    </svg>
                                </span>
                            </Button>

                            <!-- Form Messages -->
                            <Alert id="formMessageSuccess" variant="success" class="hidden" role="status" aria-live="polite">
                                <AlertDescription id="formMessageSuccessText"></AlertDescription>
                            </Alert>
                            <Alert id="formMessageError" variant="destructive" class="hidden" role="alert">
                                <AlertDescription id="formMessageErrorText"></AlertDescription>
                            </Alert>
                        </form>
                    </CardContent>
                </Card>
            </div>
        </div>
    </div>
</section>
