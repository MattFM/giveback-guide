<!--
  `data-domains` restricts collection to the production hostname, so preview
  deploys, localhost and the retired heretotravel.com domain stop recording.
  The hostname check is an exact match, so www (which 301s to the apex) and
  translated copies are excluded too.

  `data-performance` enables Core Web Vitals collection. It was off, which is
  why the Umami performance report was empty.
-->

<!--
  Bot gate.

  Umami calls `beforeSend` with every payload just before it is sent; returning
  a falsy value cancels the send. This drops the headless-Chrome farm that has
  been inflating the figures since roughly September 2026. It rotates its IP
  address with every hit and spoofs a normal Chrome user agent, so Umami's own
  bot filter (which only reads the user agent string) waves it through. What it
  cannot vary convincingly is its screen size, and that is what this checks.

  Deliberately narrow: every screen check also requires the language and a
  matching desktop user agent, so a genuine reader on an unusual display is
  still counted. The webdriver and headless checks only ever match automated
  browsers.

  1920x1080 is left alone on purpose — it is far too common among real readers,
  so traffic claiming it is handled at the edge by the Cloudflare rule instead.

  This block must stay inline and above the tracker below, because
  `window.umamiConfig` has to exist before `script.js` runs. To remove the gate,
  delete this block — nothing else depends on it.
-->
<script is:inline>
  window.umamiConfig = {
    beforeSend: function (type, payload) {
      if (!payload) return payload;

      var userAgent = navigator.userAgent || "";

      // Automated browsers are never genuine readers.
      if (navigator.webdriver) return false;
      if (/HeadlessChrome|PhantomJS|Selenium|Puppeteer/i.test(userAgent)) return false;

      var isChrome = /Chrome\//.test(userAgent);
      var isWindowsDesktop = /Windows NT/.test(userAgent);
      var isLinuxDesktop = /X11; Linux/.test(userAgent);
      var isMacDesktop = /Macintosh/.test(userAgent);

      // Screens no real reader plausibly reports, all seen in the same scraper
      // traffic, all paired with en-US regardless of the country it claims.
      if (payload.language === "en-US") {
        if (payload.screen === "1280x1200" && isChrome && isWindowsDesktop) return false;
        if (payload.screen === "1536x960" && isChrome && isLinuxDesktop) return false;
      }

      // A Mac cannot report an 800x600 screen, so the user agent is invented.
      // Applied regardless of language: no real Mac reports this size.
      if (payload.screen === "800x600" && isMacDesktop) return false;

      return payload;
    },
  };
</script>

<script
    defer
    src="https://umami.giveback.guide/script.js"
    data-website-id="34887332-2d1d-4cd4-907c-dad4712d4501"
    data-domains="giveback.guide"
    data-performance="true"></script>
