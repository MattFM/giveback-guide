---
import MainLayout from "../layouts/MainLayout.astro";
import HomeSplitHero from "../components/sections/HomeSplitHero.astro";
import InfiniteScroll from "../components/ui/InfiniteScroll.astro";
import LatestProjectsCarousel from "../components/sections/LatestProjectsCarousel.astro";
import LatestStaysCarousel from "../components/sections/LatestStaysCarousel.astro";
import LatestPostsNews from "../components/sections/LatestPostsNews.astro";
import { SITE_TITLE } from "../consts";
import { organisationSchema, websiteSchema } from "../utils/schema";

const site = Astro.site ?? new URL("https://giveback.guide");
const schema = [organisationSchema(site), websiteSchema(site)];
---

<MainLayout
    title={`${SITE_TITLE}: Regenerative Travel Directory`}
    description="A directory of animal sanctuaries, beach cleans, conservation projects, social enterprises and sustainable stays you can visit around the world."
    headerVariant="default"
    headerTheme="light"
    schema={schema}
>
    <HomeSplitHero />
    <InfiniteScroll speed="normal" direction="left" />
<main>
    <LatestProjectsCarousel limit={10} />
    <LatestStaysCarousel limit={10} />
    <LatestPostsNews limit={9} />
</main>
</MainLayout>
