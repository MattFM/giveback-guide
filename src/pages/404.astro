---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="404 - Page Not Found">
    <section class="bg-white dark:bg-gray-900">
        <div class="py-8 px-4 mx-auto max-w-screen-xl lg:py-16 lg:px-6">
            <div class="mx-auto max-w-screen-sm text-center">
                <h1
                    class="mb-4 text-7xl tracking-tight font-extrabold lg:text-9xl text-black dark:text-white"
                >
                    404
                </h1>
                <p
                    class="mb-4 text-3xl tracking-tight font-bold text-gray-900 md:text-4xl dark:text-white"
                >
                    Page not found
                </p>
                <p
                    class="mb-4 text-lg font-light text-gray-500 dark:text-gray-400"
                >
                    The page you requested has either been moved, deleted or has
                    never existed. Please go to the homepage to continue
                    exploring.
                </p>
                <a
                    href="/"
                    class="inline-flex text-white bg-black hover:bg-purple-700 focus:ring-4 focus:outline-none focus:ring-primary-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:focus:ring-primary-900 my-4"
                    >Back to Homepage</a
                >
                <nav aria-label="Site sections" class="mt-2">
                    <ul
                        class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm font-medium"
                    >
                        <li>
                            <a
                                href="/projects/"
                                class="text-gray-600 underline underline-offset-4 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
                                >Projects</a
                            >
                        </li>
                        <li>
                            <a
                                href="/stays/"
                                class="text-gray-600 underline underline-offset-4 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
                                >Stays</a
                            >
                        </li>
                        <li>
                            <a
                                href="/blog/"
                                class="text-gray-600 underline underline-offset-4 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
                                >Blog</a
                            >
                        </li>
                        <li>
                            <a
                                href="/search/"
                                class="text-gray-600 underline underline-offset-4 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
                                >Search</a
                            >
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </section>
</MainLayout>
