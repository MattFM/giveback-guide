---
import { getCollection } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import type { GetStaticPathsOptions } from "astro";
import StayCard from "../../components/content/StayCard.astro";
import StayCountryDropdown from "../../components/ui/Dropdown/StayCountryDropdown.astro";
import Pagination from "../../components/ui/Pagination.astro";
import { buildTitle } from "../../utils/seo";
import { itemListSchema } from "../../utils/schema";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const entries = await getCollection("stays");

  // Sort stays by sPublished date (descending order)
  const sortedEntries = entries.sort((a, b) => {
    const dateA = a.data.properties.sPublished || new Date(0);
    const dateB = b.data.properties.sPublished || new Date(0);
    return dateB.getTime() - dateA.getTime(); // Most recent first
  });

  return paginate(sortedEntries, {
    pageSize: 9, // Number of entries per page
  });
}

const { page } = Astro.props;

const title = buildTitle(
  ["Sustainable Stays & Eco Hotels", "Sustainable Stays"],
  { page: page.currentPage, total: page.lastPage },
);
const description =
  "Hotels, homestays and lodges that fund conservation, education or community projects — places to stay that give back to the places you visit.";

const site = Astro.site ?? new URL("https://giveback.guide");
const schema = itemListSchema({
  site,
  url: new URL(Astro.url.pathname, site).href,
  name: "Sustainable Stays",
  items: page.data.map((stay) => ({
    name: stay.data.properties.sTitle,
    url: `/stays/${stay.data.properties.sSlug}/`,
  })),
  start: page.start,
  total: page.total,
});
---

<MainLayout title={title} description={description} schema={schema}>
  <section class="bg-white dark:bg-gray-900">
    <div class="py-8 px-4 mx-auto max-w-screen-xl sm:py-16 lg:px-6">
      <div class="max-w-screen-md mb-8 lg:mb-16">
        <h1
          class="mb-4 text-4xl tracking-tight font-extrabold text-gray-900 dark:text-white"
        >
          Stays
        </h1>
        <p class="text-gray-500 sm:text-xl dark:text-gray-400">
          Find somewhere amazing to stay which gives back to the community you're visiting.
        </p>
      </div>
      
      <div class="flex flex-col md:flex-row mb-5">
        <!-- Div 1 (Showing stays) -->
        <div id="1" class="w-full md:w-3/4 p-2 order-3 md:order-1">
          <span class="text-sm font-normal text-gray-500 dark:text-gray-400">
            Showing <span class="font-semibold text-gray-900 dark:text-white">
              {page.start + 1}-{page.end + 1}
            </span> of <span class="font-semibold text-gray-900 dark:text-white">
              {page.total}
            </span> stays          </span>
        </div>
      
        <!-- Div 3 (Country Dropdown) -->
        <div id="3" class="w-full md:w-1/4 p-2 order-2 md:order-3">
          <StayCountryDropdown />
        </div>
      </div>

      <div
        class="space-y-8 md:grid md:grid-cols-2 lg:grid-cols-3 md:gap-12 md:space-y-0"
      >
        {page.data.map((stay) => <StayCard stay={stay} />)}
      </div>
    </div>
  </section>
  <section class="bg-white dark:bg-gray-900">
    <div class="py-8 px-4 mx-auto max-w-screen-xl sm:py-16 lg:px-6">
      <Pagination 
        currentPage={page.currentPage}
        lastPage={page.lastPage}
        prevUrl={page.url.prev}
        nextUrl={page.url.next}
        baseUrl="/stays"
      />
    </div>
  </section>
</MainLayout>
