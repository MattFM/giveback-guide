---
import { getCollection } from "astro:content";
import MainLayout from "../../../layouts/MainLayout.astro";
import type { GetStaticPathsOptions } from "astro";
import ProjectCard from "../../../components/content/ProjectCard.astro";
import ProjectCountryDropdown from "../../../components/ui/Dropdown/ProjectCountryDropdown.astro";
import ProjectLocaleDropdown from "../../../components/ui/Dropdown/ProjectLocaleDropdown.astro";
import Pagination from "../../../components/ui/Pagination.astro";
import {
  buildHubDescription,
  buildTitle,
  rankByFrequency,
} from "../../../utils/seo";
import Breadcrumbs from "../../../components/layout/Breadcrumbs.astro";
import CompactBlogCard from "../../../components/content/CompactBlogCard.astro";
import { itemListSchema } from "../../../utils/schema";
import { findPostsForPlace } from "../../../utils/related";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  // Fetch all projects once.
  const projects = await getCollection("projects");

  // Bucket each project into every country group it belongs to in a single
  // pass. Avoids re-iterating the full collection once per country.
  const slugify = (s: string) => s.toLowerCase().trim().replace(/\s+/g, "-");
  type Entry = { project: (typeof projects)[number]; date: number };
  const grouped = new Map<string, Entry[]>();
  // The slug is lossy ("usa"), so keep the raw Notion name ("USA") for display.
  const names = new Map<string, string>();

  for (const project of projects) {
    const rawCountries = project.data.properties.pCountry;
    const countries = Array.isArray(rawCountries) ? rawCountries : [rawCountries];
    const date = (project.data.properties.pPublished ?? new Date(0)).getTime();
    for (const country of countries) {
      const name = String(country ?? "").trim();
      const countrySlug = slugify(name);
      if (!countrySlug) continue;
      names.set(countrySlug, name);
      const list = grouped.get(countrySlug);
      if (list) list.push({ project, date });
      else grouped.set(countrySlug, [{ project, date }]);
    }
  }

  // Sort each country group once and emit paginated paths.
  const paths = [];
  for (const [country, items] of grouped) {
    items.sort((a, b) => b.date - a.date);
    paths.push(
      ...paginate(
        items.map((i) => i.project),
        {
          pageSize: 9,
          params: { country },
          props: {
            country,
            countryName: names.get(country) ?? country,
            // Aggregated once per country so the description can name real
            // places and impact areas instead of a generic sentence.
            cities: rankByFrequency(
              items.flatMap((i) => i.project.data.properties.pLocale ?? []),
              3,
            ),
            impacts: rankByFrequency(
              items.flatMap((i) => i.project.data.properties.pImpactsNames ?? []),
              3,
            ),
          },
        }
      )
    );
  }

  return paths;
}

const { country, countryName, cities, impacts, page } = Astro.props; // Get the paginated data

const title = buildTitle(
  [
    `Regenerative Travel Projects in ${countryName}`,
    `Regenerative Projects in ${countryName}`,
  ],
  { page: page.currentPage, total: page.lastPage },
);

const description = buildHubDescription({
  count: page.total,
  place: countryName,
  cities,
  impacts,
  kind: "project",
});

const site = Astro.site ?? new URL("https://giveback.guide");
const schema = itemListSchema({
  site,
  url: new URL(Astro.url.pathname, site).href,
  name: `Regenerative Travel Projects in ${countryName}`,
  items: page.data.map((entry) => ({
    name: entry.data.properties.pTitle,
    url: `/projects/${entry.data.properties.pSlug}/`,
  })),
  start: page.start,
  total: page.total,
});

const crumbs = [
  { label: "Home", href: "/" },
  { label: "Projects", href: "/projects/" },
  { label: countryName },
];
const relatedPosts = await findPostsForPlace([countryName]);
---

{/* Page 2+ leaves the index but is still followed, so the paginated tail
    stops competing for rankings without blocking discovery of the listings
    on it. */}
<MainLayout
  title={title}
  description={description}
  robots={page.currentPage > 1 ? "noindex, follow" : undefined}
  schema={schema}
>
  <section class="bg-white dark:bg-gray-900">
    <div class="py-8 px-4 mx-auto max-w-screen-xl sm:py-16 lg:px-6">
      <div class="mb-6">
        <Breadcrumbs crumbs={crumbs} />
      </div>

      <div class="max-w-screen-md mb-8 lg:mb-16">
        <h1  
          class="mb-4 text-4xl tracking-tight font-extrabold text-gray-900 dark:text-white"
        >
          Projects in {countryName}
        </h1>
        <p class="text-gray-500 sm:text-xl dark:text-gray-400">
          A list of projects located in {countryName}.
        </p>
      </div>

      <div class="flex flex-col md:flex-row mb-5">
        <!-- Div 1 (Showing projects) -->
        <div id="1" class="w-full md:w-1/2 p-2 order-3 md:order-1">
          <span class="text-sm font-normal text-gray-500 dark:text-gray-400">
            Showing <span class="font-semibold text-gray-900 dark:text-white">
              {page.start + 1}-{page.end + 1}
            </span> of <span class="font-semibold text-gray-900 dark:text-white">
              {page.total}
            </span> projects
          </span>
        </div>
      
        <!-- Div 2 (Locale Dropdown) -->
        <div id="2" class="w-full md:w-1/4 p-2 order-1 md:order-2">
            <ProjectCountryDropdown />
          </div>
        
          <!-- Div 3 (Country Dropdown) -->
          <div id="3" class="w-full md:w-1/4 p-2 order-2 md:order-3">
            <ProjectLocaleDropdown />
          </div>
      </div>

      <div
        class="space-y-8 md:grid md:grid-cols-2 lg:grid-cols-3 md:gap-12 md:space-y-0"
      >
        {page.data.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white dark:bg-gray-900">
    <div class="py-8 px-4 mx-auto max-w-screen-xl sm:py-16 lg:px-6">
      <Pagination 
        currentPage={page.currentPage}
        lastPage={page.lastPage}
        prevUrl={page.url.prev}
        nextUrl={page.url.next}
        baseUrl={`/projects/${country}`}
      />
    </div>
  </section>

  {page.currentPage === 1 && relatedPosts.length > 0 && (
    <section class="bg-white dark:bg-gray-900">
      <div class="px-4 pb-8 mx-auto max-w-screen-xl sm:pb-16 lg:px-6">
        <h2
          class="mb-6 text-2xl font-bold tracking-tight text-gray-900 dark:text-white"
        >
          Read more about {countryName}
        </h2>
        <ul class="grid gap-6 sm:grid-cols-2">
          {relatedPosts.map((post) => (
            <li>
              <CompactBlogCard
                href={post.href}
                image={post.image}
                title={post.title}
              />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</MainLayout>