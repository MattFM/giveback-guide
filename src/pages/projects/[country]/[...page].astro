---
import { getCollection } from "astro:content";
import MainLayout from "../../../layouts/MainLayout.astro";
import type { GetStaticPathsOptions } from "astro";
import ProjectCard from "../../../components/content/ProjectCard.astro";
import ProjectCountryDropdown from "../../../components/ui/Dropdown/ProjectCountryDropdown.astro";
import ProjectLocaleDropdown from "../../../components/ui/Dropdown/ProjectLocaleDropdown.astro";
import Pagination from "../../../components/ui/Pagination.astro";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  // Fetch all projects once.
  const projects = await getCollection("projects");

  // Bucket each project into every country group it belongs to in a single
  // pass. Avoids re-iterating the full collection once per country.
  const slugify = (s: string) => s.toLowerCase().trim().replace(/\s+/g, "-");
  type Entry = { project: (typeof projects)[number]; date: number };
  const grouped = new Map<string, Entry[]>();

  for (const project of projects) {
    const rawCountries = project.data.properties.pCountry;
    const countries = Array.isArray(rawCountries) ? rawCountries : [rawCountries];
    const date = (project.data.properties.pPublished ?? new Date(0)).getTime();
    for (const country of countries) {
      const countrySlug = slugify(String(country ?? ""));
      if (!countrySlug) continue;
      const list = grouped.get(countrySlug);
      if (list) list.push({ project, date });
      else grouped.set(countrySlug, [{ project, date }]);
    }
  }

  // Sort each country group once and emit paginated paths.
  const paths = [];
  for (const [country, items] of grouped) {
    items.sort((a, b) => b.date - a.date);
    paths.push(
      ...paginate(
        items.map((i) => i.project),
        {
          pageSize: 9,
          params: { country },
          props: { country },
        }
      )
    );
  }

  return paths;
}

const { country } = Astro.params; // Get the current country from the URL
const { page } = Astro.props; // Get the paginated data

// Convert the country slug back to a readable format
const readableCountry = country
  .split("-")
  .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
  .join(" ");
---

<MainLayout title={`Projects in ${readableCountry} - Page ${page.currentPage} of ${page.lastPage}`}>
  <section class="bg-white dark:bg-gray-900">
    <div class="py-8 px-4 mx-auto max-w-screen-xl sm:py-16 lg:px-6">
      <div class="max-w-screen-md mb-8 lg:mb-16">
        <h1  
          class="mb-4 text-4xl tracking-tight font-extrabold text-gray-900 dark:text-white"
        >
          Projects in {readableCountry}
        </h1>
        <p class="text-gray-500 sm:text-xl dark:text-gray-400">
          A list of projects located in {readableCountry}.
        </p>
      </div>

      <div class="flex flex-col md:flex-row mb-5">
        <!-- Div 1 (Showing projects) -->
        <div id="1" class="w-full md:w-1/2 p-2 order-3 md:order-1">
          <span class="text-sm font-normal text-gray-500 dark:text-gray-400">
            Showing <span class="font-semibold text-gray-900 dark:text-white">
              {page.start + 1}-{page.end + 1}
            </span> of <span class="font-semibold text-gray-900 dark:text-white">
              {page.total}
            </span> projects
          </span>
        </div>
      
        <!-- Div 2 (Locale Dropdown) -->
        <div id="2" class="w-full md:w-1/4 p-2 order-1 md:order-2">
            <ProjectCountryDropdown />
          </div>
        
          <!-- Div 3 (Country Dropdown) -->
          <div id="3" class="w-full md:w-1/4 p-2 order-2 md:order-3">
            <ProjectLocaleDropdown />
          </div>
      </div>

      <div
        class="space-y-8 md:grid md:grid-cols-2 lg:grid-cols-3 md:gap-12 md:space-y-0"
      >
        {page.data.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white dark:bg-gray-900">
    <div class="py-8 px-4 mx-auto max-w-screen-xl sm:py-16 lg:px-6">
      <Pagination 
        currentPage={page.currentPage}
        lastPage={page.lastPage}
        prevUrl={page.url.prev}
        nextUrl={page.url.next}
        baseUrl={`/projects/${country}`}
      />
    </div>
  </section>
</MainLayout>