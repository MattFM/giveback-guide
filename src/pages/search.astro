---
import { getCollection } from "astro:content";
import MainLayout from "../layouts/MainLayout.astro";
import { SITE_TITLE } from "../consts";
import Sheet from "../components/bearnie/sheet/Sheet.astro";
import SheetClose from "../components/bearnie/sheet/SheetClose.astro";
import SheetContent from "../components/bearnie/sheet/SheetContent.astro";
import SheetFooter from "../components/bearnie/sheet/SheetFooter.astro";
import SheetHeader from "../components/bearnie/sheet/SheetHeader.astro";
import SheetOverlay from "../components/bearnie/sheet/SheetOverlay.astro";
import SheetTitle from "../components/bearnie/sheet/SheetTitle.astro";
import SheetTrigger from "../components/bearnie/sheet/SheetTrigger.astro";
import Button from "../components/bearnie/button/Button.astro";
import Checkbox from "../components/bearnie/checkbox/Checkbox.astro";
import Field from "../components/bearnie/field/Field.astro";
import FieldLabel from "../components/bearnie/field/FieldLabel.astro";
import Input from "../components/bearnie/input/Input.astro";
import Switch from "../components/bearnie/switch/Switch.astro";
import HugeIcon from "../components/bearnie/icon/HugeIcon.astro";
import { Search01Icon, FilterHorizontalIcon } from "../components/bearnie/icon/icons";
import Breadcrumb from "../components/bearnie/breadcrumb/Breadcrumb.astro";
import BreadcrumbList from "../components/bearnie/breadcrumb/BreadcrumbList.astro";
import BreadcrumbItem from "../components/bearnie/breadcrumb/BreadcrumbItem.astro";
import BreadcrumbLink from "../components/bearnie/breadcrumb/BreadcrumbLink.astro";
import BreadcrumbPage from "../components/bearnie/breadcrumb/BreadcrumbPage.astro";
import BreadcrumbSeparator from "../components/bearnie/breadcrumb/BreadcrumbSeparator.astro";

const projects = await getCollection("projects");
const stays = await getCollection("stays");

const allPTypes = [...new Set(
  projects.flatMap((p) =>
    Array.isArray(p.data.properties.pTypesNames)
      ? p.data.properties.pTypesNames
      : [p.data.properties.pTypesNames]
  ).filter(Boolean)
)].sort();

const allSTypes = [...new Set(
  stays.flatMap((s) =>
    Array.isArray(s.data.properties.sType)
      ? s.data.properties.sType
      : [s.data.properties.sType]
  ).filter(Boolean)
)].sort();

const allSFacilities = [...new Set(
  stays.flatMap((s) =>
    Array.isArray(s.data.properties.sFacilities)
      ? s.data.properties.sFacilities
      : [s.data.properties.sFacilities]
  ).filter(Boolean)
)].sort();
---

<MainLayout title={`Search ${SITE_TITLE}`}>
  <main>
    <section class="bg-white dark:bg-gray-900">
      <div class="py-8 px-4 mx-auto max-w-screen-xl sm:py-16 lg:px-6">
        <Breadcrumb class="mb-3">
          <BreadcrumbList>
            <BreadcrumbItem>
              <BreadcrumbLink href="/">Home</BreadcrumbLink>
              <BreadcrumbSeparator />
            </BreadcrumbItem>
            <BreadcrumbItem>
              <BreadcrumbPage>Search</BreadcrumbPage>
            </BreadcrumbItem>
          </BreadcrumbList>
        </Breadcrumb>

        <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-4">Search</h1>

        <!-- Search toolbar (search input + Filters button) and status text -->
        <Sheet>
          <div class="flex flex-col md:flex-row md:items-center gap-2 max-w-screen-xl mx-auto mb-2">
            <Field class="flex-1 min-w-0">
              <FieldLabel class="sr-only">Search</FieldLabel>

              <form class="flex w-full items-center gap-2" action="/search" method="get">
                <div class="relative flex-1 min-w-0">
                  <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                    <HugeIcon icon={Search01Icon} class="h-4 w-4 text-muted-foreground" />
                  </span>
                  <Input
                    type="search"
                    id="search-input"
                    name="q"
                    class="h-10 pl-10 pr-12 w-full"
                    placeholder="Search for projects, posts, or stays..."
                    autocomplete="off"
                  />
                  <button
                    type="button"
                    id="clear-search"
                    class="absolute inset-y-0 right-0 flex items-center pr-3 text-sm font-medium text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 cursor-pointer hidden"
                    aria-label="Clear search"
                  >
                    Clear
                  </button>
                </div>

                <Button
                  id="search-submit-btn"
                  type="submit"
                  variant="default"
                  size="lg"
                  class="hidden md:inline-flex"
                >
                  Search
                </Button>
              </form>
            </Field>

            <SheetTrigger>
              <Button
                id="filters-btn"
                variant="outline"
                size="lg"
                class="w-full md:w-auto"
              >
                <HugeIcon icon={FilterHorizontalIcon} slot="left-icon" class="h-4 w-4" />
                Filters
                <span id="total-filter-count" class="hidden ml-2 px-2 py-0.5 text-xs font-semibold rounded-full bg-primary text-primary-foreground"></span>
              </Button>
            </SheetTrigger>
          </div>

          <div id="filters-and-status" class="hidden max-w-screen-xl mx-auto mb-6">
            <p id="status-text" class="text-sm font-normal text-gray-500 dark:text-gray-400">Enter a search term to get started</p>
          </div>

              <SheetOverlay />
              <SheetContent side="right" class="flex flex-col">
                <SheetHeader>
                  <SheetTitle id="filters-modal-title">Filters</SheetTitle>
                </SheetHeader>

                <div class="flex-1 overflow-y-auto">
                  
                  <!-- Content Type Filters -->
                  <div class="mb-8">
                    <h4 class="text-base font-bold text-gray-900 dark:text-white mb-3">Content Type</h4>
                    <div class="flex flex-wrap gap-2">
                      <Button 
                        variant="default"
                        size="sm"
                        id="modal-filter-all"
                        data-filter="all"
                        data-active="true"
                      >
                        All <span id="modal-count-all" class="ml-1 opacity-75"></span>
                      </Button>
                      <Button 
                        variant="outline"
                        size="sm"
                        id="modal-filter-projects"
                        data-filter="projects"
                        data-active="false"
                      >
                        Projects <span id="modal-count-projects" class="ml-1 opacity-75"></span>
                      </Button>
                      <Button 
                        variant="outline"
                        size="sm"
                        id="modal-filter-stays"
                        data-filter="stays"
                        data-active="false"
                      >
                        Stays <span id="modal-count-stays" class="ml-1 opacity-75"></span>
                      </Button>
                      <Button 
                        variant="outline"
                        size="sm"
                        id="modal-filter-posts"
                        data-filter="posts"
                        data-active="false"
                      >
                        Blog Posts <span id="modal-count-posts" class="ml-1 opacity-75"></span>
                      </Button>
                    </div>
                  </div>

                  <!-- Verified -->
                  <div class="mb-6">
                    <h4 class="text-base font-bold text-gray-900 dark:text-white mb-3">Verified</h4>
                    <div class="flex items-center gap-3">
                      <Switch id="verified-filter" />
                      <label for="verified-filter" class="text-sm text-gray-700 dark:text-gray-300">Show verified listings only</label>
                    </div>
                  </div>

                  <!-- Impact Areas Filters -->
                  <div>
                    <h4 class="text-base font-bold text-gray-900 dark:text-white mb-2">Impact Areas</h4>
                    <p class="text-xs text-gray-500 dark:text-gray-400 mb-4">
                      Filter Projects and Stays by their impact focus.
                    </p>
            
                    <!-- Environmental & Conservation -->
                    <div class="mb-4">
                      <button 
                        type="button" 
                        class="impact-category-toggle flex items-center justify-between w-full text-left text-xs font-semibold text-gray-700 dark:text-gray-300 mb-2 hover:text-gray-900 dark:hover:text-gray-100 cursor-pointer"
                        data-category="environmental"
                      >
                        <span>Environmental & Conservation</span>
                        <svg class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                      </button>
                      <div class="impact-category-content hidden space-y-2 pl-4" data-category="environmental">
                        <label class="flex items-center cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700 p-1 rounded">
                          <Checkbox class="impact-area-checkbox" data-impact="Animal Welfare" />
                          <span class="ml-2 text-sm text-gray-700 dark:text-gray-300">Animal Welfare</span>
                        </label>
                        <label class="flex items-center cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700 p-1 rounded">
                          <Checkbox class="impact-area-checkbox" data-impact="Wildlife Rehabilitation" />
                          <span class="ml-2 text-sm text-gray-700 dark:text-gray-300">Wildlife Rehabilitation</span>
                        </label>
                        <label class="flex items-center cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700 p-1 rounded">
                          <Checkbox class="impact-area-checkbox" data-impact="Sustainable Food Systems" />
                          <span class="ml-2 text-sm text-gray-700 dark:text-gray-300">Sustainable Food Systems</span>
                        </label>
                        <label class="flex items-center cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700 p-1 rounded">
                          <Checkbox class="impact-area-checkbox" data-impact="Waste and Litter Reduction" />
                          <span class="ml-2 text-sm text-gray-700 dark:text-gray-300">Waste and Litter Reduction</span>
                        </label>
                        <label class="flex items-center cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700 p-1 rounded">
                          <Checkbox class="impact-area-checkbox" data-impact="Marine Protection" />
                          <span class="ml-2 text-sm text-gray-700 dark:text-gray-300">Marine Protection</span>
                        </label>
                        <label class="flex items-center cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700 p-1 rounded">
                          <Checkbox class="impact-area-checkbox" data-impact="River Health" />
                          <span class="ml-2 text-sm text-gray-700 dark:text-gray-300">River Health</span>
                        </label>
                        <label class="flex items-center cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700 p-1 rounded">
                          <Checkbox class="impact-area-checkbox" data-impact="Reforestation" />
                          <span class="ml-2 text-sm text-gray-700 dark:text-gray-300">Reforestation</span>
                        </label>
                        <label class="flex items-center cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700 p-1 rounded">
                          <Checkbox class="impact-area-checkbox" data-impact="Habitat Restoration" />
                          <span class="ml-2 text-sm text-gray-700 dark:text-gray-300">Habitat Restoration</span>
                        </label>
                      </div>
                    </div>
                    
                    <!-- Social Justice & Inclusion -->
                    <div class="mb-4">
                      <button 
                        type="button" 
                        class="impact-category-toggle flex items-center justify-between w-full text-left text-xs font-semibold text-gray-700 dark:text-gray-300 mb-2 hover:text-gray-900 dark:hover:text-gray-100 cursor-pointer"
                        data-category="social"
                      >
                        <span>Social Justice & Inclusion</span>
                        <svg class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                      </button>
                      <div class="impact-category-content hidden space-y-2 pl-4" data-category="social">
                        <label class="flex items-center cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700 p-1 rounded">
                          <Checkbox class="impact-area-checkbox" data-impact="Women's Empowerment" />
                          <span class="ml-2 text-sm text-gray-700 dark:text-gray-300">Women's Empowerment</span>
                        </label>
                        <label class="flex items-center cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700 p-1 rounded">
                          <Checkbox class="impact-area-checkbox" data-impact="LGBTQ+ Inclusion" />
                          <span class="ml-2 text-sm text-gray-700 dark:text-gray-300">LGBTQ+ Inclusion</span>
                        </label>
                        <label class="flex items-center cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700 p-1 rounded">
                          <Checkbox class="impact-area-checkbox" data-impact="Disability Inclusion and Empowerment" />
                          <span class="ml-2 text-sm text-gray-700 dark:text-gray-300">Disability Inclusion and Empowerment</span>
                        </label>
                        <label class="flex items-center cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700 p-1 rounded">
                          <Checkbox class="impact-area-checkbox" data-impact="Refugee and Migrant Inclusion" />
                          <span class="ml-2 text-sm text-gray-700 dark:text-gray-300">Refugee and Migrant Inclusion</span>
                        </label>
                        <label class="flex items-center cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700 p-1 rounded">
                          <Checkbox class="impact-area-checkbox" data-impact="Minority Heritage and Empowerment" />
                          <span class="ml-2 text-sm text-gray-700 dark:text-gray-300">Minority Heritage and Empowerment</span>
                        </label>
                      </div>
                    </div>
                    
                    <!-- Community & Development -->
                    <div class="mb-4">
                      <button 
                        type="button" 
                        class="impact-category-toggle flex items-center justify-between w-full text-left text-xs font-semibold text-gray-700 dark:text-gray-300 mb-2 hover:text-gray-900 dark:hover:text-gray-100 cursor-pointer"
                        data-category="community"
                      >
                        <span>Community & Development</span>
                        <svg class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                      </button>
                      <div class="impact-category-content hidden space-y-2 pl-4" data-category="community">
                        <label class="flex items-center cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700 p-1 rounded">
                          <Checkbox class="impact-area-checkbox" data-impact="Youth Development" />
                          <span class="ml-2 text-sm text-gray-700 dark:text-gray-300">Youth Development</span>
                        </label>
                        <label class="flex items-center cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700 p-1 rounded">
                          <Checkbox class="impact-area-checkbox" data-impact="Education and Skills Training" />
                          <span class="ml-2 text-sm text-gray-700 dark:text-gray-300">Education and Skills Training</span>
                        </label>
                        <label class="flex items-center cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700 p-1 rounded">
                          <Checkbox class="impact-area-checkbox" data-impact="Community Development" />
                          <span class="ml-2 text-sm text-gray-700 dark:text-gray-300">Community Development</span>
                        </label>
                        <label class="flex items-center cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700 p-1 rounded">
                          <Checkbox class="impact-area-checkbox" data-impact="Poverty Alleviation" />
                          <span class="ml-2 text-sm text-gray-700 dark:text-gray-300">Poverty Alleviation</span>
                        </label>
                        <label class="flex items-center cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700 p-1 rounded">
                          <Checkbox class="impact-area-checkbox" data-impact="Homelessness Support" />
                          <span class="ml-2 text-sm text-gray-700 dark:text-gray-300">Homelessness Support</span>
                        </label>
                        <label class="flex items-center cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700 p-1 rounded">
                          <Checkbox class="impact-area-checkbox" data-impact="Cultural Heritage Preservation" />
                          <span class="ml-2 text-sm text-gray-700 dark:text-gray-300">Cultural Heritage Preservation</span>
                        </label>
                      </div>
                    </div>
                  </div>

                  <!-- Type-specific filter info message -->
                  <div id="type-filter-info" class="hidden mb-6">
                    <div class="flex items-start gap-3 p-3 rounded-lg bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700">
                      <svg class="w-5 h-5 mt-0.5 text-gray-500 dark:text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                      </svg>
                      <p class="text-sm text-gray-600 dark:text-gray-300">Select <strong>Projects</strong> or <strong>Stays</strong> above to see type-specific filters (Project Type / Stay Type / Facilities).</p>
                    </div>
                  </div>

                  <!-- Project Type -->
                  <div id="project-type-section" class="mb-6 hidden">
                    <h4 class="text-base font-bold text-gray-900 dark:text-white mb-3">Project Type</h4>
                    <div class="space-y-2 pl-1">
                      {allPTypes.map((type) => (
                        <label class="flex items-center gap-2 cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700 p-1 rounded">
                          <Checkbox class="ptype-checkbox h-4 w-4" data-ptype={type} />
                          <span class="text-sm text-gray-700 dark:text-gray-300">{type}</span>
                        </label>
                      ))}
                    </div>
                  </div>

                  <!-- Stay Type -->
                  <div id="stay-type-section" class="mb-6 hidden">
                    <h4 class="text-base font-bold text-gray-900 dark:text-white mb-3">Stay Type</h4>
                    <div class="space-y-2 pl-1">
                      {allSTypes.map((type) => (
                        <label class="flex items-center gap-2 cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700 p-1 rounded">
                          <Checkbox class="stype-checkbox h-4 w-4" data-stype={type} />
                          <span class="text-sm text-gray-700 dark:text-gray-300">{type}</span>
                        </label>
                      ))}
                    </div>
                  </div>

                  <!-- Facilities -->
                  <div id="facilities-section" class="mb-6 hidden">
                    <h4 class="text-base font-bold text-gray-900 dark:text-white mb-3">Facilities</h4>
                    <div class="space-y-2 pl-1">
                      {allSFacilities.map((facility) => (
                        <label class="flex items-center gap-2 cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700 p-1 rounded">
                          <Checkbox class="facility-checkbox h-4 w-4" data-facility={facility} />
                          <span class="text-sm text-gray-700 dark:text-gray-300">{facility}</span>
                        </label>
                      ))}
                    </div>
                  </div>
                </div>

                <SheetFooter>
                  <SheetClose>
                    <Button id="apply-filters-btn">Apply Filters</Button>
                  </SheetClose>
                  <Button id="clear-all-filters-btn" variant="outline">Clear All</Button>
                </SheetFooter>
              </SheetContent>
            </Sheet>

        <!-- Search Results -->
        <div id="search-results" class="space-y-8 md:grid md:grid-cols-2 lg:grid-cols-3 md:gap-12 md:space-y-0">
          <!-- Results will be populated here -->
        </div>

        <!-- No Results Section -->
        <div id="no-results" class="hidden text-center py-12">
          <div class="max-w-md mx-auto">
            <svg class="w-16 h-16 mx-auto mb-4 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
            <h3 class="mb-2 text-xl font-semibold text-gray-900 dark:text-white">No results found</h3>
            <p id="no-results-query" class="mb-6 text-gray-500 dark:text-gray-400">We couldn't find anything for your search.</p>
            
            <!-- Additional instructions section -->
            <div id="no-results-instructions" class="space-y-4">
              <div class="p-4 bg-gray-50 dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
                <p class="text-sm text-gray-700 dark:text-gray-300 mb-3">
                  Can't find what you're looking for? Submit a project to our database!
                </p>
                <a 
                  href="/submit" 
                  class="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-gray-900 border border-transparent rounded-lg hover:bg-black focus:ring-4 focus:outline-none focus:ring-gray-300 dark:bg-gray-700 dark:hover:bg-gray-600 dark:focus:ring-gray-600"
                >
                  Submit a project
                  <svg class="w-4 h-4 ml-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Load More Button -->
        <div id="load-more-container" class="hidden text-center mt-8">
          <button 
            id="load-more-btn" 
            type="button"
            class="inline-flex items-center px-6 py-3 text-sm font-medium text-gray-900 bg-white border border-gray-300 rounded-lg hover:bg-gray-100 focus:ring-4 focus:outline-none focus:ring-gray-200 dark:bg-gray-800 dark:text-white dark:border-gray-600 dark:hover:bg-gray-700 dark:focus:ring-gray-700 cursor-pointer"
          >
            Load More Results
            <svg class="w-4 h-4 ml-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19V5m0 14l-4-4m4 4 4-4"/>
            </svg>
          </button>
        </div>

        <!-- Loading indicator -->
        <div id="loading" class="hidden text-center py-8">
          <div role="status">
            <svg aria-hidden="true" class="inline w-8 h-8 text-gray-200 animate-spin dark:text-gray-600 fill-blue-600" viewBox="0 0 100 101" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M100 50.5908C100 78.2051 77.6142 100.591 50 100.591C22.3858 100.591 0 78.2051 0 50.5908C0 22.9766 22.3858 0.59082 50 0.59082C77.6142 0.59082 100 22.9766 100 50.5908ZM9.08144 50.5908C9.08144 73.1895 27.4013 91.5094 50 91.5094C72.5987 91.5094 90.9186 73.1895 90.9186 50.5908C90.9186 27.9921 72.5987 9.67226 50 9.67226C27.4013 9.67226 9.08144 27.9921 9.08144 50.5908Z" fill="currentColor"/>
              <path d="M93.9676 39.0409C96.393 38.4038 97.8624 35.9116 97.0079 33.5539C95.2932 28.8227 92.871 24.3692 89.8167 20.348C85.8452 15.1192 80.8826 10.7238 75.2124 7.41289C69.5422 4.10194 63.2754 1.94025 56.7698 1.05124C51.7666 0.367541 46.6976 0.446843 41.7345 1.27873C39.2613 1.69328 37.813 4.19778 38.4501 6.62326C39.0873 9.04874 41.5694 10.4717 44.0505 10.1071C47.8511 9.54855 51.7191 9.52689 55.5402 10.0491C60.8642 10.7766 65.9928 12.5457 70.6331 15.2552C75.2735 17.9648 79.3347 21.5619 82.5849 25.841C84.9175 28.9121 86.7997 32.2913 88.1811 35.8758C89.083 38.2158 91.5421 39.6781 93.9676 39.0409Z" fill="currentFill"/>
            </svg>
            <span class="sr-only">Loading...</span>
          </div>
          <p class="mt-2 text-gray-500 dark:text-gray-400">Searching...</p>
        </div>
      </div>
    </section>
  </main>
</MainLayout>

<script>
  // Known canonical country names for display filtering
  const CANONICAL_COUNTRIES = new Set([
    "New Zealand", "Canada", "Scotland", "Wales", "Australia", 
    "United Kingdom", "UK", "England", "Northern Ireland",
    "USA", "United States", "Türkiye",
    // Add other countries as needed - this filters out aliases from display
  ]);

  const CONTENT_TYPE_FILTERS: Record<string, string> = {
    projects: 'project',
    stays: 'stay',
    posts: 'post',
  };

  let pagefind: any = null;
  let currentQuery = '';
  let allResults: any[] = [];
  let activeFilters = new Set(['all']);
  let activeImpactAreas = new Set<string>();
  let activeVerified = false;
  let activePTypes = new Set<string>();
  let activeSTypes = new Set<string>();
  let activeSFacilities = new Set<string>();
  let displayedResults = 0;
  const resultsPerPage = 12;
  let isInitialized = false;

  async function initSearch() {
    // Reset state on each init to handle back/forward navigation
    if (isInitialized) {
      console.log('Re-initializing search after navigation');
      currentQuery = '';
      allResults = [];
      activeFilters = new Set(['all']);
      activeImpactAreas = new Set<string>();
      activeVerified = false;
      activePTypes = new Set<string>();
      activeSTypes = new Set<string>();
      activeSFacilities = new Set<string>();
      displayedResults = 0;
      // Refresh filter count so the badge doesn't carry stale text from before navigation
      updateTotalFilterCount();
    }
    isInitialized = true;
    const searchInput = document.getElementById("search-input") as HTMLInputElement;
    const searchResults = document.getElementById("search-results");
    const statusText = document.getElementById("status-text");
    const loading = document.getElementById("loading");
    const loadMoreContainer = document.getElementById("load-more-container");
    const loadMoreBtn = document.getElementById("load-more-btn");
    const searchForm = searchInput?.closest("form");
    const filtersAndStatus = document.getElementById("filters-and-status");
    const clearButton = document.getElementById("clear-search");
    const noResults = document.getElementById("no-results");
    const noResultsQuery = document.getElementById("no-results-query");
    
    // Modal elements removed - Sheet component handles open/close state
    const totalFilterCount = document.getElementById("total-filter-count");
    const clearAllFiltersBtn = document.getElementById("clear-all-filters-btn");
    
    // Filter elements
    const modalContentFilterButtons = document.querySelectorAll('[data-filter]') as NodeListOf<HTMLButtonElement>;
    const impactAreaCheckboxes = document.querySelectorAll('.impact-area-checkbox');
    const categoryToggles = document.querySelectorAll('.impact-category-toggle');

    // Initialize Pagefind (works in dev mode if search index exists)
    try {
      // Use Function constructor to create truly dynamic import that Vite won't analyze
      const importPath = "/pagefind/pagefind.js";
      const dynamicImport = new Function('path', 'return import(path)');
      const pagefindModule = await dynamicImport(importPath);
      pagefind = pagefindModule;
      await pagefind.init();
      console.log("Pagefind initialized successfully");
    } catch (error) {
      console.error("Failed to initialize Pagefind:", error);
      const isDev = import.meta.env.DEV;
      if (isDev) {
        showStatus("Search requires a built index. Run 'npm run build' first, then restart dev server to use search in development.");
        showFiltersAndStatus();
      } else {
        showStatus("Search is currently unavailable. Make sure your site has been built with Pagefind enabled.");
        showFiltersAndStatus();
      }
      return;
    }

    // Get search query from URL
    const urlParams = new URLSearchParams(window.location.search);
    const initialQuery = urlParams.get('q');
    const initialFilters = urlParams.get('filters');
    const initialImpacts = urlParams.get('impacts');
    const initialVerified = urlParams.get('verified') === 'true';
    const initialPTypes = urlParams.get('pType');
    const initialSTypes = urlParams.get('sType');
    const initialSFacilities = urlParams.get('sFacilities');

    // Initialize filters from URL if present
    if (initialFilters) {
      const filterArray = initialFilters.split(',').filter(f => f.length > 0);
      if (filterArray.length > 0) {
        activeFilters.clear();
        filterArray.forEach(filter => activeFilters.add(filter));
        // Sync buttons with active filters
        updateModalFilterButtons();
        updateTotalFilterCount();
      }
    }

    // Initialize impact areas from URL if present
    if (initialImpacts) {
      const impactArray = initialImpacts.split(',').filter(i => i.length > 0);
      if (impactArray.length > 0) {
        impactArray.forEach(impact => activeImpactAreas.add(impact));
        // Check the corresponding checkboxes
        impactAreaCheckboxes.forEach(checkbox => {
          const impactArea = (checkbox as HTMLInputElement).getAttribute('data-impact');
          if (impactArea && activeImpactAreas.has(impactArea)) {
            (checkbox as HTMLInputElement).checked = true;
          }
        });
        updateTotalFilterCount();
      }
    }

    // Initialize verified switch from URL if present
    if (initialVerified) {
      activeVerified = true;
      const verifiedSwitch = document.getElementById('verified-filter');
      if (verifiedSwitch) {
        verifiedSwitch.setAttribute('aria-checked', 'true');
        verifiedSwitch.setAttribute('data-state', 'checked');
        const thumb = verifiedSwitch.querySelector('span');
        if (thumb) thumb.setAttribute('data-state', 'checked');
      }
      updateTotalFilterCount();
    }

    // Initialize pType checkboxes from URL if present
    if (initialPTypes) {
      const pTypeArray = initialPTypes.split(',').filter(t => t.length > 0);
      if (pTypeArray.length > 0) {
        pTypeArray.forEach(t => activePTypes.add(t));
        document.querySelectorAll('.ptype-checkbox').forEach((cb) => {
          const input = cb as HTMLInputElement;
          const pType = input.getAttribute('data-ptype');
          if (pType && activePTypes.has(pType)) input.checked = true;
        });
        updateTotalFilterCount();
      }
    }

    // Initialize sType checkboxes from URL if present
    if (initialSTypes) {
      const sTypeArray = initialSTypes.split(',').filter(t => t.length > 0);
      if (sTypeArray.length > 0) {
        sTypeArray.forEach(t => activeSTypes.add(t));
        document.querySelectorAll('.stype-checkbox').forEach((cb) => {
          const input = cb as HTMLInputElement;
          const sType = input.getAttribute('data-stype');
          if (sType && activeSTypes.has(sType)) input.checked = true;
        });
        updateTotalFilterCount();
      }
    }

    // Initialize facility checkboxes from URL if present
    if (initialSFacilities) {
      const sFacilitiesArray = initialSFacilities.split(',').filter(t => t.length > 0);
      if (sFacilitiesArray.length > 0) {
        sFacilitiesArray.forEach(t => activeSFacilities.add(t));
        document.querySelectorAll('.facility-checkbox').forEach((cb) => {
          const input = cb as HTMLInputElement;
          const facility = input.getAttribute('data-facility');
          if (facility && activeSFacilities.has(facility)) input.checked = true;
        });
        updateTotalFilterCount();
      }
    }

    // Refresh filter section visibility based on initial state
    updateFilterSections();
    
    if (initialQuery && searchInput) {
      searchInput.value = initialQuery;
      // Show clear button if there's an initial query
      if (clearButton && initialQuery.trim().length > 0) {
        clearButton.classList.remove("hidden");
      }
      performSearch(initialQuery);
    } else {
      // Don't show status initially - keep filters and status hidden
      hideFiltersAndStatus();
    }

    // Handle form submission
    if (searchForm) {
      searchForm.addEventListener("submit", (e) => {
        e.preventDefault();
        const query = searchInput?.value?.trim();
        if (query) {
          // Hide virtual keyboard on mobile after search
          if (searchInput) {
            searchInput.blur();
          }
          updateURL(query);
          performSearch(query);
        }
      });
    }

    // Handle input changes - show/hide clear button and clear results when empty
    if (searchInput) {
      searchInput.addEventListener("input", (e) => {
        const target = e.target as HTMLInputElement;
        const query = target?.value?.trim() || '';
        
        // Show/hide clear button based on input content
        if (clearButton) {
          if (query.length > 0) {
            clearButton.classList.remove("hidden");
          } else {
            clearButton.classList.add("hidden");
          }
        }
        
        if (query.length === 0) {
          clearResults();
          hideFiltersAndStatus();
          currentQuery = ''; // Clear current query when input is empty
          updateURL("");
          return;
        }
      });
    }

    // Handle clear button click
    if (clearButton) {
      clearButton.addEventListener("click", () => {
        if (searchInput) {
          searchInput.value = '';
          searchInput.focus(); // Keep focus on input for better UX
          clearButton.classList.add("hidden");
          clearResults();
          hideFiltersAndStatus();
          currentQuery = '';
          updateURL("");
        }
      });
    }

    // Setup content type filter buttons (Sheet handles open/close automatically)
    modalContentFilterButtons.forEach(button => {
      button.addEventListener('click', () => {
        const filter = button.getAttribute('data-filter');
        if (!filter) return;
        
        const isActive = button.getAttribute('data-active') === 'true';
        
        if (filter === 'all') {
          // If "All" is clicked, clear other filters and activate only "All"
          activeFilters.clear();
          activeFilters.add('all');
          updateModalFilterButtons();
        } else {
          // Remove "All" if it's active
          if (activeFilters.has('all')) {
            activeFilters.delete('all');
          }
          
          // Toggle the specific filter
          if (isActive) {
            activeFilters.delete(filter);
          } else {
            activeFilters.add(filter);
          }
          
          // If no filters are active, activate "All"
          if (activeFilters.size === 0) {
            activeFilters.add('all');
          }
          
          updateModalFilterButtons();
        }

        updateTotalFilterCount();
        updateFilterSections();
      });
    });

    // Update modal filter button states
    function updateModalFilterButtons() {
      modalContentFilterButtons.forEach(button => {
        const filter = button.getAttribute('data-filter');
        if (!filter) return;

        const isActive = activeFilters.has(filter);
        button.setAttribute('data-active', isActive.toString());

        if (isActive) {
          // Active state: default variant styling
          button.classList.remove('bg-background', 'text-foreground', 'border', 'border-input', 'hover:bg-accent', 'hover:text-accent-foreground');
          button.classList.add('bg-primary', 'text-primary-foreground', 'hover:bg-primary/90');
        } else {
          // Inactive state: outline variant styling
          button.classList.remove('bg-primary', 'text-primary-foreground', 'hover:bg-primary/90');
          button.classList.add('bg-background', 'text-foreground', 'border', 'border-input', 'hover:bg-accent', 'hover:text-accent-foreground');
        }
      });
    }

    // Show / hide type-specific filter sections based on the active content type selection
    function updateFilterSections() {
      const projectTypeSection = document.getElementById('project-type-section');
      const stayTypeSection = document.getElementById('stay-type-section');
      const facilitiesSection = document.getElementById('facilities-section');
      const typeFilterInfo = document.getElementById('type-filter-info');

      const isProjectsOnly = activeFilters.size === 1 && activeFilters.has('projects');
      const isStaysOnly = activeFilters.size === 1 && activeFilters.has('stays');

      if (typeFilterInfo) {
        typeFilterInfo.classList.toggle('hidden', isProjectsOnly || isStaysOnly);
      }
      if (projectTypeSection) {
        projectTypeSection.classList.toggle('hidden', !isProjectsOnly);
      }
      if (stayTypeSection) {
        stayTypeSection.classList.toggle('hidden', !isStaysOnly);
      }
      if (facilitiesSection) {
        facilitiesSection.classList.toggle('hidden', !isStaysOnly);
      }
    }

    // Apply filters button (SheetClose handles closing, we just apply)
    const applyFiltersBtn = document.getElementById("apply-filters-btn");
    if (applyFiltersBtn) {
      applyFiltersBtn.addEventListener('click', () => {
        updateURL(currentQuery);
        // Filters apply to Pagefind - re-run the search with current state so the client-side state
        // matches the URL. performSearch handles an empty query (renders no results cleanly).
        performSearch(currentQuery);
      });
    }

    // Clear all filters button
    if (clearAllFiltersBtn) {
      clearAllFiltersBtn.addEventListener('click', () => {
        // Clear content type filters
        activeFilters.clear();
        activeFilters.add('all'); // Reset to "All"
        updateModalFilterButtons();

        // Clear impact area filters
        activeImpactAreas.clear();
        impactAreaCheckboxes.forEach(checkbox => {
          (checkbox as HTMLInputElement).checked = false;
        });

        // Clear verified toggle
        activeVerified = false;
        const verifiedSwitchEl = document.getElementById('verified-filter');
        if (verifiedSwitchEl) {
          verifiedSwitchEl.setAttribute('aria-checked', 'false');
          verifiedSwitchEl.setAttribute('data-state', 'unchecked');
          const thumb = verifiedSwitchEl.querySelector('span');
          if (thumb) thumb.setAttribute('data-state', 'unchecked');
        }

        // Clear pType checkboxes
        activePTypes.clear();
        document.querySelectorAll('.ptype-checkbox').forEach((checkbox) => {
          (checkbox as HTMLInputElement).checked = false;
        });

        // Clear sType checkboxes
        activeSTypes.clear();
        document.querySelectorAll('.stype-checkbox').forEach((checkbox) => {
          (checkbox as HTMLInputElement).checked = false;
        });

        // Clear facility checkboxes
        activeSFacilities.clear();
        document.querySelectorAll('.facility-checkbox').forEach((checkbox) => {
          (checkbox as HTMLInputElement).checked = false;
        });

        updateFilterSections();
        updateTotalFilterCount();
        updateURL(currentQuery);
        performSearch(currentQuery);
      });
    }

    // Setup load more button
    if (loadMoreBtn) {
      loadMoreBtn.addEventListener('click', loadMoreResults);
    }

    // Track URL changes for browser navigation
    window.addEventListener('popstate', () => {
      // No-op: navigation handling removed
    });

    // Setup category toggles (collapsible sections)
    categoryToggles.forEach(toggle => {
      toggle.addEventListener('click', () => {
        const category = toggle.getAttribute('data-category');
        const content = document.querySelector(`.impact-category-content[data-category="${category}"]`);
        const icon = toggle.querySelector('svg');

        if (content && icon) {
          const isHidden = content.classList.contains('hidden');
          content.classList.toggle('hidden');
          icon.style.transform = isHidden ? 'rotate(180deg)' : 'rotate(0deg)';
        }
      });
    });

    // Setup impact area checkboxes
    impactAreaCheckboxes.forEach(checkbox => {
      checkbox.addEventListener('change', (e) => {
        const target = e.target as HTMLInputElement;
        const impactArea = target.getAttribute('data-impact');

        if (!impactArea) return;

        if (target.checked) {
          activeImpactAreas.add(impactArea);
        } else {
          activeImpactAreas.delete(impactArea);
        }

        updateTotalFilterCount();
      });
    });

    // Setup verified switch
    const verifiedSwitch = document.getElementById('verified-filter');
    if (verifiedSwitch) {
      verifiedSwitch.addEventListener('change', (e) => {
        const customEvent = e as CustomEvent<{ checked: boolean }>;
        activeVerified = customEvent.detail.checked;
        updateTotalFilterCount();
      });
    }

    // Setup project type checkboxes
    document.querySelectorAll('.ptype-checkbox').forEach((checkbox) => {
      checkbox.addEventListener('change', (e) => {
        const target = e.target as HTMLInputElement;
        const pType = target.getAttribute('data-ptype');

        if (!pType) return;

        if (target.checked) {
          activePTypes.add(pType);
        } else {
          activePTypes.delete(pType);
        }

        updateTotalFilterCount();
      });
    });

    // Setup stay type checkboxes
    document.querySelectorAll('.stype-checkbox').forEach((checkbox) => {
      checkbox.addEventListener('change', (e) => {
        const target = e.target as HTMLInputElement;
        const sType = target.getAttribute('data-stype');

        if (!sType) return;

        if (target.checked) {
          activeSTypes.add(sType);
        } else {
          activeSTypes.delete(sType);
        }

        updateTotalFilterCount();
      });
    });

    // Setup facility checkboxes
    document.querySelectorAll('.facility-checkbox').forEach((checkbox) => {
      checkbox.addEventListener('change', (e) => {
        const target = e.target as HTMLInputElement;
        const facility = target.getAttribute('data-facility');

        if (!facility) return;

        if (target.checked) {
          activeSFacilities.add(facility);
        } else {
          activeSFacilities.delete(facility);
        }

        updateTotalFilterCount();
      });
    });

    // Update total filter count badge
    function updateTotalFilterCount() {
      if (!totalFilterCount) return;

      const contentTypeCount = activeFilters.has('all') ? 0 : activeFilters.size;
      const impactCount = activeImpactAreas.size;
      const verifiedCount = activeVerified ? 1 : 0;
      const pTypeCount = activePTypes.size;
      const sTypeCount = activeSTypes.size;
      const sFacilitiesCount = activeSFacilities.size;
      const total = contentTypeCount + impactCount + verifiedCount + pTypeCount + sTypeCount + sFacilitiesCount;

      // Always keep textContent in sync so the badge never carries a stale number.
      totalFilterCount.textContent = total > 0 ? total.toString() : '';

      // Toggle exactly one of `hidden` / `inline-flex` to avoid the Tailwind source-order conflict
      // where `inline-flex` (later in the utilities cascade) overrides `hidden`.
      totalFilterCount.classList.toggle('hidden', total === 0);
      totalFilterCount.classList.toggle('inline-flex', total > 0);
      totalFilterCount.classList.toggle('items-center', total > 0);
      totalFilterCount.classList.toggle('justify-center', total > 0);
    }

    function handleFilterClick(event: Event) {
      const button = event.currentTarget as HTMLButtonElement;
      const filterType = button.getAttribute('data-filter');
      
      if (!filterType || button.disabled) return; // Don't process clicks on disabled buttons

      const previousFilters = new Set(activeFilters);

      if (filterType === 'all') {
        // If "All" is clicked, clear other filters and activate only "All"
        activeFilters.clear();
        activeFilters.add('all');
        updateFilterButtons();
      } else {
        // Remove "All" if it's active and this is a specific filter
        if (activeFilters.has('all')) {
          activeFilters.delete('all');
        }
        
        // Toggle the specific filter
        if (activeFilters.has(filterType)) {
          activeFilters.delete(filterType);
        } else {
          activeFilters.add(filterType);
        }

        // If no filters are active, activate "All"
        if (activeFilters.size === 0) {
          activeFilters.add('all');
        }

        updateFilterButtons();
      }

      // Update URL with current query and filters
      updateURL(currentQuery);

      // Re-filter and display current results
      if (allResults.length > 0) {
        displayFilteredResults();
      }
    }

    function updateFilterButtons() {
      // Update all filter buttons with a single loop
      const allButtons = document.querySelectorAll('[data-filter]') as NodeListOf<HTMLButtonElement>;
      allButtons.forEach(button => {
        const filterType = button.getAttribute('data-filter');
        const isActive = activeFilters.has(filterType || '');
        
        // Check if this filter type has results
        let hasResults = true;
        if (filterType !== 'all') {
          if (allResults.length === 0) {
            hasResults = false; // No results at all
          } else {
            hasResults = allResults.some(result => result.contentType === filterType);
          }
        }
        
        if (isActive) {
          // Active state: default variant styling
          button.classList.remove('bg-background', 'text-foreground', 'border', 'border-input', 'hover:bg-accent', 'hover:text-accent-foreground');
          button.classList.add('bg-primary', 'text-primary-foreground', 'hover:bg-primary/90');
          button.setAttribute('aria-pressed', 'true');
        } else {
          // Inactive state: outline variant styling
          button.classList.remove('bg-primary', 'text-primary-foreground', 'hover:bg-primary/90');
          button.classList.add('bg-background', 'text-foreground', 'border', 'border-input', 'hover:bg-accent', 'hover:text-accent-foreground');
          button.setAttribute('aria-pressed', 'false');
        }

        // Disable button if no results for this type
        if (!hasResults && filterType !== 'all') {
          button.disabled = true;
          button.classList.add('opacity-50', 'cursor-not-allowed');
        } else {
          button.disabled = false;
          button.classList.remove('opacity-50', 'cursor-not-allowed');
        }
      });
    }

    function updateURL(query: string) {
      const newUrl = new URL(window.location.href);
      if (query) {
        newUrl.searchParams.set('q', query);
      } else {
        newUrl.searchParams.delete('q');
      }

      // Add active filters to URL (excluding 'all' as it's the default)
      const filtersArray = Array.from(activeFilters);
      if (filtersArray.length === 1 && filtersArray[0] === 'all') {
        newUrl.searchParams.delete('filters');
      } else {
        newUrl.searchParams.set('filters', filtersArray.join(','));
      }

      // Add active impact areas to URL
      if (activeImpactAreas.size > 0) {
        newUrl.searchParams.set('impacts', Array.from(activeImpactAreas).join(','));
      } else {
        newUrl.searchParams.delete('impacts');
      }

      // Add verified toggle to URL
      if (activeVerified) {
        newUrl.searchParams.set('verified', 'true');
      } else {
        newUrl.searchParams.delete('verified');
      }

      // Add active project types to URL
      if (activePTypes.size > 0) {
        newUrl.searchParams.set('pType', Array.from(activePTypes).join(','));
      } else {
        newUrl.searchParams.delete('pType');
      }

      // Add active stay types to URL
      if (activeSTypes.size > 0) {
        newUrl.searchParams.set('sType', Array.from(activeSTypes).join(','));
      } else {
        newUrl.searchParams.delete('sType');
      }

      // Add active facilities to URL
      if (activeSFacilities.size > 0) {
        newUrl.searchParams.set('sFacilities', Array.from(activeSFacilities).join(','));
      } else {
        newUrl.searchParams.delete('sFacilities');
      }

      window.history.replaceState(null, '', newUrl.toString());
    }

    function showLoading() {
      if (loading) loading.classList.remove("hidden");
    }

    function hideLoading() {
      if (loading) loading.classList.add("hidden");
    }

    function showFiltersAndStatus() {
      if (filtersAndStatus) filtersAndStatus.classList.remove("hidden");
      if (noResults) noResults.classList.add("hidden");
    }

    function hideFiltersAndStatus() {
      if (filtersAndStatus) filtersAndStatus.classList.add("hidden");
      if (noResults) noResults.classList.add("hidden");
    }

    function showNoResults(query: string) {
      if (noResults) noResults.classList.remove("hidden");
      if (filtersAndStatus) filtersAndStatus.classList.add("hidden");
      
      if (noResultsQuery) {
        noResultsQuery.textContent = `We couldn't find anything for "${query}". Try different keywords or check your spelling.`;
      }
    }

    function showStatus(message: string) {
      // Format message with proper styling - only highlight result counts, not numbers in search terms
      let formattedMessage = message;
      
      // Pattern 1: "Found X result(s) for" - highlight the count
      formattedMessage = formattedMessage.replace(
        /Found (\d+) result/g, 
        'Found <span class="font-semibold text-gray-900 dark:text-white">$1</span> result'
      );
      
      // Pattern 2: "Showing X of Y results for" - highlight both counts
      formattedMessage = formattedMessage.replace(
        /Showing (\d+) of (\d+) results/g, 
        'Showing <span class="font-semibold text-gray-900 dark:text-white">$1</span> of <span class="font-semibold text-gray-900 dark:text-white">$2</span> results'
      );
      
      if (statusText) {
        statusText.className = "text-sm font-normal text-gray-500 dark:text-gray-400";
        statusText.innerHTML = formattedMessage;
      }
      
      showFiltersAndStatus(); // Show the entire section when showing status
      hideLoading();
    }

    function clearResults() {
      if (searchResults) searchResults.innerHTML = "";
      if (noResults) noResults.classList.add("hidden");
      displayedResults = 0;
      allResults = []; // Clear the results array
      updateFilterButtons(); // Update button states when clearing
      if (loadMoreContainer) loadMoreContainer.classList.add("hidden");
    }

    function loadMoreResults() {
      displayFilteredResults(false); // false means append, not replace
    }

    async function performSearch(query: string) {
      if (!pagefind) return;

      console.log('Performing search for:', query);
      const queryChanged = query !== currentQuery;
      currentQuery = query;
      showLoading();
      showFiltersAndStatus(); // Show filters and status section when starting search
      clearResults();

      try {
        // Build the Pagefind filter object from all the active sets/booleans
        const filters: Record<string, any> = {};

        // Content type filter: 'all' means no filter; otherwise map to Pagefind values
        if (!activeFilters.has('all') && activeFilters.size > 0) {
          const mappedTypes = Array.from(activeFilters)
            .map((t) => CONTENT_TYPE_FILTERS[t])
            .filter(Boolean);
          if (mappedTypes.length > 0) {
            filters['type'] = mappedTypes;
          }
        }

        if (activeImpactAreas.size > 0) {
          filters['impactAreas'] = Array.from(activeImpactAreas);
        }
        if (activeVerified) {
          filters['verified'] = 'true';
        }
        if (activePTypes.size > 0) {
          filters['pType'] = Array.from(activePTypes);
        }
        if (activeSTypes.size > 0) {
          filters['sType'] = Array.from(activeSTypes);
        }
        if (activeSFacilities.size > 0) {
          filters['sFacilities'] = Array.from(activeSFacilities);
        }

        const search = await pagefind.search(query || null, { filters });
        console.log('Search results:', search.results.length);
        hideLoading();
        
        if (search.results.length === 0) {
          allResults = [];
          updateFilterButtons(); // Update button states when no results
          
          showNoResults(query);
          return;
        }

        // Process all results and store them
        const processedResults = await Promise.all(
          search.results.map(async (result: any) => {
            try {
              const data = await result.data();
              console.log('Result metadata:', data.meta); // Debug metadata
              return {
                data,
                contentType: getContentType(data),
                card: createResultCard(data)
              };
            } catch (error) {
              console.error("Error processing result:", error);
              return null;
            }
          })
        );

        // Filter out null results and docs results, then store
        allResults = processedResults.filter(result => {
          if (result === null) return false;
          // Exclude docs pages from main search
          if (result.data.url && result.data.url.includes('/docs/')) return false;
          if (result.data.filters && result.data.filters.type && result.data.filters.type[0] === 'doc') return false;
          return true;
        });
        console.log('Processed results (excluding docs):', allResults.length);
        
        // Update result counts
        updateResultCounts();
        
        // Update filter button states
        updateFilterButtons();
        
        // Display filtered results
        displayFilteredResults();

      } catch (error) {
        hideLoading();
        console.error("Search error:", error);
        showStatus("An error occurred while searching. Please try again.");
      }
    }

    function getContentType(data: any): string {
      // Use Pagefind's filter data if available, otherwise fall back to URL
      if (data.filters && data.filters.type) {
        const type = data.filters.type[0]; // Pagefind filters are arrays
        if (type === 'project') return 'projects';
        if (type === 'post') return 'posts';
        if (type === 'stay') return 'stays';
      }
      
      // Fallback to URL-based detection
      if (data.url.includes('/projects/')) return 'projects';
      if (data.url.includes('/blog/')) return 'posts';
      if (data.url.includes('/stays/')) return 'stays';
      return 'page';
    }

    function updateResultCounts() {
      if (allResults.length === 0) {
        // Clear all counts
        const countAll = document.getElementById('count-all');
        const countProjects = document.getElementById('count-projects');
        const countPosts = document.getElementById('count-posts');
        const countStays = document.getElementById('count-stays');
        
        if (countAll) countAll.textContent = '';
        if (countProjects) countProjects.textContent = '';
        if (countPosts) countPosts.textContent = '';
        if (countStays) countStays.textContent = '';
        return;
      }

      // Count results by type
      const counts = {
        projects: 0,
        posts: 0,
        stays: 0,
        page: 0
      };

      allResults.forEach(result => {
        if (counts.hasOwnProperty(result.contentType)) {
          counts[result.contentType as keyof typeof counts]++;
        }
      });

      const total = allResults.length;

      // Update count displays
      const countAll = document.getElementById('count-all');
      const countProjects = document.getElementById('count-projects');
      const countPosts = document.getElementById('count-posts');
      const countStays = document.getElementById('count-stays');
      
      const totalText = `(${total})`;
      const projectsText = counts.projects > 0 ? `(${counts.projects})` : '';
      const postsText = counts.posts > 0 ? `(${counts.posts})` : '';
      const staysText = counts.stays > 0 ? `(${counts.stays})` : '';
      
      if (countAll) countAll.textContent = totalText;
      if (countProjects) countProjects.textContent = projectsText;
      if (countPosts) countPosts.textContent = postsText;
      if (countStays) countStays.textContent = staysText;
      
      // Also update modal counts
      const modalCountAll = document.getElementById('modal-count-all');
      const modalCountProjects = document.getElementById('modal-count-projects');
      const modalCountPosts = document.getElementById('modal-count-posts');
      const modalCountStays = document.getElementById('modal-count-stays');
      
      if (modalCountAll) modalCountAll.textContent = totalText;
      if (modalCountProjects) modalCountProjects.textContent = projectsText;
      if (modalCountPosts) modalCountPosts.textContent = postsText;
      if (modalCountStays) modalCountStays.textContent = staysText;
    }

    function displayFilteredResults(replace: boolean = true) {
      if (allResults.length === 0) return;

      // Pagefind already filtered by content type, impact areas, verified, pType, sType, sFacilities.
      // No further client-side filter loop is needed.

      const filteredCount = allResults.length;

      // Update status
      let statusMessage = '';
      if (currentQuery) {
        statusMessage = `Found ${filteredCount} result${filteredCount !== 1 ? 's' : ''} for "${currentQuery}"`;
      } else {
        statusMessage = `Showing ${filteredCount} result${filteredCount !== 1 ? 's' : ''}`;
      }
      showStatus(statusMessage);

      // Determine how many results to show (paginated)
      const startIndex = replace ? 0 : displayedResults;
      const endIndex = replace ? resultsPerPage : displayedResults + resultsPerPage;
      const resultsToShow = allResults.slice(startIndex, endIndex);
      const resultCards = resultsToShow.map(result => result.card).filter(card => card !== null);

      if (searchResults) {
        if (replace) {
          searchResults.innerHTML = resultCards.join('');
          displayedResults = resultsToShow.length;
        } else {
          searchResults.innerHTML += resultCards.join('');
          displayedResults += resultsToShow.length;
        }
      }

      // Show/hide load more button
      if (loadMoreContainer) {
        if (displayedResults < allResults.length) {
          loadMoreContainer.classList.remove("hidden");
        } else {
          loadMoreContainer.classList.add("hidden");
        }
      }
    }

    function createResultCard(data: any) {
      if (!data) return null;

      // Extract content type - now using Pagefind filters
      let contentType = 'Page';
      let contentTypeSlug = 'page';
      
      if (data.filters && data.filters.type) {
        const type = data.filters.type[0];
        if (type === 'project') {
          contentType = 'Project';
          contentTypeSlug = 'projects';
        } else if (type === 'post') {
          contentType = 'Blog Post';
          contentTypeSlug = 'posts';
        } else if (type === 'stay') {
          contentType = 'Stay';
          contentTypeSlug = 'stays';
        }
      } else {
        // Fallback to URL-based detection
        if (data.url.includes('/projects/')) {
          contentType = 'Project';
          contentTypeSlug = 'projects';
        } else if (data.url.includes('/blog/')) {
          contentType = 'Blog Post';
          contentTypeSlug = 'posts';
        } else if (data.url.includes('/stays/')) {
          contentType = 'Stay';
          contentTypeSlug = 'stays';
        }
      }

      // Get image - try meta first, then look for first image in content
      const image = data.meta?.image || data.meta?.thumbnail || '/giveback-guide-placeholder.jpg';
      
      // Get title - now using Pagefind meta
      const title = data.meta?.title || data.title || 'Untitled';

      // Get additional metadata
      const organiser = data.meta?.organiser || '';
      const locale = data.meta?.locale || '';
      const countries = data.meta?.countries || '';
      const categories = data.meta?.categories || '';

      // Helper function to format locales
      const formatLocales = (locales: string[]) => {
        if (locales.length === 0) return "";
        if (locales.length === 1) return locales[0];
        if (locales.length === 2) return `${locales[0]} & ${locales[1]}`;
        if (locales.length === 3) return `${locales[0]}, ${locales[1]} & ${locales[2]}`;
        // For 4+, show first two and count remaining
        const remaining = locales.length - 2;
        return `${locales[0]}, ${locales[1]} & ${remaining} more`;
      };

      // Create countries/tags badges for projects, stays and posts (matching existing card design)
      let badgesLine = '';
      if (contentTypeSlug === 'projects' && countries) {
        // Filter to only show canonical country names (not aliases)
        const allCountries = countries.split(',').map((c: string) => c.trim()).filter((c: string) => c !== 'United Kingdom' && c !== 'UK');
        // Take only canonical country names (filter out aliases like Aotearoa, Alba, Turkey, etc.)
        const countryArray = allCountries.filter((c: string) => CANONICAL_COUNTRIES.has(c) || !['Aotearoa', 'Alba', 'Cymru', 'Turtle Island', 'Kanata', 'Turkey'].includes(c));
        const localeArray = locale ? locale.split(',').map((l: string) => l.trim()).filter((l: string) => l.length > 0) : [];
        
        if (countryArray.length > 0) {
          badgesLine = `<div class="mb-2 flex items-center flex-wrap gap-1.5">
            ${countryArray.map((country: string) => 
              `<div class="inline-flex items-center gap-1.5">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium border border-gray-300 text-gray-700 dark:border-gray-600 dark:text-gray-300">
                  ${country}
                </span>
                ${localeArray.length > 0 ? `<span class="text-xs font-medium text-gray-700 dark:text-gray-300">|&nbsp; ${formatLocales(localeArray)}</span>` : ''}
              </div>`
            ).join('')}
          </div>`;
        }
      } else if (contentTypeSlug === 'stays' && countries) {
        // Filter to only show canonical country names (not aliases)
        const allCountries = countries.split(',').map((c: string) => c.trim()).filter((c: string) => c !== 'United Kingdom' && c !== 'UK');
        // Take only canonical country names (filter out aliases like Aotearoa, Alba, Turkey, etc.)
        const countryArray = allCountries.filter((c: string) => CANONICAL_COUNTRIES.has(c) || !['Aotearoa', 'Alba', 'Cymru', 'Turtle Island', 'Kanata', 'Turkey'].includes(c));
        const localeArray = locale ? locale.split(',').map((l: string) => l.trim()).filter((l: string) => l.length > 0) : [];
        
        if (countryArray.length > 0) {
          badgesLine = `<div class="mb-2 flex items-center flex-wrap gap-1.5">
            ${countryArray.map((country: string) => 
              `<div class="inline-flex items-center gap-1.5">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium border border-gray-300 text-gray-700 dark:border-gray-600 dark:text-gray-300">
                  ${country}
                </span>
                ${localeArray.length > 0 ? `<span class="text-xs font-medium text-gray-700 dark:text-gray-300">|&nbsp; ${formatLocales(localeArray)}</span>` : ''}
              </div>`
            ).join('')}
          </div>`;
        }
      } else if (contentTypeSlug === 'posts' && categories) {
        // For blog posts, extract categories from the captured text (split only on commas to preserve multi-word categories)
        const categoryArray = categories.split(',').map((cat: string) => cat.trim()).filter((cat: string) => cat.length > 0);
        if (categoryArray.length > 0) {
          badgesLine = `<div class="mb-2">
            ${categoryArray.map((category: string) => 
              `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium border border-gray-300 text-gray-700 dark:border-gray-600 dark:text-gray-300 mr-1.5">
                ${category}
              </span>`
            ).join('')}
          </div>`;
        }
      }

      // Create metadata line based on content type (matching the original card styles)
      let metadataLine = '';
      if (contentTypeSlug === 'projects' && organiser) {
        metadataLine = `<p class="mt-2 text-sm font-normal text-gray-400 dark:text-gray-400">
          ${organiser}
        </p>`;
      } else if (contentTypeSlug === 'stays' && organiser) {
        const stayType = data.meta?.stayType || 'stay';
        metadataLine = `<p class="mt-2 text-sm font-normal text-gray-400 dark:text-gray-400">
          ${organiser} is a ${stayType}
        </p>`;
      }

      return `
        <article class="rounded-lg">
          <div class="relative">
            <a href="${data.url}">
              <img 
                class="w-full rounded-lg h-64 mb-3 object-cover" 
                src="${image}" 
                alt="${title}"
                loading="lazy"
                onerror="this.src='/giveback-guide-placeholder.jpg'"
              />
            </a>
            <span class="absolute top-2 left-2 inline-flex items-center px-3 py-0.5 rounded-full text-sm font-medium text-white bg-gray-800 dark:bg-gray-700">
              ${contentType}
            </span>
          </div>
          ${badgesLine}
          <h2 class="mb-2 text-2xl font-medium tracking-tight text-gray-900 dark:text-white">
            <a href="${data.url}">
              ${title}
            </a>
          </h2>
          ${metadataLine}
        </article>
      `;
    }
  }

  // Run on page load (View Transitions are disabled globally)
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initSearch);
  } else {
    initSearch();
  }
</script>

<style>
  /* Hide scrollbar for mobile filter buttons while maintaining scroll functionality */
  .scrollbar-hide {
    -ms-overflow-style: none; /* IE and Edge */
    scrollbar-width: none; /* Firefox */
  }
  
  .scrollbar-hide::-webkit-scrollbar {
    display: none; /* Chrome, Safari, Opera */
  }
</style>


