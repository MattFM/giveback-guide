---
import MainLayout from '../../layouts/MainLayout.astro';
import VerifyContent from '../../components/design/VerifyContent.astro';
---

<MainLayout title="Verifying..." transition:persist={false}>
    <VerifyContent status="loading" />
</MainLayout>

<script>
    import { updateMagicURLSession, getCurrentUser } from '../../lib/auth';

    const showSuccess = () => {
        const statusDiv = document.getElementById('status');
        if (statusDiv) {
            statusDiv.innerHTML = `
                <div class="text-center">
                    <div class="mb-6">
                        <div class="w-16 h-16 mx-auto rounded-full flex items-center justify-center bg-green-50">
                            <svg class="w-8 h-8 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                            </svg>
                        </div>
                    </div>
                    <h2 class="text-2xl font-bold mb-2 text-gray-900 dark:text-white">Verified!</h2>
                    <p class="text-sm text-gray-500 dark:text-gray-400">Redirecting you...</p>
                </div>
            `;
        }
    };

    const showError = (message: string) => {
        const statusDiv = document.getElementById('status');
        if (statusDiv) {
            statusDiv.innerHTML = `
                <div class="text-center">
                    <div class="mb-6">
                        <div class="w-16 h-16 mx-auto rounded-full flex items-center justify-center bg-red-50">
                            <svg class="w-8 h-8 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                            </svg>
                        </div>
                    </div>
                    <h2 class="text-2xl font-bold mb-2 text-gray-900 dark:text-white">Link Invalid</h2>
                    <p class="text-sm mb-4 text-gray-500 dark:text-gray-400">${message}</p>
                    <p class="text-xs text-gray-400 dark:text-gray-500">Redirecting to login...</p>
                </div>
            `;
        }
    };

    const verifyLink = async () => {
        // Get URL parameters
        const urlParams = new URLSearchParams(window.location.search);
        const otpId = urlParams.get('otpId');
        const code = urlParams.get('code');

        try {
            // Verify the OTP link
            if (typeof updateMagicURLSession !== 'function') {
                throw new Error('Authentication system not available');
            }

            if (otpId && code) {
                await updateMagicURLSession(otpId, code);
            } else {
                await updateMagicURLSession();
            }

            // Force a minimum delay of 1.5 seconds for better UX
            await new Promise(resolve => setTimeout(resolve, 1500));

            // Wait a bit for session to settle in localStorage
            await new Promise(resolve => setTimeout(resolve, 300));

            console.debug('[Verify] Session established, checking if user needs onboarding...');

            // Check if user has completed onboarding to route them correctly
            let needsOnboarding = true;
            try {
                const user = await getCurrentUser();
                console.debug('[Verify] Retrieved user:', user ? { id: user.id, email: user.email, hasName: !!user.name } : null);
                
                if (user) {
                    const prefs = user.prefs || user.preferences || {};
                    const hasName = user.name && String(user.name).trim();
                    const hasPreferences = prefs && Object.keys(prefs).length > 0;
                    
                    console.debug('[Verify] User profile check - hasName:', hasName, 'hasPreferences:', hasPreferences);
                    
                    if (hasName && hasPreferences) {
                        needsOnboarding = false;
                        console.debug('[Verify] User has completed onboarding, will redirect to dashboard');
                    } else {
                        console.debug('[Verify] User needs onboarding');
                    }
                }
            } catch (e) {
                console.error('[Verify] Error checking user onboarding status:', e);
                // Default to onboarding page on error
            }

            // Show success state
            showSuccess();

            // Redirect to appropriate destination
            setTimeout(() => {
                const destination = needsOnboarding ? '/account/onboarding/' : '/account/dashboard/';
                console.debug('[Verify] Redirecting to:', destination);
                window.location.href = destination;
            }, 800);

        } catch (error) {
            console.error('Magic link verification error:', error);
            
            // Force minimum delay even on error
            await new Promise(resolve => setTimeout(resolve, 1000));

            const errAny: any = error;
            const errMessage = errAny?.message || 'The magic link is invalid or has expired.';
            
            showError(errMessage);

            // Redirect to login after delay
            setTimeout(() => {
                window.location.href = '/login/';
            }, 3000);
        }
    };

    // Start verification
    verifyLink();
</script>
