---
import MainLayout from "../../layouts/MainLayout.astro";
import Card from "@/components/bearnie/card/Card.astro";
import CardHeader from "@/components/bearnie/card/CardHeader.astro";
import CardTitle from "@/components/bearnie/card/CardTitle.astro";
import CardContent from "@/components/bearnie/card/CardContent.astro";
import Button from "@/components/bearnie/button/Button.astro";
import Badge from "@/components/bearnie/badge/Badge.astro";
import Empty from "@/components/bearnie/empty/Empty.astro";
import EmptyHeader from "@/components/bearnie/empty/EmptyHeader.astro";
import EmptyTitle from "@/components/bearnie/empty/EmptyTitle.astro";
import EmptyDescription from "@/components/bearnie/empty/EmptyDescription.astro";
import EmptyMedia from "@/components/bearnie/empty/EmptyMedia.astro";
import Skeleton from "@/components/bearnie/skeleton/Skeleton.astro";
import AccountBreadcrumb from "@/components/account/AccountBreadcrumb.astro";
---

<MainLayout
  title="List"
  description="View and manage items saved to a list."
  noindex={true}
>
  <main id="main-content" class="space-y-0">
    <section id="bandedHeader" class="bg-[#F9FAFC] dark:bg-[#0F1217]">
      <div class="mx-auto max-w-screen-xl px-4 sm:px-6 py-6 sm:py-10">
        <header class="mb-4 sm:mb-6">
          <AccountBreadcrumb
            crumbs={[
              { label: "Dashboard", href: "/account/dashboard/" },
              { label: "List" },
            ]}
          />
        </header>

        <section id="listHeaderSection" class="hidden">
          <div class="flex flex-wrap items-start gap-3">
            <div class="flex-1 min-w-0 space-y-1.5">
              <h1
                id="listTitle"
                class="text-3xl sm:text-4xl lg:text-5xl tracking-tight font-extrabold text-gray-900 dark:text-white leading-[1.1]"
              >
                Loading…
              </h1>
              <div id="listDefaultBadge" class="hidden">
                <Badge variant="secondary">Default list</Badge>
              </div>
              <div
                id="listMeta"
                class="text-sm text-gray-600 dark:text-gray-400 flex flex-wrap items-center gap-x-2 gap-y-1"
              >
              </div>
            </div>
            <div class="relative">
              <button
                id="kebab"
                type="button"
                class="inline-flex items-center justify-center h-10 w-10 rounded-md text-muted-foreground hover:text-foreground hover:bg-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-ring cursor-pointer"
                aria-label="List actions"
                aria-haspopup="menu"
                aria-expanded="false"
              >
                ⋯
              </button>
              <div
                id="kebabMenu"
                class="hidden absolute right-0 top-12 z-20 min-w-[180px] rounded-md border bg-popover p-1 shadow-md"
                role="menu"
              >
                <button
                  data-list-action="rename"
                  class="w-full text-left px-2 py-1.5 text-sm rounded-sm hover:bg-accent focus:bg-accent focus:outline-none"
                >
                  Rename
                </button>
                <button
                  data-list-action="set-default"
                  id="kebabSetDefault"
                  class="w-full text-left px-2 py-1.5 text-sm rounded-sm hover:bg-accent focus:bg-accent focus:outline-none disabled:opacity-50 cursor-not-allowed"
                  disabled
                >
                  Set as default
                </button>
                <div class="my-1 h-px bg-border"></div>
                <button
                  data-list-action="delete"
                  class="w-full text-left px-2 py-1.5 text-sm rounded-sm text-destructive hover:bg-destructive/10 focus:bg-destructive/10 focus:outline-none"
                >
                  Delete list
                </button>
              </div>
            </div>
          </div>
        </section>
      </div>
    </section>

    <div class="mx-auto max-w-screen-xl px-4 sm:px-6 py-6 sm:py-8 space-y-6">
      <div id="listErrorBanner" class="hidden"></div>

      <section id="listControlsSection" class="hidden">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div
            id="filterGroup"
            class="inline-flex items-center gap-1 rounded-md border bg-card p-1 text-muted-foreground self-center sm:self-auto"
            role="tablist"
            aria-label="Filter items"
          >
            <button
              type="button"
              data-filter="all"
              class="px-3 py-1.5 text-xs font-medium rounded-sm transition-colors aria-selected:bg-background aria-selected:text-foreground hover:text-foreground focus:outline-none focus-visible:ring-2 focus-visible:ring-ring cursor-pointer"
              role="tab"
              aria-selected="true"
            >All</button>
            <button
              type="button"
              data-filter="visited"
              class="px-3 py-1.5 text-xs font-medium rounded-sm transition-colors aria-selected:bg-background aria-selected:text-foreground hover:text-foreground focus:outline-none focus-visible:ring-2 focus-visible:ring-ring cursor-pointer"
              role="tab"
              aria-selected="false"
            >Visited</button>
            <button
              type="button"
              data-filter="unvisited"
              class="px-3 py-1.5 text-xs font-medium rounded-sm transition-colors aria-selected:bg-background aria-selected:text-foreground hover:text-foreground focus:outline-none focus-visible:ring-2 focus-visible:ring-ring cursor-pointer"
              role="tab"
              aria-selected="false"
            >Not visited</button>
          </div>

          <div class="flex flex-wrap items-center gap-2 sm:gap-3 justify-center sm:justify-end">
            <button
              data-bulk-action="visit"
              type="button"
              disabled
              class="px-3 py-1.5 text-xs font-medium rounded-md border bg-background hover:bg-accent disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-background focus:outline-none focus-visible:ring-2 focus-visible:ring-ring"
            >
              Mark visited
            </button>
            <button
              data-bulk-action="move"
              type="button"
              disabled
              class="px-3 py-1.5 text-xs font-medium rounded-md border bg-background hover:bg-accent disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-background focus:outline-none focus-visible:ring-2 focus-visible:ring-ring"
            >
              Move to list…
            </button>
            <button
              data-bulk-action="remove"
              type="button"
              disabled
              class="px-3 py-1.5 text-xs font-medium rounded-md border bg-background hover:bg-destructive/10 text-destructive disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-background focus:outline-none focus-visible:ring-2 focus-visible:ring-ring"
            >
              Remove
            </button>
          </div>
        </div>
      </section>

      <section id="itemsSection" class="hidden">
        <div class="flex items-center justify-between gap-3 px-3 sm:px-4 py-2 border bg-muted/30 rounded-t-lg">
          <label class="inline-flex items-center gap-2 cursor-pointer select-none">
            <input
              id="selectAllTop"
              type="checkbox"
              class="size-4 cursor-pointer"
              aria-label="Select all visible items"
            />
            <span class="text-xs font-medium text-muted-foreground">Select all</span>
          </label>
          <span id="bulkCount" class="text-sm font-medium text-muted-foreground">0 selected</span>
        </div>
        <ul
          id="itemsList"
          class="divide-y rounded-b-lg border border-t-0 bg-card overflow-visible"
        >
<li class="flex items-start gap-3 p-3 sm:p-4 border-b last:border-b-0">
          <Skeleton class="size-4 shrink-0 mt-1" />
          <Skeleton class="size-14 sm:size-16 shrink-0" />
          <div class="flex-1 min-w-0 space-y-2">
            <Skeleton class="h-4 w-3/4" />
            <Skeleton class="h-3 w-1/3" />
          </div>
          <div class="shrink-0 flex items-center gap-2 mt-0.5">
            <Skeleton class="h-3 w-20 rounded-sm" />
            <Skeleton class="h-6 w-11 rounded-full" />
          </div>
        </li>
        <li class="flex items-start gap-3 p-3 sm:p-4 border-b last:border-b-0">
          <Skeleton class="size-4 shrink-0 mt-1" />
          <Skeleton class="size-14 sm:size-16 shrink-0" />
          <div class="flex-1 min-w-0 space-y-2">
            <Skeleton class="h-4 w-2/3" />
            <Skeleton class="h-3 w-1/2" />
          </div>
          <div class="shrink-0 flex items-center gap-2 mt-0.5">
            <Skeleton class="h-3 w-20 rounded-sm" />
            <Skeleton class="h-6 w-11 rounded-full" />
          </div>
        </li>
        <li class="flex items-start gap-3 p-3 sm:p-4 border-b last:border-b-0">
          <Skeleton class="size-4 shrink-0 mt-1" />
          <Skeleton class="size-14 sm:size-16 shrink-0" />
          <div class="flex-1 min-w-0 space-y-2">
            <Skeleton class="h-4 w-1/2" />
            <Skeleton class="h-3 w-1/4" />
          </div>
          <div class="shrink-0 flex items-center gap-2 mt-0.5">
            <Skeleton class="h-3 w-20 rounded-sm" />
            <Skeleton class="h-6 w-11 rounded-full" />
          </div>
        </li>
        </ul>
        <div
          id="filterEmpty"
          class="hidden text-center text-sm text-muted-foreground py-6"
        >
          No items match this filter.
        </div>
      </section>

      <section id="emptySection" class="hidden">
        <Card size="sm">
          <CardContent>
            <div class="py-12">
              <Empty>
                <EmptyMedia variant="icon">
                  <span aria-hidden="true" class="text-2xl text-muted-foreground">∅</span>
                </EmptyMedia>
                <EmptyHeader>
                  <EmptyTitle>This list is empty</EmptyTitle>
                  <EmptyDescription>
                    Save projects or stays from any item page to add them here.
                  </EmptyDescription>
                </EmptyHeader>
                <div class="mt-2 flex gap-3 justify-center">
                  <Button href="/projects/" variant="outline">Browse projects</Button>
                  <Button href="/stays/" variant="outline">Browse stays</Button>
                </div>
              </Empty>
            </div>
          </CardContent>
        </Card>
      </section>

      <section id="loadingSection">
        <Card>
          <CardHeader>
            <CardTitle>Loading list…</CardTitle>
          </CardHeader>
          <CardContent>
            <p class="text-sm text-muted-foreground">
              Fetching your saved items.
            </p>
          </CardContent>
        </Card>
      </section>
    </div>
  </main>

  <!-- Move-to-list dialog (custom; Bearnie dialog runtime is a stub in this project). -->
  <div id="moveDialog" class="hidden fixed inset-0 z-50">
    <div
      id="moveDialogOverlay"
      class="fixed inset-0 bg-black/50"
      data-move-close
    ></div>
    <div
      id="moveDialogContent"
      class="fixed left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-50 w-full max-w-md rounded-lg border bg-background p-6 shadow-lg"
      role="dialog"
      aria-modal="true"
      aria-labelledby="moveDialogTitle"
    >
      <h3
        id="moveDialogTitle"
        class="text-lg font-semibold mb-2 leading-none tracking-tight"
      >
        Move to list
      </h3>
      <p
        id="moveDialogCaption"
        class="text-sm text-muted-foreground mb-4"
      >
        Pick a destination list.
      </p>
      <div id="moveDialogTargets" class="space-y-2 mb-4"></div>
      <div
        id="moveDialogEmpty"
        class="hidden text-sm text-muted-foreground mb-4 text-center py-6 border rounded-md"
      >
        <p>You don't have another list to move items into.</p>
        <a
          href="/account/lists/new/"
          class="inline-block mt-3 text-primary font-medium underline hover:no-underline"
        >Create one →</a>
      </div>
      <div class="flex gap-2 justify-end">
        <button
          data-move-close
          type="button"
          class="px-4 py-2 text-sm font-medium rounded-md border bg-background hover:bg-accent"
        >
          Cancel
        </button>
        <button
          id="moveDialogConfirm"
          type="button"
          class="px-4 py-2 text-sm font-medium rounded-md bg-primary text-primary-foreground hover:bg-primary/90 disabled:opacity-50"
          disabled
        >
          Move
        </button>
      </div>
    </div>
  </div>
</MainLayout>

<script>
  import { getCurrentUser } from "@/lib/pocketbase";
  import {
    getLists,
    getListsWithItems,
    saveItemToList,
    removeItemFromList,
    renameList,
    deleteList,
    setDefaultList,
  } from "@/lib/lists";
  import { showInlineTextInput, showInlineConfirm } from "@/lib/inline-dialogs";
  import { showToast } from "@/lib/toast-manager";
  import { setCompleted, getStatusesForItems } from "@/lib/completed";

  const DASHBOARD = "/account/dashboard/";
  const LOGIN = "/login/";

  type Filter = "all" | "visited" | "unvisited";
  type ItemType = "project" | "stay";

  interface ListItemRecord {
    id: string;
    list: string;
    item_type: ItemType;
    item_id: string;
    added_at: string;
  }

  interface ListMeta {
    id: string;
    title: string;
    isDefault: boolean;
    description: string | null;
    created_at: string;
    items: ListItemRecord[];
  }

  interface IndexEntry {
    type: ItemType;
    id: string;
    altIds: string[];
    title: string;
    slug: string;
    url: string;
    image?: string | null;
    location?: string | null;
  }

  interface EnrichedItem {
    recId: string;
    item_type: ItemType;
    item_id: string;
    added_at: string;
    title: string;
    url: string;
    image?: string | null;
    location?: string | null;
    visited: boolean;
  }

  interface OtherList {
    id: string;
    title: string;
  }

  const state: {
    list: ListMeta | null;
    items: EnrichedItem[];
    otherLists: OtherList[];
    filter: Filter;
    moveItems: Array<{ recId: string; item_type: ItemType; item_id: string }>;
    selectedIds: Set<string>;
    dialogReturnFocus: HTMLElement | null;
  } = {
    list: null,
    items: [],
    otherLists: [],
    filter: "all",
    moveItems: [],
    dialogReturnFocus: null,
    selectedIds: new Set<string>(),
  };

  function $id<T extends HTMLElement = HTMLElement>(id: string): T {
    return document.getElementById(id) as T;
  }

  function escapeHtml(value: string | null | undefined): string {
    return (value ?? "").replace(/[&<>"']/g, (c) => {
      const map: Record<string, string> = {
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;",
      };
      return map[c] ?? c;
    });
  }

  function fmtNum(n: number): string {
    return Number.isFinite(n) ? n.toLocaleString("en-GB") : "—";
  }

  function relativeTime(iso: string | null | undefined): string {
    if (!iso) return "—";
    const then = new Date(iso).getTime();
    if (Number.isNaN(then)) return "—";
    const diff = Date.now() - then;
    const sec = Math.floor(diff / 1000);
    if (sec < 60) return "just now";
    const min = Math.floor(sec / 60);
    if (min < 60) return `${min}m ago`;
    const hr = Math.floor(min / 60);
    if (hr < 24) return `${hr}h ago`;
    const day = Math.floor(hr / 24);
    if (day < 7) return `${day}d ago`;
    const week = Math.floor(day / 7);
    if (week < 4) return `${week}w ago`;
    const month = Math.floor(day / 30);
    if (month < 12) return `${month}mo ago`;
    return `${Math.floor(day / 365)}y ago`;
  }

  function getListIdFromQuery(): string | null {
    const params = new URLSearchParams(window.location.search);
    const raw = params.get("id");
    if (!raw) return null;
    try {
      return decodeURIComponent(raw);
    } catch {
      return raw;
    }
  }

  function showError(message: string): void {
    const banner = document.getElementById("listErrorBanner");
    if (!banner) return;
    banner.className =
      "rounded-lg border border-destructive/30 bg-destructive/5 p-4 text-sm text-destructive";
    banner.textContent = message;
    banner.classList.remove("hidden");
  }

  function clearError(): void {
    const banner = document.getElementById("listErrorBanner");
    if (!banner) return;
    banner.textContent = "";
    banner.classList.add("hidden");
  }

  async function ensureSignedIn(): Promise<boolean> {
    try {
      const auth = localStorage.getItem("pocketbase_auth");
      if (!auth || auth === "null" || auth === "undefined") {
        window.location.href = LOGIN;
        return false;
      }
      const user = await getCurrentUser();
      if (!user) {
        window.location.href = LOGIN;
        return false;
      }
      return true;
    } catch {
      window.location.href = LOGIN;
      return false;
    }
  }

  async function loadItemsIndex(): Promise<Map<string, IndexEntry>> {
    try {
      const response = await fetch("/api/items.json");
      if (!response.ok) return new Map();
      const payload = (await response.json()) as { items?: IndexEntry[] };
      const items = payload.items ?? [];
      const map = new Map<string, IndexEntry>();
      for (const item of items) {
        map.set(item.id, item);
        for (const alt of item.altIds ?? []) {
          map.set(alt, item);
        }
      }
      return map;
    } catch {
      return new Map();
    }
  }

  function renderHeader(): void {
    if (!state.list) return;
    const titleEl = $id("listTitle");
    if (titleEl) titleEl.textContent = state.list.title;

    const defaultBadge = $id("listDefaultBadge");
    if (defaultBadge) {
      if (state.list.isDefault) defaultBadge.classList.remove("hidden");
      else defaultBadge.classList.add("hidden");
    }

    const setDefault = document.getElementById<HTMLButtonElement>("kebabSetDefault");
    if (setDefault) {
      setDefault.disabled = state.list.isDefault;
    }

    const meta = $id("listMeta");
    if (meta) {
      const count = state.list.items.length;
      const label = count === 1 ? "item" : "items";
      const lastTs = state.list.items
        .map((it) => new Date(it.added_at).getTime())
        .filter((t) => !Number.isNaN(t));
      const lastMs = lastTs.length ? Math.max(...lastTs) : null;
      const lastLabel = lastMs ? relativeTime(new Date(lastMs).toISOString()) : "never";
      meta.innerHTML = `
        <span>${count} ${label}</span>
        <span>·</span>
        <span>Last update ${lastLabel}</span>
      `;
    }

    const headerSection = $id("listHeaderSection");
    if (headerSection) headerSection.classList.remove("hidden");

    const controlsSection = $id("listControlsSection");
    if (controlsSection) controlsSection.classList.remove("hidden");

    updateBulkCount();

    const breadcrumb = document.querySelector<HTMLElement>("nav[aria-label='breadcrumb']");
    if (breadcrumb) {
      const lastSpan = breadcrumb.querySelector<HTMLElement>("[aria-current='page']");
      if (lastSpan) lastSpan.textContent = state.list.title;
    }
  }

  function getItemsForCurrentView(): EnrichedItem[] {
    if (!state.list) return [];
    return state.items.filter((item) => {
      if (state.filter === "visited") return item.visited;
      if (state.filter === "unvisited") return !item.visited;
      return true;
    });
  }

  function renderRow(item: EnrichedItem): string {
    const safeTitle = escapeHtml(item.title);
    const image = item.image
      ? `<img src="${escapeHtml(item.image)}" alt="${safeTitle}" loading="lazy" class="size-14 sm:size-16 rounded object-cover" />`
      : `<div class="size-14 sm:size-16 rounded bg-muted flex items-center justify-center text-xs text-muted-foreground">No image</div>`;
    const typeTag = item.item_type === "stay" ? "Stay" : "Project";
    const visitedState = item.visited ? "checked" : "unchecked";
    const visitedLabel = item.visited ? "Visited" : "Mark visited";
    const location = item.location
      ? `<span>${escapeHtml(item.location)}</span>`
      : "";
    const itemUrl = escapeHtml(item.url);

    return `
      <li class="flex items-start gap-3 p-3 sm:p-4 border-b last:border-b-0 hover:bg-muted/40 transition-colors" data-item-row data-rec-id="${escapeHtml(item.recId)}" data-item-id="${escapeHtml(item.item_id)}" data-item-type="${item.item_type}">
        <input type="checkbox" data-row-bulk class="shrink-0 size-4 cursor-pointer mt-1" aria-label="Select ${safeTitle} for bulk actions" />
        <a
          href="${itemUrl}"
          class="flex flex-1 min-w-0 items-start gap-3 cursor-pointer rounded-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
        >
          <div class="shrink-0">${image}</div>
          <div class="flex-1 min-w-0 space-y-1.5">
            <span class="block font-medium hover:underline line-clamp-2 text-sm">${safeTitle}</span>
            <div class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
              <span class="inline-flex items-center rounded-sm bg-secondary px-2 py-0.5 text-xs font-medium text-secondary-foreground">${typeTag}</span>
              ${location}
            </div>
          </div>
        </a>
        <div class="shrink-0 flex items-center gap-2 mt-0.5">
          <span
            class="text-xs text-muted-foreground font-medium select-none"
            data-row-visited-label
          >${visitedLabel}</span>
          <button
            type="button"
            role="switch"
            aria-checked="${item.visited}"
            data-state="${visitedState}"
            data-row-visited-switch
            aria-label="Mark ${safeTitle} as visited"
            class="peer inline-flex h-6 w-11 shrink-0 cursor-pointer items-center rounded-full border-2 border-transparent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background data-[state=checked]:bg-primary data-[state=unchecked]:bg-input"
          >
            <span class="pointer-events-none block size-5 rounded-full bg-background shadow-lg ring-0 transition-transform data-[state=checked]:translate-x-5 data-[state=unchecked]:translate-x-0" data-state="${visitedState}"></span>
          </button>
        </div>
      </li>
    `;
  }

  function renderRows(): void {
    if (!state.list) return;
    const itemsSection = $id("itemsSection");
    const itemsList = $id("itemsList");
    const emptySection = $id("emptySection");
    const filterEmpty = $id("filterEmpty");
    if (!itemsList) return;

    if (state.list.items.length === 0) {
      if (itemsSection) itemsSection.classList.add("hidden");
      if (emptySection) emptySection.classList.remove("hidden");
      if (filterEmpty) filterEmpty.classList.add("hidden");
      return;
    }

    if (itemsSection) itemsSection.classList.remove("hidden");
    if (emptySection) emptySection.classList.add("hidden");

    const view = getItemsForCurrentView();
    itemsList.innerHTML = view.map(renderRow).join("");

    if (view.length === 0 && filterEmpty) {
      filterEmpty.classList.remove("hidden");
    } else if (filterEmpty) {
      filterEmpty.classList.add("hidden");
    }

    wireItemRows();
    syncBulkChecks();
  }

  function wireItemRows(): void {
    const rows = document.querySelectorAll<HTMLLIElement>("#itemsList [data-item-row]");
    rows.forEach((row) => {
      const visitedSwitch = row.querySelector<HTMLButtonElement>("[data-row-visited-switch]");
      if (visitedSwitch) {
        visitedSwitch.addEventListener("click", async () => {
          const item = state.items.find(
            (it) =>
              it.recId === row.dataset.recId ||
              (it.item_type === row.dataset.itemType && it.item_id === row.dataset.itemId),
          );
          if (!item) return;
          const previous = item.visited;
          const next = !previous;
          applySwitchVisualState(visitedSwitch, next);
          syncRowVisitedLabel(row, next);
          try {
            await setCompleted(item.item_type, item.item_id, next);
            item.visited = next;
          } catch (err) {
            applySwitchVisualState(visitedSwitch, previous);
            syncRowVisitedLabel(row, previous);
            const message = err instanceof Error ? err.message : String(err);
            showError(`Could not mark visited: ${message}`);
          }
        });
      }

      const bulk = row.querySelector<HTMLInputElement>("[data-row-bulk]");
      if (bulk) {
        bulk.checked = state.selectedIds.has(row.dataset.itemId ?? "");
        bulk.addEventListener("change", () => {
          const id = row.dataset.itemId ?? "";
          if (bulk.checked) state.selectedIds.add(id);
          else state.selectedIds.delete(id);
          updateBulkCount();
        });
      }
    });
  }

  function syncRowVisitedLabel(row: HTMLElement, visited: boolean): void {
    const label = row.querySelector<HTMLElement>("[data-row-visited-label]");
    if (label) label.textContent = visited ? "Visited" : "Mark visited";
  }

  function setFilter(next: Filter): void {
    state.filter = next;
    if (state.list) {
      const key = `dashboard_${state.list.id}_visitFilter`;
      localStorage.setItem(key, next);
    }
    document.querySelectorAll<HTMLButtonElement>("#filterGroup [data-filter]").forEach((button) => {
      const isActive = button.dataset.filter === next;
      button.setAttribute("aria-selected", isActive ? "true" : "false");
    });
    renderRows();
    updateBulkCount();
  }

  function wireFilter(): void {
    const buttons = Array.from(
      document.querySelectorAll<HTMLButtonElement>("#filterGroup [data-filter]"),
    );
    buttons.forEach((button, index) => {
      button.addEventListener("click", () => {
        const filter = button.dataset.filter as Filter;
        if (filter) setFilter(filter);
      });
      button.addEventListener("keydown", (event: KeyboardEvent) => {
        const targetIndex = (() => {
          if (event.key === "ArrowRight" || event.key === "ArrowDown") {
            return (index + 1) % buttons.length;
          }
          if (event.key === "ArrowLeft" || event.key === "ArrowUp") {
            return (index - 1 + buttons.length) % buttons.length;
          }
          if (event.key === "Home") return 0;
          if (event.key === "End") return buttons.length - 1;
          return null;
        })();
        if (targetIndex === null) return;
        event.preventDefault();
        const next = buttons[targetIndex];
        next.focus();
        const filter = next.dataset.filter as Filter;
        if (filter) setFilter(filter);
      });
    });
  }

  function applySwitchVisualState(switchEl: HTMLElement, checked: boolean): void {
    const stateStr = checked ? "checked" : "unchecked";
    switchEl.setAttribute("aria-checked", String(checked));
    switchEl.setAttribute("data-state", stateStr);
    switchEl.querySelector("span")?.setAttribute("data-state", stateStr);
  }

  function selectAllVisible(checked: boolean): void {
    const view = getItemsForCurrentView();
    for (const item of view) {
      const id = item.item_id;
      if (!id) continue;
      if (checked) state.selectedIds.add(id);
      else state.selectedIds.delete(id);
    }
    syncBulkChecks();
    updateBulkCount();
  }

  function syncSelectAllTop(): void {
    const selectAll = $id<HTMLInputElement>("selectAllTop");
    if (!selectAll) return;
    const view = getItemsForCurrentView();
    const total = view.length;
    if (total === 0) {
      selectAll.checked = false;
      selectAll.indeterminate = false;
      selectAll.disabled = true;
      return;
    }
    selectAll.disabled = false;
    const selectedCount = view.reduce(
      (acc, item) => acc + (state.selectedIds.has(item.item_id) ? 1 : 0),
      0,
    );
    if (selectedCount === 0) {
      selectAll.checked = false;
      selectAll.indeterminate = false;
    } else if (selectedCount === total) {
      selectAll.checked = true;
      selectAll.indeterminate = false;
    } else {
      selectAll.checked = false;
      selectAll.indeterminate = true;
    }
  }

  function syncBulkChecks(): void {
    document.querySelectorAll<HTMLInputElement>("#itemsList [data-row-bulk]").forEach((checkbox) => {
      const row = checkbox.closest<HTMLElement>("[data-item-row]");
      if (!row) return;
      checkbox.checked = state.selectedIds.has(row.dataset.itemId ?? "");
    });
  }

  function updateBulkCount(): void {
    const el = $id("bulkCount");
    if (el) el.textContent = `${state.selectedIds.size} selected`;
    syncSelectAllTop();
    syncBulkControls();
  }

  function syncBulkControls(): void {
    const canApply = !!state.list && state.selectedIds.size > 0;
    document.querySelectorAll<HTMLButtonElement>(
      "#listControlsSection [data-bulk-action]",
    ).forEach((button) => {
      button.disabled = !canApply;
    });
  }

  function wireSelectAll(): void {
    const selectAll = $id<HTMLInputElement>("selectAllTop");
    if (selectAll) {
      selectAll.addEventListener("change", () => selectAllVisible(selectAll.checked));
    }
  }

  function wireBulk(): void {
    document.querySelectorAll<HTMLButtonElement>("[data-bulk-action]").forEach((button) => {
      button.addEventListener("click", async () => {
        const action = button.dataset.bulkAction;
        if (!action || state.selectedIds.size === 0) return;
        await runBulk(action);
      });
    });
  }

  async function runBulk(action: string): Promise<void> {
    if (!state.list || state.selectedIds.size === 0) return;
    const items = state.items.filter((it) => state.selectedIds.has(it.item_id));
    if (items.length === 0) return;
    try {
      if (action === "visit") {
        for (const item of items) {
          await setCompleted(item.item_type, item.item_id, true);
        }
      } else if (action === "remove") {
        const ok = await showInlineConfirm({
          title: `Remove ${items.length} item(s)?`,
          body: "They stay on your account; only this list is affected.",
          confirmLabel: "Remove",
          variant: "destructive",
        });
        if (!ok) return;
        for (const item of items) {
          await removeItemFromList(state.list.id, item.item_type, item.item_id);
        }
      } else if (action === "move") {
        const payload = items.map((it) => ({
          recId: it.recId,
          item_type: it.item_type,
          item_id: it.item_id,
        }));
        openMoveDialog(payload, items.length);
        return;
      }
      state.selectedIds.clear();
      await load();
    } catch (err) {
      const message = err instanceof Error ? err.message : String(err);
      showError(`Bulk action failed: ${message}`);
    }
  }

  function openMoveDialog(
    items: typeof state.moveItems,
    count: number
  ): void {
    state.moveItems = items.slice();
    state.dialogReturnFocus = document.activeElement as HTMLElement | null;
    const dialog = $id("moveDialog");
    const overlay = $id("moveDialogOverlay");
    const content = $id("moveDialogContent");
    const targets = $id("moveDialogTargets");
    const empty = $id("moveDialogEmpty");
    const caption = $id("moveDialogCaption");
    const confirm = $id<HTMLButtonElement>("moveDialogConfirm");

    if (caption) {
      caption.textContent =
        `Move ${count === 1 ? "this item" : `${count} items`} to:`;
    }

    if (state.otherLists.length === 0) {
      if (targets) targets.classList.add("hidden");
      if (empty) empty.classList.remove("hidden");
      if (confirm) {
        confirm.disabled = true;
        confirm.classList.add("hidden");
      }
    } else {
      if (targets) {
        targets.classList.remove("hidden");
        targets.innerHTML = state.otherLists
          .map(
            (l, i) => `
            <label class="flex items-center gap-2 p-2 rounded-md border bg-card cursor-pointer hover:bg-accent" data-target-list-id="${escapeHtml(l.id)}">
              <input type="radio" name="moveTarget" value="${escapeHtml(l.id)}" class="size-4 cursor-pointer" ${i === 0 ? "checked" : ""} />
              <span class="text-sm font-medium">${escapeHtml(l.title)}</span>
            </label>
          `,
          )
          .join("");
      }
      if (empty) empty.classList.add("hidden");
      if (confirm) {
        confirm.disabled = false;
        confirm.classList.remove("hidden");
      }
    }

    if (dialog) dialog.classList.remove("hidden");
    if (overlay) overlay.classList.remove("hidden");
    if (content) {
      content.classList.remove("hidden");
      requestAnimationFrame(() => {
        const first = content.querySelector<HTMLElement>(
          "input, button, [tabindex]:not([tabindex='-1'])",
        );
        first?.focus();
      });
    }
    document.body.style.overflow = "hidden";
  }

  function closeMoveDialog(restoreFocus = true): void {
    const dialog = $id("moveDialog");
    const overlay = $id("moveDialogOverlay");
    const content = $id("moveDialogContent");
    if (dialog) dialog.classList.add("hidden");
    if (overlay) overlay.classList.add("hidden");
    if (content) content.classList.add("hidden");
    document.body.style.overflow = "";
    state.moveItems = [];
    if (restoreFocus && state.dialogReturnFocus && document.contains(state.dialogReturnFocus)) {
      state.dialogReturnFocus.focus();
    }
    state.dialogReturnFocus = null;
  }

  async function confirmMove(): Promise<void> {
    if (!state.list) return;
    const checked = document.querySelector<HTMLInputElement>(
      '#moveDialogTargets input[name="moveTarget"]:checked',
    );
    const targetId = checked?.value;
    if (!targetId) return;
    const items = state.moveItems.slice();
    if (items.length === 0) return;
    try {
      for (const item of items) {
        await saveItemToList(targetId, item.item_type, item.item_id);
        await removeItemFromList(state.list.id, item.item_type, item.item_id);
      }
      closeMoveDialog();
      state.selectedIds.clear();
      await load();
    } catch (err) {
      const message = err instanceof Error ? err.message : String(err);
      showError(`Move failed: ${message}`);
    }
  }

  function wireMoveDialog(): void {
    document
      .querySelectorAll<HTMLElement>("[data-move-close]")
      .forEach((el) => el.addEventListener("click", closeMoveDialog));
    const confirmBtn = $id<HTMLButtonElement>("moveDialogConfirm");
    if (confirmBtn) confirmBtn.addEventListener("click", () => void confirmMove());
    document.addEventListener("keydown", (event) => {
      const dialog = $id("moveDialog");
      if (event.key === "Escape" && dialog && !dialog.classList.contains("hidden")) {
        closeMoveDialog();
      }
    });
  }

  function wireListKebab(): void {
    const kebab = $id("kebab");
    const menu = $id("kebabMenu");
    if (!kebab || !menu) return;
    kebab.addEventListener("click", (event) => {
      event.stopPropagation();
      event.preventDefault();
      const open = !menu.classList.contains("hidden");
      if (!open) {
        menu.classList.remove("hidden");
        kebab.setAttribute("aria-expanded", "true");
      } else {
        menu.classList.add("hidden");
        kebab.setAttribute("aria-expanded", "false");
      }
    });
    menu.querySelectorAll<HTMLButtonElement>("[data-list-action]").forEach((button) => {
      button.addEventListener("click", async () => {
        const action = button.dataset.listAction;
        if (!action) return;
        menu.classList.add("hidden");
        kebab.setAttribute("aria-expanded", "false");
        await handleListAction(action);
      });
    });
  }

  async function handleListAction(action: string): Promise<void> {
    if (!state.list) return;
    try {
      if (action === "rename") {
        const next = await showInlineTextInput({
          title: "Rename list",
          label: "List name",
          initialValue: state.list.title,
          maxLength: 120,
          placeholder: "List name",
          confirmLabel: "Save",
          validate: (candidate: string) => {
            const trimmed = candidate.trim();
            if (!trimmed) return "Please enter a name.";
            if (trimmed.length > 120) return "List name must be 120 characters or fewer.";
            return null;
          },
        });
        if (next === null) return;
        const trimmed = next.trim();
        if (!trimmed || trimmed === state.list.title) return;
        await renameList(state.list.id, trimmed);
        showToast("success", "List renamed.");
        await load();
      } else if (action === "set-default") {
        if (state.list.isDefault) return;
        await setDefaultList(state.list.id);
        showToast("success", "Default list updated.");
        await load();
      } else if (action === "delete") {
        const ok = await showInlineConfirm({
          title: "Delete this list?",
          body: "This removes the list and its saved items. This cannot be undone.",
          confirmLabel: "Delete list",
          variant: "destructive",
        });
        if (!ok) return;
        await deleteList(state.list.id);
        showToast("success", "List deleted.");
        window.location.href = DASHBOARD;
      }
    } catch (err) {
      const message = err instanceof Error ? err.message : String(err);
      showError(`Could not update list: ${message}`);
      showToast("error", message);
    }
  }

  function wireGlobalDismiss(): void {
    document.addEventListener("click", (event) => {
      const target = event.target as HTMLElement | null;
      if (!target) return;
      if (!target.closest("#kebabMenu") && !target.closest("#kebab")) {
        const kebab = $id<HTMLButtonElement>("kebab");
        const menu = $id("kebabMenu");
        if (kebab && menu && !menu.classList.contains("hidden")) {
          menu.classList.add("hidden");
          kebab.setAttribute("aria-expanded", "false");
        }
      }
    });
  }

  async function load(): Promise<void> {
    clearError();
    try {
      const signedIn = await ensureSignedIn();
      if (!signedIn) return;

      const listId = getListIdFromQuery();
      if (!listId) {
        window.location.href = DASHBOARD;
        return;
      }

      const [listsWithItems, allLists, itemsIndex] = await Promise.all([
        getListsWithItems(),
        getLists(),
        loadItemsIndex(),
      ]);

      const listMatch = (listsWithItems as any[]).find((l: any) => l.id === listId);
      if (!listMatch) {
        window.location.href = DASHBOARD;
        return;
      }

      state.list = {
        id: listMatch.id,
        title: listMatch.title,
        isDefault: !!listMatch.is_default,
        description: listMatch.description ?? null,
        created_at: listMatch.created_at,
        items: (listMatch.items ?? []) as ListItemRecord[],
      };
      state.otherLists = ((allLists as any[]) ?? [])
        .filter((l: any) => l.id !== listId)
        .map((l: any) => ({ id: l.id, title: l.title }));

      const pairs = state.list.items.map((it) => ({
        item_type: it.item_type,
        item_id: String(it.item_id),
      }));
      const statuses = await getStatusesForItems(pairs);

      state.items = state.list.items.map((it) => {
        const meta = itemsIndex.get(String(it.item_id));
        const key = `${it.item_type}:${String(it.item_id)}`;
        return {
          recId: it.id,
          item_type: it.item_type,
          item_id: String(it.item_id),
          added_at: it.added_at,
          title: meta?.title ?? "(unknown item)",
          url: meta?.url ?? "#",
          image: meta?.image ?? null,
          location: meta?.location ?? null,
          visited: key in statuses ? !!statuses[key].is_completed : false,
        };
      });

      const filterKey = `dashboard_${listId}_visitFilter`;
      const savedFilter = localStorage.getItem(filterKey);
      const next: Filter =
        savedFilter === "visited" || savedFilter === "unvisited" || savedFilter === "all"
          ? (savedFilter as Filter)
          : "all";
      state.filter = next;

      applyFilterStyle();
      renderHeader();
      renderRows();

      const loading = $id("loadingSection");
      if (loading) loading.classList.add("hidden");
    } catch (err) {
      const message = err instanceof Error ? err.message : String(err);
      showError(`Failed to load list: ${message}`);
      const loading = $id("loadingSection");
      if (loading) loading.classList.add("hidden");
    }
  }

  function applyFilterStyle(): void {
    const buttons = document.querySelectorAll<HTMLButtonElement>("#filterGroup [data-filter]");
    buttons.forEach((button) => {
      const isActive = button.dataset.filter === state.filter;
      button.setAttribute("aria-selected", isActive ? "true" : "false");
    });
  }

  void getCurrentUser();
  wireFilter();
  wireBulk();
  wireSelectAll();
  wireMoveDialog();
  wireListKebab();
  wireGlobalDismiss();
  void load();
</script>
