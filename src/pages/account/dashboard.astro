---
import MainLayout from "../../layouts/MainLayout.astro";
import AccountBreadcrumb from "@/components/account/AccountBreadcrumb.astro";
import UpgradePrompt from "@/components/account/UpgradePrompt.astro";
import Empty from "@/components/bearnie/empty/Empty.astro";
import EmptyHeader from "@/components/bearnie/empty/EmptyHeader.astro";
import EmptyTitle from "@/components/bearnie/empty/EmptyTitle.astro";
import EmptyDescription from "@/components/bearnie/empty/EmptyDescription.astro";
import EmptyMedia from "@/components/bearnie/empty/EmptyMedia.astro";
import Card from "@/components/bearnie/card/Card.astro";
import CardHeader from "@/components/bearnie/card/CardHeader.astro";
import CardTitle from "@/components/bearnie/card/CardTitle.astro";
import CardContent from "@/components/bearnie/card/CardContent.astro";
import Button from "@/components/bearnie/button/Button.astro";
import Skeleton from "@/components/bearnie/skeleton/Skeleton.astro";
---

<MainLayout
  title="Dashboard"
  description="Your lists, saves and recently visited projects and stays."
  noindex={true}
>
  <main id="main-content" class="container mx-auto max-w-screen-xl px-4 py-8 sm:py-12 space-y-8">
    <header class="flex flex-wrap items-center gap-4">
      <div class="flex-1 min-w-0 space-y-2">
        <h1 id="headerGreeting" class="text-2xl sm:text-3xl font-semibold tracking-tight">
          Welcome back
        </h1>
        <p class="text-sm text-muted-foreground">
          <AccountBreadcrumb crumbs={[{ label: "Dashboard" }]} />
        </p>
      </div>
    </header>

    <div id="errorBanner" class="hidden"></div>

    <section id="statsSection" class="hidden">
      <div class="grid gap-4 sm:grid-cols-3">
        <Skeleton class="h-24 w-full" />
        <Skeleton class="h-24 w-full" />
        <Skeleton class="h-24 w-full" />
      </div>
    </section>

    <section id="emptySection" class="hidden">
      <Card size="sm">
        <CardContent>
          <div class="py-12">
            <Empty>
              <EmptyMedia variant="icon">
                <span aria-hidden="true" class="text-3xl text-muted-foreground">+</span>
              </EmptyMedia>
              <EmptyHeader>
                <EmptyTitle>No lists yet</EmptyTitle>
                <EmptyDescription>
                  Create your first list to start saving projects and stays.
                </EmptyDescription>
              </EmptyHeader>
              <div class="mt-2">
                <Button href="/account/lists/new/">Create your first list</Button>
              </div>
            </Empty>
          </div>
        </CardContent>
      </Card>
    </section>

    <section id="listsSection" class="hidden">
      <div class="flex items-baseline justify-between mb-4">
        <h2 class="text-lg font-semibold">My lists</h2>
        <span id="listsCount" class="text-sm text-muted-foreground"></span>
      </div>
      <div id="listsGrid" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3"></div>
    </section>

    <section id="atCapSection" class="hidden">
      <UpgradePrompt variant="warning" />
    </section>

    <section id="recentSection" class="hidden">
      <div class="flex items-baseline justify-between mb-4">
        <h2 class="text-lg font-semibold">Recently visited</h2>
        <span class="text-sm text-muted-foreground inline-flex items-center gap-1">
          <span aria-hidden="true">↔</span>
          <span>Scroll</span>
        </span>
      </div>
      <div id="recentFeed"></div>
    </section>

    <section id="loadingSection">
      <Card>
        <CardHeader>
          <CardTitle>Loading your dashboard…</CardTitle>
        </CardHeader>
        <CardContent>
          <p class="text-sm text-muted-foreground">Fetching your lists, saves and recently visited entries.</p>
        </CardContent>
      </Card>
    </section>
  </main>
</MainLayout>

<script>
  import { getCurrentUser } from "@/lib/pocketbase";
  import {
    getListsWithItems,
    deleteList,
    renameList,
    setDefaultList,
  } from "@/lib/lists";
  import { getRecentCompleted, getCompletedCount } from "@/lib/completed";
  import { getAccountTier } from "@/lib/billing";
  import { canCreateList, FREE_TIER } from "@/lib/tier-limits";
  import { showInlineRename, showInlineConfirm } from "@/lib/inline-dialogs";
  import { showToast } from "@/lib/toast-manager";

  const LOGIN = "/login/";

  interface ListRow {
    id: string;
    title: string;
    isDefault: boolean;
    itemCount: number;
    lastUpdatedLabel: string;
  }

  interface ItemIndexEntry {
    type: "project" | "stay";
    id: string;
    altIds: string[];
    title: string;
    slug: string;
    url: string;
    image?: string | null;
    location?: string | null;
  }

  type AnyElement = HTMLElement | null;
  function $id<T extends HTMLElement = HTMLElement>(id: string): T {
    return document.getElementById(id) as T;
  }

  function fmtNum(n: number): string {
    return Number.isFinite(n) ? n.toLocaleString("en-GB") : "—";
  }

  function relativeTime(iso: string | null | undefined): string {
    if (!iso) return "—";
    const then = new Date(iso).getTime();
    if (Number.isNaN(then)) return "—";
    const diff = Date.now() - then;
    const sec = Math.floor(diff / 1000);
    if (sec < 60) return "just now";
    const min = Math.floor(sec / 60);
    if (min < 60) return `${min}m ago`;
    const hr = Math.floor(min / 60);
    if (hr < 24) return `${hr}h ago`;
    const day = Math.floor(hr / 24);
    if (day < 7) return `${day}d ago`;
    const week = Math.floor(day / 7);
    if (week < 4) return `${week}w ago`;
    const month = Math.floor(day / 30);
    if (month < 12) return `${month}mo ago`;
    return `${Math.floor(day / 365)}y ago`;
  }

  function showError(message: string): void {
    const banner = $id("errorBanner");
    if (!banner) return;
    banner.className =
      "rounded-lg border border-destructive/30 bg-destructive/5 p-4 text-sm text-destructive";
    banner.textContent = message;
    banner.classList.remove("hidden");
  }

  function clearError(): void {
    const banner = $id("errorBanner");
    if (!banner) return;
    banner.textContent = "";
    banner.classList.add("hidden");
  }

  function sectionsFadeIn(): void {
    for (const id of [
      "statsSection",
      "atCapSection",
      "recentSection",
    ]) {
      const el = $id(id);
      if (el) el.classList.remove("hidden");
    }
    const loading = $id("loadingSection");
    if (loading) loading.classList.add("hidden");
  }

  function buildKpis(totalSaved: number, listCount: number, visitedCount: number): { label: string; value: string; caption?: string }[] {
    return [
      { label: "Saved", value: fmtNum(totalSaved), caption: "Items across all lists" },
      { label: "Lists", value: fmtNum(listCount), caption: listCount === 1 ? "1 list" : `${listCount} lists` },
      { label: "Visited", value: fmtNum(visitedCount), caption: "Items marked visited" },
    ];
  }

  function buildListsGrid(lists: ListRow[], atCap: boolean, tier: "free" | "pro"): string {
    const cards = lists
      .map((list) => renderListCard(list))
      .join("");
    const newCard = renderNewListCard(atCap);
    return cards + newCard;
  }

  function renderListCard(list: ListRow): string {
    const countLabel =
      list.itemCount === 1 ? "item saved" : "items saved";
    const defaultBadge = list.isDefault
      ? `<span class="inline-flex items-center gap-1 rounded-sm bg-secondary px-2 py-0.5 text-xs font-medium text-secondary-foreground self-start">Default</span>`
      : "";
    const disabledDefault =
      list.isDefault
        ? `<button class="w-full text-left px-2 py-1.5 text-sm rounded-sm opacity-50 cursor-not-allowed" disabled aria-disabled="true">Set as default</button>`
        : `<button data-list-action="set-default" data-list-id="${list.id}" class="w-full text-left px-2 py-1.5 text-sm rounded-sm hover:bg-accent focus:bg-accent focus:outline-none">Set as default</button>`;
    const safeTitle = list.title.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c] ?? c));
    return `
      <div class="relative rounded-lg border bg-card text-card-foreground p-6 hover:border-foreground/30 transition-colors" data-list-id="${list.id}">
        <a href="/account/list/?id=${encodeURIComponent(list.id)}" class="block focus:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 rounded-lg" data-list-link>
          <div class="space-y-1.5">
            <p class="font-semibold leading-tight line-clamp-2">${safeTitle}</p>
            ${defaultBadge}
          </div>
          <div class="mt-4">
            <p class="text-2xl font-semibold tabular-nums">${list.itemCount}</p>
            <p class="text-xs text-muted-foreground mt-1">${countLabel}</p>
            <p class="text-xs text-muted-foreground mt-2">${list.lastUpdatedLabel}</p>
          </div>
        </a>
        <button
          type="button"
          class="absolute top-3 right-3 inline-flex items-center justify-center h-8 w-8 rounded-md text-muted-foreground hover:text-foreground hover:bg-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          data-list-kebab
          data-list-id="${list.id}"
          aria-label="List actions"
          aria-haspopup="menu"
          aria-expanded="false"
        >⋯</button>
        <div
          class="absolute top-12 right-3 z-10 min-w-[180px] rounded-md border bg-popover p-1 shadow-md hidden"
          data-list-menu
          data-list-id="${list.id}"
          role="menu"
        >
          <button data-list-action="rename" data-list-id="${list.id}" class="w-full text-left px-2 py-1.5 text-sm rounded-sm hover:bg-accent focus:bg-accent focus:outline-none">Rename</button>
          ${disabledDefault}
          <div class="my-1 h-px bg-border"></div>
          <button data-list-action="delete" data-list-id="${list.id}" class="w-full text-left px-2 py-1.5 text-sm rounded-sm text-destructive hover:bg-destructive/10 focus:bg-destructive/10 focus:outline-none">Delete list</button>
        </div>
      </div>
    `;
  }

  function renderNewListCard(atCap: boolean): string {
    if (atCap) {
      return `
        <div class="rounded-lg border-2 border-dashed border-border bg-card/30 flex flex-col items-center justify-center p-6 min-h-[180px] cursor-not-allowed opacity-60" aria-disabled="true">
          <span class="text-3xl text-muted-foreground mb-2" aria-hidden="true">+</span>
          <p class="text-sm font-medium text-foreground">New list</p>
          <p class="text-xs text-muted-foreground mt-1 text-center">
            Free tier limit reached — <a href="/pricing/" class="underline hover:no-underline">see Pro</a>
          </p>
        </div>
      `;
    }
    return `
      <a
        href="/account/lists/new/"
        class="block rounded-lg border-2 border-dashed border-border bg-card/30 hover:border-foreground/40 hover:bg-card/60 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
      >
        <div class="flex flex-col items-center justify-center p-6 min-h-[180px]">
          <span class="text-3xl text-muted-foreground mb-2" aria-hidden="true">+</span>
          <p class="text-sm font-medium text-foreground">New list</p>
          <p class="text-xs text-muted-foreground mt-1">Create another list</p>
        </div>
      </a>
    `;
  }

  function renderStatsKpis(kpis: { label: string; value: string; caption?: string }[]): string {
    return kpis
      .map(
        (kpi) => `
        <div class="rounded-lg border bg-card text-card-foreground">
          <div class="p-4 space-y-1">
            <p class="text-xs font-medium text-muted-foreground uppercase tracking-wide">${kpi.label}</p>
            <p class="text-3xl font-semibold tracking-tight tabular-nums">${kpi.value}</p>
            ${kpi.caption ? `<p class="text-xs text-muted-foreground">${kpi.caption}</p>` : ""}
          </div>
        </div>
      `
      )
      .join("");
  }

  function escapeHtml(value: string): string {
    return value.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c] ?? c));
  }

  async function loadItemsIndex(): Promise<Map<string, ItemIndexEntry>> {
    try {
      const response = await fetch("/api/items.json");
      if (!response.ok) return new Map();
      const payload = (await response.json()) as { items?: ItemIndexEntry[] };
      const items = payload.items ?? [];
      const map = new Map<string, ItemIndexEntry>();
      for (const item of items) {
        map.set(item.id, item);
        for (const alt of item.altIds ?? []) {
          map.set(alt, item);
        }
      }
      return map;
    } catch {
      return new Map();
    }
  }

  function joinRecent(
    rows: Array<{ item_type: "project" | "stay"; item_id: string; completed_at: string }>,
    index: Map<string, ItemIndexEntry>
  ): Array<{
    item_type: "project" | "stay";
    item_id: string;
    completed_at: string;
    title: string;
    url: string;
    image?: string | null;
    location?: string | null;
  }> {
    const result: Array<{
      item_type: "project" | "stay";
      item_id: string;
      completed_at: string;
      title: string;
      url: string;
      image?: string | null;
      location?: string | null;
    }> = [];
    for (const row of rows) {
      const meta = index.get(String(row.item_id));
      if (!meta) continue;
      result.push({
        item_type: row.item_type,
        item_id: row.item_id,
        completed_at: row.completed_at,
        title: meta.title,
        url: meta.url,
        image: meta.image ?? null,
        location: meta.location ?? null,
      });
    }
    return result;
  }

  function renderRecentlyVisited(items: ReturnType<typeof joinRecent>): string {
    if (items.length === 0) {
      return `<p class="text-sm text-muted-foreground py-8 text-center">Nothing yet — mark visits from a project or stay page and they'll show up here.</p>`;
    }
    const slides = items
      .map((item) => {
        const safeTitle = escapeHtml(item.title ?? "");
        const imageBlock = item.image
          ? `<img src="${escapeHtml(item.image)}" alt="${safeTitle}" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />`
          : `<div class="w-full h-full flex items-center justify-center text-muted-foreground"><span class="text-xs">No image</span></div>`;
        const location = item.location
          ? `<p class="text-xs text-muted-foreground">${escapeHtml(item.location)}</p>`
          : "";
        return `
          <a href="${escapeHtml(item.url)}" class="block group focus:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 rounded-lg w-[70%] sm:w-[45%] md:w-[30%] lg:w-[22%] shrink-0 snap-start">
            <div class="aspect-[4/3] bg-muted overflow-hidden rounded-lg">
              ${imageBlock}
            </div>
            <div class="mt-3 space-y-1">
              <p class="text-xs uppercase tracking-wide text-muted-foreground">${item.item_type === "stay" ? "Stay" : "Project"}</p>
              <p class="font-medium text-sm leading-snug line-clamp-2 group-hover:underline">${safeTitle}</p>
              ${location}
            </div>
          </a>
        `;
      })
      .join("");
    return `<div class="relative"><div class="flex gap-3 sm:gap-4 overflow-x-auto pb-2 snap-x snap-mandatory scroll-px-4 -mx-4 px-4">${slides}</div></div>`;
  }

  function wireKebabMenus(): void {
    const buttons = document.querySelectorAll<HTMLElement>("[data-list-kebab]");
    buttons.forEach((button) => {
      button.addEventListener("click", (event) => {
        event.stopPropagation();
        event.preventDefault();
        const listId = button.getAttribute("data-list-id");
        if (!listId) return;
        const menu = document.querySelector<HTMLElement>(`[data-list-menu][data-list-id="${CSS.escape(listId)}"]`);
        if (!menu) return;
        const open = !menu.classList.contains("hidden");
        closeAllMenus();
        if (!open) {
          menu.classList.remove("hidden");
          button.setAttribute("aria-expanded", "true");
        }
      });
    });

    const actions = document.querySelectorAll<HTMLElement>("[data-list-action]");
    actions.forEach((button) => {
      button.addEventListener("click", async (event) => {
        event.stopPropagation();
        event.preventDefault();
        const action = button.getAttribute("data-list-action");
        const listId = button.getAttribute("data-list-id");
        const card = button.closest<HTMLElement>("[data-list-id]");
        if (!card) return;
        const title =
          card.querySelector<HTMLElement>("[data-list-link] .font-semibold")
            ?.textContent ?? "";
        if (!action || !listId) return;
        closeAllMenus();
        await handleListAction(action, listId, title, card);
      });
    });

    document.addEventListener("click", (event) => {
      const target = event.target as HTMLElement | null;
      if (!target) return;
      if (!target.closest("[data-list-menu]") && !target.closest("[data-list-kebab]")) {
        closeAllMenus();
      }
    });
  }

  function closeAllMenus(): void {
    document.querySelectorAll<HTMLElement>("[data-list-menu]").forEach((menu) => {
      menu.classList.add("hidden");
    });
    document.querySelectorAll<HTMLElement>("[data-list-kebab]").forEach((button) => {
      button.setAttribute("aria-expanded", "false");
    });
  }

  async function handleListAction(
    action: string,
    listId: string,
    currentTitle: string,
    cardEl?: HTMLElement
  ): Promise<void> {
    try {
      if (action === "rename") {
        if (!cardEl) return;
        const titleEl = cardEl.querySelector<HTMLElement>(
          "[data-list-link] .font-semibold"
        );
        if (!titleEl) return;
        const next = await showInlineRename({
          container: titleEl,
          initialValue: currentTitle,
          maxLength: 120,
          placeholder: "List name",
        });
        if (next === null) return;
        const trimmed = next.trim();
        if (!trimmed || trimmed === currentTitle) return;
        await renameList(listId, trimmed);
        showToast("success", "List renamed.");
        await load();
      } else if (action === "set-default") {
        await setDefaultList(listId);
        showToast("success", "Default list updated.");
        await load();
      } else if (action === "delete") {
        const confirmed = await showInlineConfirm({
          title: `Delete "${currentTitle}"?`,
          body: "This removes the list and its saved items. This cannot be undone.",
          confirmLabel: "Delete list",
          variant: "destructive",
        });
        if (!confirmed) return;
        await deleteList(listId);
        showToast("success", "List deleted.");
        await load();
      }
    } catch (err) {
      const message = err instanceof Error ? err.message : String(err);
      showError(`Could not update list: ${message}`);
      showToast("error", message);
    }
  }

  function renderRecent(items: ReturnType<typeof joinRecent>): void {
    const target = $id("recentFeed");
    if (!target) return;
    target.innerHTML = renderRecentlyVisited(items);
  }

  function renderStats(kpis: ReturnType<typeof buildKpis>): void {
    const section = $id("statsSection");
    if (!section) return;
    section.innerHTML =
      `<div class="grid gap-4 sm:grid-cols-3">${renderStatsKpis(kpis)}</div>`;
    section.classList.remove("hidden");
  }

  function renderLists(rows: ListRow[], atCap: boolean, tier: "free" | "pro"): void {
    const section = $id("listsSection");
    if (section) section.classList.remove("hidden");
    const target = $id("listsGrid");
    if (!target) return;
    target.innerHTML = buildListsGrid(rows, atCap, atCap);
    wireKebabMenus();
    const countEl = $id("listsCount");
    if (countEl) countEl.textContent = tier === "pro" ? "Unlimited" : `${rows.length} of ${FREE_TIER.maxLists} (free)`;
  }

  function renderEmpty(): void {
    const empty = $id("emptySection");
    if (empty) empty.classList.remove("hidden");
    const lists = $id("listsSection");
    if (lists) lists.classList.add("hidden");
  }

  function renderAtCap(): void {
    const target = $id("atCapSection");
    if (target) target.classList.remove("hidden");
  }

  function renderGreeting(firstName: string | null): void {
    const target = $id("headerGreeting");
    if (!target) return;
    const name = firstName ? `, ${firstName}` : "";
    target.textContent = `Welcome back${name}`;
  }

  async function ensureSignedIn(): Promise<boolean> {
    try {
      const auth = localStorage.getItem("pocketbase_auth");
      if (!auth || auth === "null" || auth === "undefined") {
        window.location.href = LOGIN;
        return false;
      }
      const user = await getCurrentUser();
      if (!user) {
        window.location.href = LOGIN;
        return false;
      }
      return true;
    } catch {
      window.location.href = LOGIN;
      return false;
    }
  }

  async function load(): Promise<void> {
    clearError();
    try {
      const signedIn = await ensureSignedIn();
      if (!signedIn) return;

      const [user, tier, listsWithItems, recent, visitedCount] = await Promise.all([
        getCurrentUser(),
        getAccountTier(),
        getListsWithItems(),
        getRecentCompleted(8),
        getCompletedCount(),
      ]);

      renderGreeting((user?.name ?? "").split(" ")[0] || null);

      const totalSaved = listsWithItems.reduce((acc, l) => acc + (l.items?.length ?? 0), 0);
      renderStats(buildKpis(totalSaved, listsWithItems.length, visitedCount));

      const rows: ListRow[] = listsWithItems.map((list) => {
        const itemsTs = (list.items ?? []).map((it: any) => new Date(it.added_at).getTime()).filter((t) => !Number.isNaN(t));
        const lastUpdatedMs = itemsTs.length ? Math.max(...itemsTs) : (list.created_at ? new Date(list.created_at).getTime() : null);
        const lastUpdatedLabel = lastUpdatedMs ? relativeTime(new Date(lastUpdatedMs).toISOString()) : "—";
        return {
          id: list.id,
          title: list.title,
          isDefault: !!list.is_default,
          itemCount: (list.items ?? []).length,
          lastUpdatedLabel,
        };
      });

      const limit = canCreateList(listsWithItems.length, tier);
      const atCap = !limit.allowed && tier === "free";

      if (rows.length === 0) {
        renderEmpty();
      } else {
        renderLists(rows, atCap, tier);
        if (atCap) renderAtCap();
      }

      const itemsIndex = await loadItemsIndex();
      const enriched = joinRecent(recent, itemsIndex);
      renderRecent(enriched);

      sectionsFadeIn();
    } catch (err) {
      const message = err instanceof Error ? err.message : String(err);
      showError(`Failed to load dashboard: ${message}`);
      const loading = $id("loadingSection");
      if (loading) loading.classList.add("hidden");
    }
  }

  void load();
</script>
