---

import { getCollection } from "astro:content";
import MainLayout from "../../../layouts/MainLayout.astro";
import type { GetStaticPathsOptions } from "astro";
import BlogPostCard from "../../../components/content/BlogPostCard.astro";
import BlogTagsDropdown from "../../../components/ui/Dropdown/BlogTagsDropdown.astro";
import Pagination from "../../../components/ui/Pagination.astro";
import PageHeader from "../../../components/layout/PageHeader.astro";
import NewsletterForm from "../../../components/features/newsletter/NewsletterForm.astro";
import { isValidBlogTag, getTagSlug, getTagDescription } from "../../../lib/blog-tags";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  // Fetch all blog posts from MDX collection
  const posts = await getCollection("blog");

  // Extract unique valid tags from all posts
  const tags = new Set(
    posts.flatMap((post) => post.data.tags).filter(isValidBlogTag)
  );

  // Generate paginated paths for each tag
  const paths = [];
  for (const tag of tags) {
    const tagSlug = getTagSlug(tag);

    const filteredPosts = posts.filter((post) =>
      post.data.tags.some(
        (t) => getTagSlug(t) === tagSlug
      )
    );

    // Sort filtered posts by published date (descending order - most recent first)
    const sortedPosts = filteredPosts.sort((a, b) => {
      return b.data.published.getTime() - a.data.published.getTime();
    });

    const paginatedPaths = paginate(sortedPosts, {
      pageSize: 9, // Number of posts per page
      params: { tag: tagSlug },
      props: { tag }, // Pass the tag as a prop
    });

    paths.push(...paginatedPaths);
  }

  return paths;
}

const { tag } = Astro.params; // Get the current tag from the URL
const { page } = Astro.props; // Get the paginated data
const tagName = Astro.props.tag; // Original tag name from props

// Convert the tag slug back to a readable format
const readableTag = tag
  .split("-")
  .map((word: string) => word.charAt(0).toUpperCase() + word.slice(1))
  .join(" ");

const tagDescription = getTagDescription(tagName);
---

<MainLayout title={`Posts in ${readableTag} - Page ${page.currentPage} of ${page.lastPage}`} description={tagDescription || `All of our blog posts that have the ${readableTag} tag.`}>
  <section class="bg-white dark:bg-gray-900">
    <div class="py-8 px-4 mx-auto max-w-screen-xl sm:py-16 lg:px-6">
      <PageHeader
        title={readableTag}
        subtitle={tagDescription || `All of our blog posts that have the <span class="italic">${readableTag}</span> tag.`}
      />
      <div class="flex flex-col items-start justify-between p-2 space-y-3 flex-row space-y-0 mb-4">
        <div ><span class="text-sm font-normal text-gray-500 dark:text-gray-400"
          >Showing <span class="font-semibold text-gray-900 dark:text-white"
            >{page.start + 1}-{page.end + 1}</span
          > of <span class="font-semibold text-gray-900 dark:text-white"
            >{page.total}</span
          > posts</span
        ></div>
        <div id="3" class="w-1/2 md:w-1/4 p-2 order-2 md:order-3"><BlogTagsDropdown /></div>
    </div>
      <div
        class="space-y-8 md:grid md:grid-cols-2 lg:grid-cols-3 md:gap-12 md:space-y-0"
      >
        {page.data.map((post) => (
          <BlogPostCard post={post} />
        ))}
      </div>

      <div class="mt-20 max-w-xl mx-auto text-center">
        <NewsletterForm
          source="blog-tag-page"
          id="blog-tag"
          size="sm"
          heading="Get the latest blog posts delivered to your inbox"
          description="Subscribe for travel tips, destination guides, and stories from our adventures."
          placeholder="Enter your email"
          wrapperClass="text-center"
        />
      </div>
    </div>
  </section>

  <!-- Pagination -->
  <section class="bg-white dark:bg-gray-900">
    <div class="py-8 px-4 mx-auto max-w-screen-xl sm:py-16 lg:px-6">
      <Pagination 
        currentPage={page.currentPage}
        lastPage={page.lastPage}
        prevUrl={page.url.prev}
        nextUrl={page.url.next}
        baseUrl={`/blog/${tag}`}
      />
    </div>
  </section>
</MainLayout>