---
import GenericPage from "../../layouts/GenericPage.astro";
---

<GenericPage
    title="Contact our partnerships team | Give Back Guide"
    headerTitle="Contact our partnerships team"
    subtitle="Tell us about your business and we'll get back to you within two working days."
>
    <p>
        Give Back Guide is a non-profit sustainable and regenerative travel
        platform built by and for the community.
    </p>
    <p>
        Whether you're interested in a free directory listing, Featured
        visibility, a Bespoke partnership or advertising on the platform, our
        partnerships team is here to help.
    </p>
    <p>
        We aim to respond to enquiries within two working days. If your
        message is time-sensitive, mention this in the form and we will do our
        best to prioritise.
    </p>
    <p>
        Complete the form below and we will route your message to the right
        person on our small team.
    </p>

    <iframe
        data-tally-src="https://tally.so/embed/w4xVvY?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1"
        loading="lazy"
        width="100%"
        height="655"
        frameborder="0"
        marginheight="0"
        marginwidth="0"
        title="Give Back partnerships enquiry"></iframe>

    <script is:inline>
        var d = document,
            w = "https://tally.so/widgets/embed.js",
            v = function () {
                "undefined" != typeof Tally
                    ? Tally.loadEmbeds()
                    : d
                          .querySelectorAll("iframe[data-tally-src]:not([src])")
                          .forEach(function (e) {
                              e.src = e.dataset.tallySrc;
                          });
            };
        if ("undefined" != typeof Tally) v();
        else if (d.querySelector('script[src="' + w + '"]') == null) {
            var s = d.createElement("script");
            (s.src = w), (s.onload = v), (s.onerror = v), d.body.appendChild(s);
        }
    </script>

    <script>
        // Re-initialize Tally forms after View Transitions
        document.addEventListener("astro:page-load", () => {
            if (typeof window !== "undefined" && "Tally" in window) {
                (window as any).Tally.loadEmbeds();
            }
        });
    </script>
</GenericPage>
