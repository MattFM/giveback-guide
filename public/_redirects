# Redirects are applied by Cloudflare Workers static assets before any file is
# served, so these are real HTTP redirects rather than meta-refresh pages.
#
# Format: <source> <destination> [code]
# Keep the 301 status explicit — 302 is the default.

# Legacy tag slug (pre-existing).
/blog/announcements/ /blog/news-and-updates/ 301

# Notion slug corrections, November 2026. These listings previously had a
# trailing space in pSlug/sSlug, so their live URLs contained %20. All three
# were indexed by Google; Kirtipur earns ~861 impressions a year, so the
# rebuild that fixes the slugs must ship with these rules.
/projects/awamaki%20/ /projects/awamaki/ 301
/stays/kirtipur-community-homestay%20/ /stays/kirtipur-community-homestay/ 301
/projects/united%20way%20mumbai/ /projects/united-way-mumbai/ 301

# Legacy paths, November 2026. None appear in the top paths in analytics, and
# the analytics history only starts in August 2026, so these are insurance
# against old inbound links rather than a response to live traffic.
#
# The splat rules preserve the slug, which is right where the old path already
# ended in the same slug. A legacy slug with no current equivalent lands on a
# 404 — no worse than it is today.
/home-new/ / 301
/why /about/ 301
/why/ /about/ 301
/project/ /projects/ 301
/stay/ /stays/ 301
/project/* /projects/:splat 301
/stay/* /stays/:splat 301
